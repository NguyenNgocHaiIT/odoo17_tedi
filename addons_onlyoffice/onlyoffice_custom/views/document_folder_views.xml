<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="thg_folder_form_inherit" model="ir.ui.view">
            <field name="name">document.thg_folder.form</field>
            <field name="model">documents.folder</field>
            <field name="inherit_id" ref="documents.folder_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='parent_folder_id']" position="after">
                    <field name="user_access_ids" widget="many2many_tags"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>