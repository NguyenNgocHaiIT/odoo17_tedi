<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="report_preview_view_form" model="ir.ui.view">
            <field name="name">report.preview.view.form</field>
            <field name="model">report.preview</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <form class="onlyoffice_custom">
                    <group>
                        <field name="action_report_id" readonly="1" invisible="1"/>
                        <field name="attachment_ids" widget="many2many_binary_preview"/>
                    </group>
                    <footer>
                        <button name="action_save_model" string="Save Report" type="object" class="oe_highlight"/>
                        <button name="cancel" string="Cancel" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>