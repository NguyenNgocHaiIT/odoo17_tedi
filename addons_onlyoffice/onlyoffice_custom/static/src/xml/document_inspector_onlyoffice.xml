<templates xml:space="preserve">
    <t t-inherit="documents.DocumentsInspector.buttons" t-inherit-mode="extension" owl="1">
    <xpath expr="//div[hasclass('btn-group')]" position="inside">
      <t t-if="showOnlyofficeButton(records)">
        <button
          class="btn fa o_inspector_button"
          t-on-click="() => onOpenShareOnlyOffice(records[0].data.id)"
          title="Open in ONLYOFFICE"
          t-att-disabled="locked"
        >
          <img style="width:10px;" src="/onlyoffice_custom/static/img/share_onlyoffice.png" role="img" aria-label="Share with onlyoffice" />
        </button>
      </t>

      <t t-if="this.user.userId != records[0].data.create_uid[0]">
        <button
          class="btn fa o_inspector_button"
          t-on-click="() => open_only_office_share_doc(records[0].data.id)"
          title="Share in ONLYOFFICE"
          t-att-disabled="locked"
        >
          <img style="width:10px;" src="/onlyoffice_custom/static/img/share_onlyoffice.png" role="img" aria-label="Share with onlyoffice" />
        </button>
      </t>
    </xpath>
  </t>
</templates>
