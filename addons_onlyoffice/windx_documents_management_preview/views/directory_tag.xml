<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_directory_tag_list" model="ir.ui.view">
            <field name="name">directory.tag.list</field>
            <field name="model">directory.tag</field>
            <field name="arch" type="xml">
                <tree editable="bottom">
                    <field name="name"/>
                    <field name="color" widget="color_picker"/>
                </tree>
            </field>
        </record>
        
        <record id="directory_tag_action" model="ir.actions.act_window">
            <field name="name">Directory Tag</field>
            <field name="res_model">directory.tag</field>
            <field name="view_mode">tree</field>
            <field name="search_view_id" ref="view_directory_tag_list"/>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Create a new Directory Tag
              </p>
            </field>
        </record>
    </data>
</odoo>