<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_attachment_form_inherit_document_management" model="ir.ui.view">
            <field name="name">ir.attachment.form.inherit.document.management</field>
            <field name="model">ir.attachment</field>
            <field name="inherit_id" ref="base.view_attachment_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="before">
                    <header>
                        <button name="action_send_mail" type="object"
                                string="Send by Email" class="oe_highlight"/>
                    </header>
                </xpath>
                <xpath expr="//field[@name='mimetype']" position="after">
                    <field name="document_directory_id"/>
                    <field name="directory_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    <field name="user_ids" widget="many2many_tags"/>
                    <field name="document_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                </xpath>
                <xpath expr="//field[@name='datas']" position="attributes">
                    <attribute name="widget">binary_attachment_preview</attribute>
                </xpath>
            </field>
        </record>
        <record id="view_attachment_tree_inherit_document_management" model="ir.ui.view">
            <field name="name">ir.attachment.tree.inherit.document.management</field>
            <field name="model">ir.attachment</field>
            <field name="inherit_id" ref="base.view_attachment_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='company_id']" position="after">
                    <field name="document_directory_id"/>
                    <field name="document_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                </xpath>
            </field>
        </record>
        <record id="view_attachment_search_inherit_document_management" model="ir.ui.view">
            <field name="name">ir.attachment.search.inherit.document.management</field>
            <field name="model">ir.attachment</field>
            <field name="mode">primary</field>
            <field name="inherit_id" ref="base.view_attachment_search"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='create_date']" position="after">
                    <field name="document_tag_ids"/>
                    <field name="directory_tag_ids"/>
                    <field name="document_directory_id"/>
                    <searchpanel>
                        <field name="document_directory_id"
                               icon="fa-folder"
                               enable_counters="1"
                               hierarchical="1"
                               expand="1"
                               context="{'searchpanel_strict': True}"/>
                    </searchpanel>
                    <filter string="My Document" name="my_document" domain="[('create_uid', '=', uid)]"/>
                </xpath>
                <xpath expr="//filter[@name='creation_month']" position="after">
                    <filter string="Document Directory" name="document_directory" domain="[]" context="{'group_by':'document_directory_id'}"/>
                </xpath>
            </field>
        </record>
        <record id="act_attachment_from_document_directory" model="ir.actions.act_window">
            <field name="name">Attachments</field>
            <field name="res_model">ir.attachment</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="search_view_id" ref="view_attachment_search_inherit_document_management"/>
            <field name="domain">[('document_directory_id', '=', active_id)]</field>
            <field name="context">{
                "searchpanel_default_document_directory_id": active_id,
                "strict_directory_filter": True,
                "default_document_directory_id": active_id,
                "search_default_group_document_directory": 1,
                "expand": 1,
                "hierarchical_naming": true,
                "search_default_document_directory_strict": 1,
                "searchpanel_strict_directory": True}
            </field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Add a new attachment
                </p>
            </field>
        </record>
        <record id="act_all_attachment_from_document_directory" model="ir.actions.act_window">
            <field name="name">Attachments</field>
            <field name="res_model">ir.attachment</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="search_view_id" ref="view_attachment_search_inherit_document_management"/>
            <field name="domain">[('document_directory_id', '!=', False)]</field>
            <field name="context">{
                "search_default_group_document_directory": 1,
                "act_type": "all_document",
                "expand": 1,
                "hierarchical_naming": true,
                "search_default_document_directory_strict": 1,
                "searchpanel_strict_directory": True}
            </field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Add a new attachment
                </p>
            </field>
        </record>
        <record id="act_my_attachment_from_document_directory" model="ir.actions.act_window">
            <field name="name">Attachments</field>
            <field name="res_model">ir.attachment</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="search_view_id" ref="view_attachment_search_inherit_document_management"/>
            <field name="domain">[('document_directory_id', '!=', False), ('create_uid', '=', uid)]</field>
            <field name="context">{
                "search_default_group_document_directory": 1,
                "act_type": "my_document",
                "expand": 1,
                "hierarchical_naming": true,
                "search_default_document_directory_strict": 1,
                "searchpanel_strict_directory": True}
            </field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Add a new attachment
                </p>
            </field>
        </record>

    </data>
</odoo>
