<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="email_template_vehicle_registration_no_car" model="mail.template">
            <field name="name">Thông báo: Hết xe (Đăng ký xe)</field>
            <field name="model_id" ref="model_hr_tedi_vehicle_registration"/>
            <field name="subject">Thông báo hết xe - Đơn {{ object.code }}</field>
            <field name="email_from">{{ (object.env.user.email_formatted) }}</field>
            <field name="email_to">{{ object.requester_id.work_email or object.create_uid.email_formatted }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Xin chào <strong><t t-out="object.requester_id.name or object.create_uid.name"/></strong>,
                        <br/><br/>
                        Đơn đăng ký xe mã số <strong><t t-out="object.code"/></strong>
                        (Khởi hành: <t t-out="format_datetime(object.start_date, tz=user.tz, dt_format='dd/MM/yyyy HH:mm')"/>)
                        hiện tại bộ phận điều vận <strong>không thể bố trí được xe (Hết xe)</strong>.
                        <br/><br/>
                        <strong>Phương án xử lý:</strong> <t t-out="dict(object._fields['external_booking_type'].selection).get(object.external_booking_type)"/>
                        <br/>
                        <strong>Ghi chú từ quản lý:</strong> <t t-out="object.no_car_note or 'Không có'"/>
                        <br/><br/>
                        Vui lòng thực hiện theo phương án trên.
                        <br/><br/>
                        Trân trọng,
                        <br/>
                        Hệ thống quản lý xe.
                    </p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>