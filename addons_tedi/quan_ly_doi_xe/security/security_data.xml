<odoo>
    <data>
        <function model="res.groups" name="write" context="{'lang': 'vi_VN'}">
            <value eval="[ref('fleet.fleet_group_user')]"/>
            <value eval="{'name': 'Tài xế'}"/>
        </function>

        <record id="fleet_vehicle_rule_read_all_internal" model="ir.rule">
            <field name="name">All Internal Users can Read Vehicles</field>
            <field name="model_id" ref="fleet.model_fleet_vehicle"/>
            <field name="domain_force">[(1, '=', 1)]</field> <field name="groups" eval="[(4, ref('base.group_user'))]"/> <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="access_fleet_vehicle_state_user" model="ir.model.access">
            <field name="name">fleet.vehicle.state user</field>
            <field name="model_id" ref="fleet.model_fleet_vehicle_state"/>
            <field name="group_id" ref="base.group_user"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!--Quản lý có full quyền-->
        <record id="vehicle_registration_manager_rule" model="ir.rule">
            <field name="name">Vehicle Registration - Manager Full Access</field>
            <field name="model_id" ref="model_hr_tedi_vehicle_registration"/>
            <field name="domain_force">[(1, '=', 1)]</field> <!-- Tất cả phiếu -->
            <field name="groups" eval="[(4, ref('fleet.fleet_group_manager'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">1</field>
        </record>

        <!-- Rule 1: Người dùng bình thường chỉ có thể thêm/sửa/xóa phiếu mình tạo -->
        <record id="vehicle_registration_user_rule" model="ir.rule">
            <field name="name">Vehicle Registration - User Rule</field>
            <field name="model_id" ref="model_hr_tedi_vehicle_registration"/>
            <field name="domain_force">[(1, '=', 1)]</field> <!-- Có thể xem tất cả -->
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field> <!-- Mặc định không thể sửa phiếu người khác -->
            <field name="perm_create">1</field>
            <field name="perm_unlink">0</field> <!-- Mặc định không thể xóa phiếu người khác -->
        </record>

        <!-- Rule 1: Người dùng bình thường chỉ có thể thêm/sửa/xóa phiếu mình tạo -->
        <record id="business_trip_registration_user_rule" model="ir.rule">
            <field name="name">business trip registration - User Rule</field>
            <field name="model_id" ref="model_business_trip_registration"/>
            <field name="domain_force">[(1, '=', 1)]</field> <!-- Có thể xem tất cả -->
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field> <!-- Mặc định không thể sửa phiếu người khác -->
            <field name="perm_create">1</field>
            <field name="perm_unlink">0</field> <!-- Mặc định không thể xóa phiếu người khác -->
        </record>

        <!-- Rule 2: Người dùng có thể sửa/xóa phiếu mình tạo -->
        <record id="vehicle_registration_owner_rule" model="ir.rule">
            <field name="name">Vehicle Registration - Owner Rule</field>
            <field name="model_id" ref="model_hr_tedi_vehicle_registration"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field> <!-- Chỉ phiếu mình tạo -->
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field> <!-- Có thể sửa phiếu của mình -->
            <field name="perm_create">0</field>
            <field name="perm_unlink">1</field> <!-- Có thể xóa phiếu của mình -->
        </record>
    </data>
</odoo>