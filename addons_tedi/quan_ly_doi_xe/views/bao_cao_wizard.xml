<!-- File: thanh_toan_wizard_view.xml -->
<odoo>
    <data>
        <!-- Wizard Form View -->
        <record id="thanh_toan_xe_report_wizard_view_form" model="ir.ui.view">
            <field name="name">thanh.toan.xe.report.wizard.form</field>
            <field name="model">thanh.toan.xe.report.wizard</field>
            <field name="arch" type="xml">
                <form string="Xuất báo cáo thanh toán">
                    <sheet>
                        <div class="oe_title">
                            <h1>Xuất báo cáo thanh toán xe</h1>
                        </div>

                        <group>
                            <group>
                                <field name="vehicle_id" required="1"/>
                                <field name="month" required="1"/>
                                <field name="year" required="1"/>
                            </group>
                        </group>

                        <footer>
                            <button name="action_export_excel" string="Xuất Excel" type="object" class="btn-primary"/>
                            <button string="Hủy" class="btn-secondary" special="cancel"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action mở Wizard -->
        <record id="action_thanh_toan_xe_report_wizard" model="ir.actions.act_window">
            <field name="name">Xuất báo cáo thanh toán</field>
            <field name="res_model">thanh.toan.xe.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="model_fleet_vehicle"/>
            <field name="binding_view_types">form</field>
        </record>
    </data>
</odoo>