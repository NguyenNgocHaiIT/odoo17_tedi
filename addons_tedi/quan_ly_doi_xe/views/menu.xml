        <record id="fleet.fleet_vehicle_odometer_menu" model="ir.ui.menu">
            <field name="active" eval="False"/>
        </record>

        <record id="fleet.fleet_vehicle_model_brand_menu" model="ir.ui.menu">
            <field name="active" eval="False"/>
        </record>

        <record id="fleet.fleet_services_configuration" model="ir.ui.menu">
            <field name="active" eval="False"/>
        </record>



        <record id="fleet.fleet_vehicle_menu" model="ir.ui.menu">
            <field name="active" eval="False"/>
        </record>


        <record id="fleet.fleet_vehicle_log_services_menu" model="ir.ui.menu">
            <field name="active" eval="False"/>
        </record>

        <record id="fleet.fleet_vehicle_log_contract_menu" model="ir.ui.menu">
            <field name="active" eval="False"/>
        </record>

        <record id="fleet.fleet_config_settings_menu" model="ir.ui.menu">
            <field name="active" eval="False"/>
        </record>

