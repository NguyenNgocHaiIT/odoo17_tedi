<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="fleet.fleet_vehicle_log_services_action" model="ir.actions.act_window">
            <field name="name">Phiếu sửa chữa</field>
        </record>

        <record id="fleet.menu_root" model="ir.ui.menu">
            <field name="sequence">1</field>
            <field name="groups_id" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <menuitem id="menu_hr_tedi_vehicle_registration"
                  name="Đăng ký xe"
                  parent="fleet.menu_root"
                  action="action_hr_tedi_vehicle_registration2"
                  sequence="10"
                  groups="base.group_user"/>

        <menuitem id="menu_fleet_vehicle_repair_custom"
                  name="Sửa chữa xe"
                  parent="fleet.menu_root"
                  action="fleet.fleet_vehicle_log_services_action"
                  sequence="11"
                  groups="base.group_user"/>

        <menuitem id="menu_fleet_vehicle_odometer_monthly_report"
                  name="Báo cáo Km tháng"
                  parent="fleet.menu_fleet_reporting"
                  action="action_fleet_vehicle_odometer_monthly_report"
                  sequence="15"
                  groups="base.group_user"/>


        <menuitem action="fleet.fleet_vehicle_action"
                  name="Đội xe"
                  parent="fleet.menu_root"
                  id="tedi_fleet_vehicle_menu"
                  groups="fleet.fleet_group_user"
                  sequence="1"/>

        <menuitem action="fleet.fleet_vehicle_model_brand_action"
                  name="Hãng xe"
                  parent="fleet.fleet_models_configuration"
                  id="tedi_fleet_vehicle_model_brand_menu"
                  sequence="1"/>


<!--        <menuitem action="fleet_vehicle_action" parent="fleet_vehicles" name="Fleet"-->
