<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_fleet_vehicle_tree_inherit_tedi" model="ir.ui.view">
            <field name="name">fleet.vehicle.tree.inherit.tedi</field>
            <field name="model">fleet.vehicle</field>
            <field name="inherit_id" ref="fleet.fleet_vehicle_view_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//tree" position="replace">
                    <tree string="Lý lịch xe">
                        <field name="model_id" string="Model xe"/>
                        <field name="description"/>
                        <field name="country_of_manufacture"/>
                        <field name="license_plate"/>
                        <field name="driver_id" string="Tài xế"/>
                        <field name="odometer" string="Odometer"/>
                    </tree>
                </xpath>
            </field>
        </record>

        <record id="view_fleet_vehicle_form_inherit_tedi" model="ir.ui.view">
            <field name="name">fleet.vehicle.form.inherit.tedi</field>
            <field name="model">fleet.vehicle</field>
            <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
            <field name="arch" type="xml">

                <xpath expr="//sheet" position="replace">
                    <sheet>
                        <field name="id" invisible="1"/>
                        <field name="company_id" invisible="1"/>
                        <field name="future_driver_id" invisible="1"/>
                        <field name="currency_id" invisible="1"/>

                        <field name="image_128" widget="image" class="oe_avatar"/>
                        <div class="oe_button_box" name="button_box">

                            <button name="action_open_custom_odometer"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-tachometer"
                                context="{'xml_id':'quan_ly_doi_xe.action_fleet_vehicle_odometer_monthly_report'}"
                                help="Nhật ký Odometer">
                                <field name="odometer" widget="statinfo" string="Odometer"/>
                            </button>

<!--                            <button name="return_action_to_open"-->
<!--                                type="object"-->
<!--                                class="oe_stat_button"-->
<!--                                icon="fa-book"-->
<!--                                context="{'xml_id':'fleet_vehicle_log_contract_action'}"-->
<!--                                help="Hợp đồng">-->
<!--                                <field name="contract_count" widget="statinfo" string="Hợp đồng"/>-->
<!--                            </button>-->
                            <button name="return_action_to_open"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-wrench"
                                context="{'xml_id':'fleet_vehicle_log_services_action'}"
                                help="Sửa chữa">
                                <field name="service_count" widget="statinfo" string="Sửa chữa"/>
                            </button>
                        </div>

                        <group>
                            <group>
                                <field name="tedi_driver_employee_id" string="Tài xế (Nhân viên)"/>
                                <field name="driver_id" invisible="1" force_save="1"/>

                                <field name="future_driver_id" string="Tài xế tiếp theo" invisible="1"/>

                                <field name="country_of_manufacture"/>
                                <field name="model_id"/>
                                <field name="license_plate"/>

                                <!-- Hiển thị Odometer để nhập ban đầu -->
                                <field name="odometer" string="Số Km hiện tại" help="Nhập số km ban đầu nếu tạo mới"/>
                                <field name="odometer_unit" class="oe_inline" readonly="1"/>
f
                                <field name="year_manufacture"/>
                                <field name="year_in_use"/>
                                <field name="vin_sn" string="Số khung (VIN)"/>
                                <field name="engine_no"/>
                                <field name="color_car" widget="color"/>
                            </group>
                            <group>
                                <field name="cylinder_capacity"/>
                                <field name="original_cost"/>
                                <field name="purchase_value"/>
                                <field name="registration_fee"/>
                                <field name="fuel_rate"/>
                                <field name="oil_change_rate"/>
                                <field name="description"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Lịch sử công tác">
                                <field name="trip_history_ids" readonly="1">
                                    <tree>
                                        <field name="start_date"/>
                                        <field name="end_date"/>
                                        <field name="trip_type"/>
                                        <field name="destination"/>
                                        <field name="distance_km"/>
                                    </tree>
                                </field>
                            </page>

                            <page string="Lịch sử sửa chữa">
                                <field name="service_history_ids" readonly="1">
                                    <tree string="Danh sách phiếu dịch vụ" default_order="date desc">
                                        <field name="date" string="Ngày thực hiện"/>
                                        <field name="code" string="Mã phiếu"/>
                                        <field name="service_type_id" string="Loại dịch vụ"/>
                                        <field name="vendor_id" string="Nhà cung cấp"/>
                                        <field name="requester_id" string="Người đề nghị"/>
                                        <field name="amount" string="Chi phí" sum="Tổng cộng"/>
                                        <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state == 'new'"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </xpath>
            </field>
        </record>

        <record id="view_fleet_vehicle_kanban_inherit_tedi" model="ir.ui.view">
            <field name="name">fleet.vehicle.kanban.inherit.tedi</field>
            <field name="model">fleet.vehicle</field>
            <field name="inherit_id" ref="fleet.fleet_vehicle_view_kanban"/>
            <field name="arch" type="xml">

                <xpath expr="//div[hasclass('o_kanban_image')]" position="replace">
                    <div class="o_kanban_image">
                        <img t-att-src="kanban_image('fleet.vehicle.model', 'image_128', record.model_id.raw_value)" alt="Vehicle Image"/>
                    </div>
                </xpath>

                <xpath expr="//field[@name='driver_id']" position="after">
                    <field name="tedi_driver_employee_id"/>
                </xpath>

                <xpath expr="//t[@t-if='record.driver_id.raw_value']" position="replace">
                    <t t-if="record.tedi_driver_employee_id.raw_value">
                        <field name="tedi_driver_employee_id" widget="many2one_avatar" options="{'display_avatar_name': True}"/>
                    </t>
                </xpath>

            </field>
        </record>
    </data>
</odoo>