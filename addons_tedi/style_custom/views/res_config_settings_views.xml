<odoo>
    <record id="view_config_settings_navbar_color_form" model="ir.ui.view">
        <field name="name">res.config.settings.navbar.color.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <div class="app_settings_block" data-string="Appearance Settings">
                    <h2>Cấu hình trang web</h2>
                    <div class="row mt16 o_setting_box" style="margin-left: 16px;">
                        <div class="col-12 col-lg-6">
                            <label for="navbar_color">Màu thanh menu</label>
                            <div>
                                <field name="navbar_color" widget="color"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6">
                            <label for="font_size">Cỡ chữ (px)</label>
                            <div>
                                <field name="font_size"/>
                            </div>
                        </div>
                    </div>
                    <div class="row mt16 o_setting_box" style="margin-left: 16px;">
                        <div class="col-12 col-lg-6" >
                            <label for="login_bg_image_config">Ảnh nền đăng nhập</label>
                            <div style="width: 100%; max-width: 400px; display: flex; align-items: center; justify-content: center; overflow: hidden; border: 1px solid #ddd;">
                                <field name="login_bg_image_config"
                                       widget="image"
                                       style="width: 100%; height: 100%; max-width: 100%; max-height:100%; object-fit: contain;"
                                       filename="login_bg_image_filename"
                                       options="{'preview_image': 'login_bg_image_config'}"
                                       readonly="0"/>
                            </div>
                            <div class="text-muted">
                                Ảnh nền cho màn hình đăng nhập.
                            </div>
                        </div>
                        <div class="col-12 col-lg-6" >
                            <label for="login_logo">Login Page Logo</label>
                            <div style="width: 100%; max-width: 300px; display: flex; align-items: center; justify-content: center; overflow: hidden; border: 1px solid #ddd;">
                                <field name="login_logo"
                                       style="width: 100%; height: 100%; max-width: 100%; max-height:100%; object-fit: contain;"
                                       widget="image"
                                       options="{'preview_image': 'login_logo'}"/>
                            </div>
                            <div class="text-muted">
                                Logo sẽ hiển thị trên trang đăng nhập.
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
