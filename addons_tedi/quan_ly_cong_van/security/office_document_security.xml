<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Nhóm Văn thư -->
        <record id="group_van_thu" model="res.groups">
            <field name="name">Văn thư</field>
            <field name="category_id" ref="base.module_category_administration"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Nhóm Lãnh đạo -->
        <record id="group_lanh_dao" model="res.groups">
            <field name="name">Lãnh đạo</field>
            <field name="category_id" ref="base.module_category_administration"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>


        <!-- Nhóm văn thư đơn vị -->
        <record id="group_van_thu_don_vi" model="res.groups">
            <field name="name">Văn thư đơn vị</field>
            <field name="category_id" ref="base.module_category_administration"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Rule 1: Quyền READ - Văn thư đơn vị: Xem văn bản của phòng ban mình
         Bao gồm: văn bản do mình tạo, văn bản của phòng ban mình,
         và văn bản được phân phát cho nhân viên cùng phòng ban -->
        <record id="office_document_rule_van_thu_don_vi_read" model="ir.rule">
            <field name="name">Office Document - Văn thư đơn vị: Xem văn bản của phòng ban</field>
            <field name="model_id" ref="model_office_document"/>
            <field name="domain_force">
                ['|', '|', '|',
                '&amp;', ('create_uid', '=', user.id), ('nguoi_tao_duoc_xem', '=', True),
                ('create_uid.employee_ids.department_id', 'in', user.employee_ids.department_id.ids),
                ('dv_xu_ly_chinh', 'in', user.employee_ids.department_id.ids),
                ('detail2.nguoi_nhap_y_kien.department_id', 'in', user.employee_ids.department_id.ids)
                ]
            </field>
            <field name="groups" eval="[(4, ref('quan_ly_cong_van.group_van_thu_don_vi'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Rule 2: Quyền WRITE - Sửa văn bản do mình tạo HOẶC đang ở trạng thái draft -->
        <record id="office_document_rule_van_thu_don_vi_write" model="ir.rule">
            <field name="name">Office Document - Văn thư đơn vị: Sửa do mình tạo hoặc draft</field>
            <field name="model_id" ref="model_office_document"/>
            <field name="domain_force">
                ['|',
                '&amp;', ('create_uid', '=', user.id), ('nguoi_tao_duoc_xem', '=', True),
                ('tt_vb', '=', 'draft')
                ]
            </field>
            <field name="groups" eval="[(4, ref('quan_ly_cong_van.group_van_thu_don_vi'))]"/>
            <field name="perm_read" eval="0"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Rule 3: Quyền CREATE - Tạo mới luôn được phép -->
        <record id="office_document_rule_van_thu_don_vi_create" model="ir.rule">
            <field name="name">Office Document - Văn thư đơn vị: Tạo mới</field>
            <field name="model_id" ref="model_office_document"/>
            <field name="domain_force">[('document_type', '!=', 'resolution')]</field>
            <field name="groups" eval="[(4, ref('quan_ly_cong_van.group_van_thu_don_vi'))]"/>
            <field name="perm_read" eval="0"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Rule 4: Quyền UNLINK - Xóa văn bản do mình tạo HOẶC đang ở trạng thái draft -->
        <record id="office_document_rule_van_thu_don_vi_unlink" model="ir.rule">
            <field name="name">Office Document - Văn thư đơn vị: Xóa do mình tạo hoặc draft</field>
            <field name="model_id" ref="model_office_document"/>
            <field name="domain_force">
                ['|',
                '&amp;', ('create_uid', '=', user.id), ('nguoi_tao_duoc_xem', '=', True),
                ('tt_vb', '=', 'draft')
                ]
            </field>
            <field name="groups" eval="[(4, ref('quan_ly_cong_van.group_van_thu_don_vi'))]"/>
            <field name="perm_read" eval="0"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="1"/>
        </record>


        <!-- Văn thư: xem tất cả công văn đến, công văn đi, quyết định (không xem loại chuyên biệt HĐQT/Đảng ủy/CĐ/ĐTN) -->
        <record id="office_document_rule_van_thu" model="ir.rule">
            <field name="name">Office Document - Văn thư: xem công văn đến/đi/quyết định</field>
            <field name="model_id" ref="model_office_document"/>
            <field name="domain_force">[('document_type', 'in', ['incoming', 'outgoing', 'resolution'])]</field>
            <field name="groups" eval="[(4, ref('quan_ly_cong_van.group_van_thu'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Văn thư: với loại chuyên biệt (HĐQT/Đảng ủy/CĐ/ĐTN) → xem như người dùng bình thường -->
        <record id="office_document_rule_van_thu_chuyen_biet_read" model="ir.rule">
            <field name="name">Office Document - Văn thư: xem loại chuyên biệt như người dùng thường</field>
            <field name="model_id" ref="model_office_document"/>
            <field name="domain_force">
                ['|','|',
                '&amp;', ('create_uid','=',user.id), ('nguoi_tao_duoc_xem','=',True),
                ('detail2.nguoi_nhap_y_kien.user_id','=',user.id),
                '&amp;',
                ('tt_vb', '!=', 'draft'),
                '|','|',
                ('truong_don_vi_duyet.user_id','=',user.id),
                ('lanh_dao_xu_ly.user_id', '=', user.id),
                ('lanh_dao_theo_doi.user_id', '=', user.id)
                ]
            </field>
            <field name="groups" eval="[(4, ref('quan_ly_cong_van.group_van_thu'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>


        <!-- Lãnh đạo: xem công văn mình tạo, được phân phát hoặc là lãnh đạo xử lý -->
        <record id="office_document_rule_lanh_dao" model="ir.rule">
            <field name="name">Office Document - Lanh Dao</field>
            <field name="model_id" ref="model_office_document"/>
            <field name="domain_force">
                ['|','|',
                '&amp;', ('create_uid','=',user.id), ('nguoi_tao_duoc_xem','=',True),
                ('detail2.nguoi_nhap_y_kien.user_id','=',user.id),
                '&amp;',
                ('tt_vb', '!=', 'draft'),
                '|','|',
                ('truong_don_vi_duyet.user_id','=',user.id),
                ('lanh_dao_xu_ly.user_id', '=', user.id),
                ('lanh_dao_theo_doi.user_id', '=', user.id)
                ]
            </field>
            <field name="groups" eval="[(4, ref('quan_ly_cong_van.group_lanh_dao'))]"/>
        </record>


        <record id="office_document_rule_nhan_vien" model="ir.rule">
            <field name="name">Office Document - Nhân viên/Người dùng cơ bản</field>
            <field name="model_id" ref="model_office_document"/>
            <field name="domain_force">
                ['|','|',
                '&amp;', ('create_uid','=',user.id), ('nguoi_tao_duoc_xem','=',True),
                ('detail2.nguoi_nhap_y_kien.user_id','=',user.id),
                '&amp;',
                ('tt_vb', '!=', 'draft'),
                '|','|',
                ('truong_don_vi_duyet.user_id','=',user.id),
                ('lanh_dao_xu_ly.user_id', '=', user.id),
                ('lanh_dao_theo_doi.user_id', '=', user.id)
                ]
            </field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="access_ir_attachment_all_users" model="ir.model.access">
            <field name="name">ir.attachment: all users can attach files</field>
            <field name="model_id" ref="base.model_ir_attachment"/>
            <field name="group_id" ref="base.group_user"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="quan_ly_cong_van.access_res_partner_van_thu" model="ir.model.access">
            <field name="name">res.partner - Văn thư full quyền</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="group_id" ref="quan_ly_cong_van.group_van_thu"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/> <!-- Không cho xóa partner -->
        </record>

        <!-- Record Rule cho res.partner - Văn thư thấy tất cả -->
        <record id="quan_ly_cong_van.res_partner_rule_van_thu" model="ir.rule">
            <field name="name">Văn thư: xem tất cả partner</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="groups" eval="[(4, ref('quan_ly_cong_van.group_van_thu'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="group_truong_don_vi" model="res.groups">
            <field name="name">Trưởng đơn vị</field>
            <field name="category_id" ref="base.module_category_administration"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_pho_don_vi" model="res.groups">
            <field name="name">Phó đơn vị</field>
            <field name="category_id" ref="base.module_category_administration"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Quyền cho Trưởng đơn vị (giống Văn thư đơn vị) -->

        <!-- Rule 1: Quyền READ - Trưởng đơn vị: Xem văn bản của phòng ban mình -->
        <record id="office_document_rule_truong_don_vi_read" model="ir.rule">
            <field name="name">Office Document - Trưởng đơn vị: Xem văn bản của phòng ban</field>
            <field name="model_id" ref="model_office_document"/>
            <field name="domain_force">
                ['|', '|', '|',
                '&amp;', ('create_uid', '=', user.id), ('nguoi_tao_duoc_xem', '=', True),
                ('create_uid.employee_ids.department_id', 'in', user.employee_ids.department_id.ids),
                ('dv_xu_ly_chinh', 'in', user.employee_ids.department_id.ids),
                ('detail2.nguoi_nhap_y_kien.department_id', 'in', user.employee_ids.department_id.ids)
                ]
            </field>
            <field name="groups" eval="[(4, ref('quan_ly_cong_van.group_truong_don_vi'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Rule 2: Quyền WRITE - Trưởng đơn vị: Sửa do mình tạo hoặc draft -->
        <record id="office_document_rule_truong_don_vi_write" model="ir.rule">
            <field name="name">Office Document - Trưởng đơn vị: Sửa do mình tạo hoặc draft</field>
            <field name="model_id" ref="model_office_document"/>
            <field name="domain_force">
                ['|',
                '&amp;', ('create_uid', '=', user.id), ('nguoi_tao_duoc_xem', '=', True),
                ('tt_vb', '=', 'draft')
                ]
            </field>
            <field name="groups" eval="[(4, ref('quan_ly_cong_van.group_truong_don_vi'))]"/>
            <field name="perm_read" eval="0"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Rule 3: Quyền CREATE - Trưởng đơn vị: Tạo mới luôn được phép -->
        <record id="office_document_rule_truong_don_vi_create" model="ir.rule">
            <field name="name">Office Document - Trưởng đơn vị: Tạo mới</field>
            <field name="model_id" ref="model_office_document"/>
            <field name="domain_force">[('document_type', '=', 'resolution')]</field>
            <field name="groups" eval="[(4, ref('quan_ly_cong_van.group_truong_don_vi'))]"/>
            <field name="perm_read" eval="0"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Rule 4: Quyền UNLINK - Trưởng đơn vị: Xóa do mình tạo hoặc draft -->
        <record id="office_document_rule_truong_don_vi_unlink" model="ir.rule">
            <field name="name">Office Document - Trưởng đơn vị: Xóa do mình tạo hoặc draft</field>
            <field name="model_id" ref="model_office_document"/>
            <field name="domain_force">
                ['|',
                '&amp;', ('create_uid', '=', user.id), ('nguoi_tao_duoc_xem', '=', True),
                ('tt_vb', '=', 'draft')
                ]
            </field>
            <field name="groups" eval="[(4, ref('quan_ly_cong_van.group_truong_don_vi'))]"/>
            <field name="perm_read" eval="0"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="1"/>
        </record>


        <!-- Quyền cho Phó đơn vị (giống Văn thư đơn vị) -->

        <!-- Rule 1: Quyền READ - Phó đơn vị: Xem văn bản của phòng ban mình -->
        <record id="office_document_rule_pho_don_vi_read" model="ir.rule">
            <field name="name">Office Document - Phó đơn vị: Xem văn bản của phòng ban</field>
            <field name="model_id" ref="model_office_document"/>
            <field name="domain_force">
                ['|', '|', '|',
                '&amp;', ('create_uid', '=', user.id), ('nguoi_tao_duoc_xem', '=', True),
                ('create_uid.employee_ids.department_id', 'in', user.employee_ids.department_id.ids),
                ('dv_xu_ly_chinh', 'in', user.employee_ids.department_id.ids),
                ('detail2.nguoi_nhap_y_kien.department_id', 'in', user.employee_ids.department_id.ids)
                ]
            </field>
            <field name="groups" eval="[(4, ref('quan_ly_cong_van.group_pho_don_vi'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Rule 2: Quyền WRITE - Phó đơn vị: Sửa do mình tạo hoặc draft -->
        <record id="office_document_rule_pho_don_vi_write" model="ir.rule">
            <field name="name">Office Document - Phó đơn vị: Sửa do mình tạo hoặc draft</field>
            <field name="model_id" ref="model_office_document"/>
            <field name="domain_force">
                ['|',
                '&amp;', ('create_uid', '=', user.id), ('nguoi_tao_duoc_xem', '=', True),
                ('tt_vb', '=', 'draft')
                ]
            </field>
            <field name="groups" eval="[(4, ref('quan_ly_cong_van.group_pho_don_vi'))]"/>
            <field name="perm_read" eval="0"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Rule 3: Quyền CREATE - Phó đơn vị: Tạo mới luôn được phép -->
        <record id="office_document_rule_pho_don_vi_create" model="ir.rule">
            <field name="name">Office Document - Phó đơn vị: Tạo mới</field>
            <field name="model_id" ref="model_office_document"/>
            <field name="domain_force">[('document_type', '!=', 'resolution')]</field>
            <field name="groups" eval="[(4, ref('quan_ly_cong_van.group_pho_don_vi'))]"/>
            <field name="perm_read" eval="0"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Rule 4: Quyền UNLINK - Phó đơn vị: Xóa do mình tạo hoặc draft -->
        <record id="office_document_rule_pho_don_vi_unlink" model="ir.rule">
            <field name="name">Office Document - Phó đơn vị: Xóa do mình tạo hoặc draft</field>
            <field name="model_id" ref="model_office_document"/>
            <field name="domain_force">
                ['|',
                '&amp;', ('create_uid', '=', user.id), ('nguoi_tao_duoc_xem', '=', True),
                ('tt_vb', '=', 'draft')
                ]
            </field>
            <field name="groups" eval="[(4, ref('quan_ly_cong_van.group_pho_don_vi'))]"/>
            <field name="perm_read" eval="0"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- Lãnh đạo: Chỉ tạo được văn bản không phải quyết định -->
        <record id="office_document_rule_lanh_dao_create" model="ir.rule">
            <field name="name">Office Document - Lãnh đạo: Tạo mới</field>
            <field name="model_id" ref="model_office_document"/>
            <field name="domain_force">[('document_type', '!=', 'resolution')]</field>
            <field name="groups" eval="[(4, ref('quan_ly_cong_van.group_lanh_dao'))]"/>
            <field name="perm_read" eval="0"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Nhân viên: Chỉ tạo được văn bản không phải quyết định -->
        <record id="office_document_rule_nhan_vien_create" model="ir.rule">
            <field name="name">Office Document - Nhân viên: Tạo mới</field>
            <field name="model_id" ref="model_office_document"/>
            <field name="domain_force">[('document_type', '=', 'resolution')]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <delete model="ir.rule" search="[('groups.name','=','Đơn vị xử lý')]"/>

        <!-- Xóa access rights -->
        <delete model="ir.model.access" search="[('group_id.name','=','Đơn vị xử lý')]"/>

        <!-- Xóa group -->
        <delete model="res.groups" search="[('name','=','Đơn vị xử lý')]"/>


        <!-- ========================================================== -->
        <!-- NHÓM VĂN THƯ THEO LOẠI VĂN BẢN -->
        <!-- ========================================================== -->

        <!-- Nhóm Văn thư HĐQT -->
        <record id="group_van_thu_hdqt" model="res.groups">
            <field name="name">Văn thư HĐQT</field>
            <field name="category_id" ref="base.module_category_administration"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Nhóm Văn thư Đảng ủy -->
        <record id="group_van_thu_dang_uy" model="res.groups">
            <field name="name">Văn thư Đảng ủy</field>
            <field name="category_id" ref="base.module_category_administration"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Nhóm Văn thư Công đoàn -->
        <record id="group_van_thu_cong_doan" model="res.groups">
            <field name="name">Văn thư Công đoàn</field>
            <field name="category_id" ref="base.module_category_administration"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Nhóm Văn thư Đoàn thanh niên -->
        <record id="group_van_thu_doan_tn" model="res.groups">
            <field name="name">Văn thư Đoàn thanh niên</field>
            <field name="category_id" ref="base.module_category_administration"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>


        <!-- ============================================================ -->
        <!-- IR.RULES CHO VĂN THƯ HĐQT (document_type = 'director')      -->
        <!-- ============================================================ -->

        <record id="office_document_rule_van_thu_hdqt_read" model="ir.rule">
            <field name="name">Office Document - Văn thư HĐQT: Xem văn bản HĐQT</field>
            <field name="model_id" ref="model_office_document"/>
            <field name="domain_force">[('document_type', '=', 'director')]</field>
            <field name="groups" eval="[(4, ref('quan_ly_cong_van.group_van_thu_hdqt'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="office_document_rule_van_thu_hdqt_write" model="ir.rule">
            <field name="name">Office Document - Văn thư HĐQT: Sửa văn bản HĐQT</field>
            <field name="model_id" ref="model_office_document"/>
            <field name="domain_force">[('document_type', '=', 'director')]</field>
            <field name="groups" eval="[(4, ref('quan_ly_cong_van.group_van_thu_hdqt'))]"/>
            <field name="perm_read" eval="0"/>
