<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Nhóm Văn thư -->
        <record id="group_van_thu" model="res.groups">
            <field name="name">Văn thư</field>
            <field name="category_id" ref="base.module_category_administration"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Nhóm Lãnh đạo -->
        <record id="group_lanh_dao" model="res.groups">
            <field name="name">Lãnh đạo</field>
            <field name="category_id" ref="base.module_category_administration"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Nhóm Đơn vị xử lý -->
        <record id="group_don_vi_xu_ly" model="res.groups">
            <field name="name">Đơn vị xử lý</field>
            <field name="category_id" ref="base.module_category_administration"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>


        <!-- Văn thư: xem tất cả -->
        <record id="office_document_rule_van_thu" model="ir.rule">
            <field name="name">Office Document - Văn thư: xem tất cả</field>
            <field name="model_id" ref="model_office_document"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('quan_ly_cong_van.group_van_thu'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>


        <!-- Lãnh đạo: xem công văn mình tạo, được phân phát hoặc là lãnh đạo xử lý -->
        <record id="office_document_rule_lanh_dao" model="ir.rule">
            <field name="name">Office Document - Lanh Dao</field>
            <field name="model_id" ref="model_office_document"/>
            <field name="domain_force">
                ['|', '|',
                    ('create_uid', '=', user.id),
                    ('detail2.nguoi_nhap_y_kien.user_id', '=', user.id),
                    ('lanh_dao_xu_ly.user_id', '=', user.id)
                ]
            </field>
            <field name="groups" eval="[(4, ref('quan_ly_cong_van.group_lanh_dao'))]"/>
        </record>



        <record id="office_document_rule_nhan_vien" model="ir.rule">
            <field name="name">Office Document - Nhân viên/Người dùng cơ bản</field>
            <field name="model_id" ref="model_office_document"/>
            <field name="domain_force">
                ['|', '|',
                    ('create_uid','=',user.id),
                    ('detail2.nguoi_nhap_y_kien.user_id','=',user.id),
                    ('lanh_dao_xu_ly.user_id','=',user.id)
                ]
            </field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="office_document_rule_nhan_vien" model="ir.rule">
            <field name="name">Office Document - Nhân viên/Người dùng cơ bản</field>
            <field name="model_id" ref="model_office_document"/>
            <field name="domain_force">
                ['|', '|',
                    ('create_uid','=',user.id),
                    ('detail2.nguoi_nhap_y_kien.user_id','=',user.id),
                    ('lanh_dao_xu_ly.user_id','=',user.id)
                ]
            </field>
            <field name="groups" eval="[(4, ref('quan_ly_cong_van.group_don_vi_xu_ly'))]"/>
        </record>

    </data>
</odoo>
