<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <!-- ==== MENU GỐC 1: QUẢN LÝ CÔNG VĂN ==== -->
        <!-- sequence="0" -> Xuất hiện đầu tiên -->
        <menuitem
                id="office_document_menu_root"
                name="Quản lý công văn"
                sequence="0"/>

        <!-- Các menu con của Quản lý công văn -->
        <menuitem
                id="document_ingoing_menu"
                name="Công văn đến"
                parent="office_document_menu_root"
                action="action_open_office_document_ingoing"
                sequence="10"/> <!-- Tăng sequence để dễ chèn menu khác nếu cần -->
        <menuitem
                id="document_outgoing_menu"
                name="Công văn đi"
                parent="office_document_menu_root"
                action="action_open_office_document_outgoing"
                sequence="20"/>
        <menuitem
                id="document_resolution_menu"
                name="Quyết định"
                parent="office_document_menu_root"
                action="action_open_office_document_resolution"
                sequence="30"/>
        <menuitem id="fleet_management_menu_root"
                  name="Quản lý đội xe"
                  parent="office_document_menu_root"
                  sequence="40"/>

        <menuitem id="menu_hr_tedi_vehicle_record"
                  name="Màn hình tất cả lý lịch xe"
                  parent="fleet_management_menu_root"
                  action="action_hr_tedi_vehicle_record"
                  sequence="10"/>
        <menuitem id="menu_hr_tedi_vehicle_registration"
                  name="Phiếu đăng ký xe"
                  parent="fleet_management_menu_root"
                  action="action_hr_tedi_vehicle_registration"
                  sequence="20"/>
        <menuitem id="menu_hr_tedi_vehicle_repair"
                  name="Phiếu sửa chữa xe"
                  parent="fleet_management_menu_root"
                  action="action_hr_tedi_vehicle_repair"
                  sequence="30"/>
        <menuitem id="menu_hr_tedi_vehicle_odometer_report"
                  name="Báo cáo số km từng xe"
                  parent="fleet_management_menu_root"
                  action="action_hr_tedi_vehicle_odometer_report"
                  sequence="50"/>
    </data>
</odoo>
