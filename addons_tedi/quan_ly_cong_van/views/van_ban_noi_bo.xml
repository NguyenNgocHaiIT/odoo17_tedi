<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <!-- ==================== VĂN BẢN ĐẾN (INCOMING) ==================== -->

        <record id="office_document_internal_ingoing_tree" model="ir.ui.view">
            <field name="name">office_document_internal_ingoing_tree</field>
            <field name="model">office.document.internal</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="ngay_den"/>
                    <field name="so_den_tong_hop"/>
                    <field name="so_hieu"/>
                    <field name="trich_yeu"/>
                    <field name="but_phe"/>
                    <field name="dv_xu_ly_chinh"/>
                </tree>
            </field>
        </record>

        <record id="office_document_internal_ingoing_form" model="ir.ui.view">
            <field name="name">cong_van_den_form</field>
            <field name="model">office.document.internal</field>
            <field name="arch" type="xml">
                <form delete="false" duplicate="false">
                    <header>
                        <button name="trinh_lanh_dao" string="Trình lãnh đạo" type="object"
                                groups="base.group_system, quan_ly_cong_van.group_van_thu"/>
                        <button name="approve" string="Duyệt" type="object"
                                groups="base.group_system, quan_ly_cong_van.group_lanh_dao"/>
                        <button name="but_phe_action" string="Bút phê" type="object"
                                groups="base.group_system, quan_ly_cong_van.group_lanh_dao, quan_ly_cong_van.group_van_thu"/>
                        <button name="phan_phat" string="Phân phát" type="object"
                                groups="base.group_system, quan_ly_cong_van.group_van_thu"
                                invisible="tt_vb != 'da_duyet'"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="so_den_tong_hop" string="Số công văn" readonly="1"/>
                                <field name="so_hieu"/>
                                <field name="don_vi_ban_hanh"/>
                                <field name="lanh_dao_theo_doi" string="Lãnh đạo phụ trách"/>
                                <field name="ngay_den"/>
                                <field name="ngay_ban_hanh"/>
                                <field name="document_type" invisible="1"/>
                                <field name="phan_loai_van_ban"/>
                                <field name="do_khan"/>
                            </group>
                            <group>
                                <field name="tt_vb" readonly="1"/>
                                <field name="lanh_dao_xu_ly"/>
                                <field name="ngay_hieu_luc"/>
                                <field name="so_den_tong_hop_so_den_theo_so" invisible="1"/>
                                <field name="but_phe" invisible="1"/>
                                <field name="dv_xu_ly_chinh" widget="many2many_tags" readonly="1" invisible="1"/>
                                <field name="dv_dong_xu_ly" widget="many2many_tags" readonly="1" invisible="1"/>
                            </group>
                        </group>
                        <label for="trich_yeu" string="Trích yếu"/>
                        <field name="trich_yeu"/>

                        <notebook>
                            <page string="Hồ sơ công việc">
                                <group>
                                    <group string="Chi tiết">
                                    </group>
                                    <group></group>
                                    <group>
                                        <field name="ngay_bat_dau"/>
                                        <field name="attachment" widget="binary"/>
                                        <field name="note"/>
                                    </group>
                                    <group>
                                        <field name="han_ket_thuc"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Ý kiến chỉ đạo">
                                <group></group>
                                <label for="detail1" string="Ý KIẾN CHỈ ĐẠO VÀ XỬ LÝ"/>
                                <field name="detail1" readonly="1">
                                    <tree editable="false" options="{'no_create': True, 'no_open': True}">
                                        <field name="nguoi_nhap_y_kien"/>
                                        <field name="nhom_phong_ban"/>
                                        <field name="noi_dung_chi_dao"/>
                                        <field name="thoi_diem_chi_dao"/>
                                    </tree>
                                </field>

                                <label for="detail3" string="XỬ LÝ VĂN BẢN CỦA BAN/PHÒNG"/>
                                <field name="detail3" readonly="1">
                                    <tree editable="false" options="{'no_create': True, 'no_open': True}">
                                        <field name="nguoi_nhap_y_kien"/>
                                        <field name="nhom_phong_ban"/>
                                        <field name="noi_dung_chi_dao"/>
                                        <field name="thoi_diem_chi_dao"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Phân phát">
                                <label for="detail2" string="CHI TIẾT PHÂN PHÁT"/>
                                <field name="detail2" readonly="1">
                                    <tree editable="false" options="{'no_create': True, 'no_open': True}">
                                        <field name="nguoi_nhap_y_kien" string="Họ tên"/>
                                        <field name="noi_dung_chi_dao" string="Trách nhiệm"/>
                                        <field name="nhom_phong_ban" string="Phòng ban"/>
                                        <field name="view_time" string="Thời gian đọc văn bản"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_open_office_document_internal_ingoing" model="ir.actions.act_window">
            <field name="name">Văn bản đến (Nội bộ)</field>
            <field name="res_model">office.document.internal</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('document_type','=','incoming')]</field>
            <field name="context">{'default_document_type': 'incoming'}</field>
            <field name="view_ids" eval="[(5, 0, 0),
        (0, 0, {'view_mode': 'tree', 'view_id': ref('office_document_internal_ingoing_tree')}),
        (0, 0, {'view_mode': 'form', 'view_id': ref('office_document_internal_ingoing_form')})]"/>
        </record>


        <!-- ==================== VĂN BẢN ĐI (OUTGOING) ==================== -->

        <record id="office_document_internal_outgoing_tree" model="ir.ui.view">
            <field name="name">office_document_internal_outgoing_tree</field>
            <field name="model">office.document.internal</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="ngay_ban_hanh"/>
                    <field name="so_di_tong_hop"/>
                    <field name="so_hieu"/>
                    <field name="trich_yeu"/>
                    <field name="but_phe"/>
                    <field name="don_vi_ban_hanh"/>
                </tree>
            </field>
        </record>

        <record id="office_document_internal_outgoing_form" model="ir.ui.view">
            <field name="name">cong_van_di_form</field>
            <field name="model">office.document.internal</field>
            <field name="arch" type="xml">
                <form delete="false" duplicate="false">
                    <header>
                        <button name="phan_phat" string="Phát hành" type="object"
                                groups="base.group_system, quan_ly_cong_van.group_van_thu, quan_ly_cong_van.group_lanh_dao"/>
                        <button name="but_phe_action" string="Bút phê" type="object"
                                groups="base.group_system, quan_ly_cong_van.group_lanh_dao, quan_ly_cong_van.group_van_thu"/>
                        <button name="phan_phat" string="Phân phát" type="object"
                                groups="base.group_system, quan_ly_cong_van.group_van_thu, quan_ly_cong_van.group_lanh_dao"/>
                    </header>
                    <sheet>
                        <label for="trich_yeu" string="Trích yếu"/>
                        <field name="trich_yeu"/>
                        <group>
                            <group>
                                <field name="so_di_tong_hop" readonly="1"/>
                                <field name="don_vi_ban_hanh"/>
                                <field name="do_khan"/>
                                <field name="phan_loai_van_ban"/>
                            </group>
                            <group>
                                <field name="so_hieu"/>
                                <field name="ngay_ban_hanh"/>
                                <field name="chuyen_ngoai" string="Chuyển ngoài"/>
                                <field name="ngay_chuyen_ngoai" invisible="not chuyen_ngoai"/>
                                <field name="dia_diem_chuyen_ngoai" invisible="not chuyen_ngoai"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Hồ sơ công việc">
                                <group>
                                    <group string="Chi tiết">
                                        <field name="attachment" widget="binary"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Ý kiến chỉ đạo">
                                <group></group>
                                <label for="detail1" string="Ý KIẾN CHỈ ĐẠO VÀ XỬ LÝ"/>
                                <field name="detail1" readonly="1">
                                    <tree editable="false" options="{'no_create': True, 'no_open': True}">
                                        <field name="nguoi_nhap_y_kien"/>
                                        <field name="nhom_phong_ban"/>
                                        <field name="noi_dung_chi_dao"/>
                                        <field name="thoi_diem_chi_dao"/>
                                    </tree>
                                </field>

                                <label for="detail3" string="XỬ LÝ VĂN BẢN CỦA BAN/PHÒNG"/>
                                <field name="detail3" readonly="1">
                                    <tree editable="false" options="{'no_create': True, 'no_open': True}">
                                        <field name="nguoi_nhap_y_kien"/>
                                        <field name="nhom_phong_ban"/>
                                        <field name="noi_dung_chi_dao"/>
                                        <field name="thoi_diem_chi_dao"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Phân phát">
                                <label for="detail2" string="CHI TIẾT PHÂN PHÁT"/>
                                <field name="detail2" readonly="1">
                                    <tree editable="false" options="{'no_create': True, 'no_open': True}">
                                        <field name="nguoi_nhap_y_kien" string="Họ tên"/>
                                        <field name="noi_dung_chi_dao" string="Trách nhiệm"/>
                                        <field name="nhom_phong_ban" string="Phòng ban"/>
                                        <field name="view_time" string="Thời gian đọc văn bản"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_open_office_document_internal_outgoing" model="ir.actions.act_window">
            <field name="name">Văn bản đi (Nội bộ)</field>
            <field name="res_model">office.document.internal</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('document_type','=','outgoing')]</field>
            <field name="context">{'default_document_type': 'outgoing'}</field>
            <field name="view_ids" eval="[(5, 0, 0),
        (0, 0, {'view_mode': 'tree', 'view_id': ref('office_document_internal_outgoing_tree')}),
        (0, 0, {'view_mode': 'form', 'view_id': ref('office_document_internal_outgoing_form')})]"/>
        </record>
    </data>
</odoo>