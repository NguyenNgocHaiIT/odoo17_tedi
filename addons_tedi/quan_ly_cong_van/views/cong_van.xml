                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_open_office_document_outgoing" model="ir.actions.act_window">
            <field name="name">Công văn đi</field>
            <field name="res_model">office.document</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('document_type','=','outgoing')]</field>
            <field name="context">{'default_document_type': 'outgoing'}</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'tree', 'view_id': ref('office_document_outgoing_tree')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('office_document_outgoing_form')})]"/>
        </record>

        <record id="office_document_resolution_tree" model='ir.ui.view'>
            <field name="name">office_document_resolution_tree</field>
            <field name="model">office.document</field>
            <field name="arch" type="xml">
                <tree default_order="create_date desc">
                    <field name="ngay_ban_hanh"/>
                    <field name="so_di_tong_hop"/>
                    <field name="so_hieu"/>
                    <field name="trich_yeu"/>
                    <field name="but_phe"/>
                    <field name="don_vi_ban_hanh"/>
                    <field name="tt_vb"/>
                </tree>
            </field>
        </record>

        <record id="office_document_resolution_form" model="ir.ui.view">
            <field name="name">quyet_dinh_form</field>
            <field name="model">office.document</field>
            <field name="arch" type="xml">
                <form delete="false" duplicate="false">
                    <header>
                        <button name="trinh_lanh_dao_cong_van_di" string="Trình lãnh đạo" type="object"
                                groups="base.group_system, base.group_user"
                                invisible="tt_vb != 'draft'"/>
                        <button name="approve" string="Duyệt" type="object"
                                invisible="tt_vb != 'cho_duyet' or not co_the_but_phe_cong_van_di"/>
                        <button name="khong_dat" string="Không đạt" type="object"
                                invisible="tt_vb != 'cho_duyet' or not co_the_but_phe_cong_van_di"/>
                        <button name="trinh_lanh_dao_cong_van_di_but_phe" string="Trình lãnh đạo để bút phê" type="object"
                                groups="base.group_system, quan_ly_cong_van.group_van_thu"
                                invisible="tt_vb != 'da_duyet'"/>
                        <button name="phat_hanh" string="Phát hành" type="object"
                                groups="base.group_system, quan_ly_cong_van.group_van_thu"
                                invisible="not (tt_vb in ('cho_phan_phat', 'cho_xu_ly'))"/>
                        <button name="but_phe_action" string="Bút phê" type="object"
                                invisible="not (tt_vb in ('cho_but_phe','cho_phan_phat','cho_xu_ly','phat_hanh')) or not co_the_but_phe_cong_van_di"/>
                        <button name="skip" string="Bỏ qua" type="object"
                                invisible="not show_skip_button"/>
                        <button name="phan_phat" string="Phân phát" type="object"
                                groups="base.group_system, quan_ly_cong_van.group_van_thu"
                                invisible="not (tt_vb in ('cho_phan_phat', 'phat_hanh'))"/>
                        <button name="huy" string="Hủy" type="object"
                                groups="base.group_system, quan_ly_cong_van.group_van_thu"
                                invisible="tt_vb == 'huy'"/>
                    </header>
                    <sheet>
                        <field name="can_create_don_vi" invisible="1"/>
                        <field name="show_skip_button" invisible="1"/>
                        <field name="co_the_but_phe_cong_van_di" invisible="1"/>
                        <field name="tt_vb" invisible="1"/>
                        <label for="trich_yeu" string="Trích yếu"/>
                        <field name="trich_yeu" readonly="tt_vb != 'draft'" required="1"/>
                        <group>
                            <group>
                                <field name="so_di_tong_hop" string="Số quyết định" required="1"/>
