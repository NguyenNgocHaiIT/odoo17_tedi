<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <record id="office_document_ingoing_tree" model='ir.ui.view'>
            <field name="name">office_document_ingoing_tree</field>
            <field name="model">office.document</field>
            <field name="arch" type="xml">
                <tree default_order="create_date desc">
                    <field name="ngay_den"/>
                    <field name="so_den_tong_hop"/>
                    <field name="so_hieu"/>
                    <field name="trich_yeu"/>
                    <field name="but_phe"/>
                    <field name="dv_xu_ly_chinh" />
                    <field name="tt_vb" />
                </tree>
            </field>
        </record>

        <record id="office_document_ingoing_form" model="ir.ui.view">
            <field name="name">cong_van_den_form</field>
            <field name="model">office.document</field>
            <field name="arch" type="xml">
                <form delete="false" duplicate="false" >
                    <header>
                        <button name="xac_nhan" string="Xác nhận" type="object"
                                invisible="tt_vb != 'draft'"/>
                        <button name="trinh_lanh_dao_cong_van_den" string="Trình lãnh đạo" type="object"
                                groups="base.group_system, quan_ly_cong_van.group_van_thu"
                                invisible="tt_vb != 'da_duyet'"/>
                        <button name="approve" string="Duyệt" type="object"
                                groups="base.group_system, quan_ly_cong_van.group_van_thu"
                                invisible="tt_vb != 'cho_duyet'"/>
                        <button name="but_phe_action" string="Bút phê" type="object"
                                invisible="not (tt_vb in ('cho_but_phe','cho_phan_phat','cho_xu_ly','phat_hanh')) or not co_the_but_phe_cong_van_den"/>
                        <button name="phan_phat" string="Phân phát" type="object"
                                groups="base.group_system, quan_ly_cong_van.group_van_thu"
                                invisible="not (tt_vb in ('cho_phan_phat', 'cho_xu_ly', 'phat_hanh'))"/>
                        <button name="huy" string="Hủy" type="object"
                                groups="base.group_system, quan_ly_cong_van.group_van_thu"
                                invisible="tt_vb == 'huy'"/>
                    </header>
                    <sheet>
                        <field name="can_create_don_vi" invisible="1"/>
                        <field name="is_van_thu" invisible="1"/>
                        <field name="not_is_van_thu" invisible="1"/>
                        <field name="co_the_but_phe_cong_van_den" invisible="1"/>
                        <group>
                            <group>
                                <field name="outgoing_internal_id" string="Công văn nội bộ đi liên quan"
                                       invisible="document_type != 'incoming_internal'" readonly="not (is_van_thu or not_is_van_thu)" required="1"/>
                                <field name="so_den_tong_hop" string="Số công văn" readonly="1"/>
                                <field name="so_hieu" readonly="not (is_van_thu or not_is_van_thu)" required="1"/>
                                <field name="don_vi_ban_hanh"
                                       invisible="not (document_type in ('incoming_internal','outgoing_internal','resolution'))"
                                       readonly="not (is_van_thu or not_is_van_thu)" required="1"
                                       context="{'no_create': not can_create_don_vi}"/>
                                <field name="don_vi_ban_hanh_ngoai"
                                       invisible="not (document_type in ('incoming','outgoing'))"
                                       readonly="not (is_van_thu or not_is_van_thu)" required="1"
                                       context="{'no_create': not can_create_don_vi}"/>
                                <field name="lanh_dao_xu_ly" string="Lãnh đạo phụ trách" widget="many2many_tags" readonly="not (is_van_thu or not_is_van_thu)" required="1"/>
                                <field name="document_type" invisible="1"/>
                                <field name="phan_loai_van_ban" readonly="not (is_van_thu or not_is_van_thu)" required="1"/>


                                <!--                                <field name="noi_gui"/>-->
                                <!--                                <field name="nguoi_ky"/>-->
                                <!--                                <field name="vb_nhan"/>-->


                                <!--                                <field name="phoi_hop_xu_ly"/>-->
                            </group>
                            <group>
                                <field name="tt_vb" readonly="1"/>


                                <!--                                <field name="so_den_theo_so"/>-->
                                <!--                                <field name="so_vb"/>-->
                                <field name="ngay_den" readonly="not (is_van_thu or not_is_van_thu)" required="1"/>
                                <field name="ngay_ban_hanh" readonly="not (is_van_thu or not_is_van_thu)"/>
                                <field name="ngay_hieu_luc" readonly="not (is_van_thu or not_is_van_thu)" required="1"/>
                                <field name="do_khan" readonly="not (is_van_thu or not_is_van_thu)" required="1"/>
                                <!--                                <field name="ngay_ky"/>-->
                                <!--                                <field name="chuc_vu"/>-->
                                <!--                                <field name="do_quan_trong"/>-->
                                <!--                                <field name="nguoi_xu_ly_chinh"/>-->
                                <field name="so_den_tong_hop_so_den_theo_so" invisible="1"/>
                                <field name="but_phe" invisible="1"/>
                                <field name="dv_xu_ly_chinh" readonly="1"/>
                                <field name="dv_dong_xu_ly" widget="many2many_tags" readonly="1"/>
                            </group>
                        </group>
                        <label for="trich_yeu" string="Trích yếu" />
                        <field name="trich_yeu" readonly="not (is_van_thu or not_is_van_thu)" required="1"/>

                        <notebook>
                            <page string="Hồ sơ công việc">
                                <group>
                                    <group string="Chi tiết">
                                        <!-- <field name="pb_dv_nhan"/> -->
                                        <!-- <field name="ca_nhan_dv_nhan"/> -->
                                        <!-- <field name="nhom_nguoi_dung_dv_nhan"/> -->
                                    </group>
                                    <group></group>
                                    <group class="o_form_label_fixed">
                                        <!-- <field name="nguoi_theo_doi"/> -->
                                        <field name="ngay_bat_dau" readonly="not (is_van_thu or not_is_van_thu)"/>
                                    </group>
                                    <group class="o_form_label_fixed">
                                        <!-- <field name="noi_luu_tru"/> -->
                                        <field name="han_ket_thuc" readonly="not (is_van_thu or not_is_van_thu)"/>
                                    </group>
                                    <!-- <field name="ho_so_cong_viec"/> -->
                                    <group colspan="2" class="o_form_label_fixed">
                                        <field name="attachment" widget="pdf_viewer" readonly="not (is_van_thu or not_is_van_thu)" required="1"/>
                                    </group>
                                    <group colspan="2" class="o_form_label_fixed">
                                        <field name="note" readonly="not (is_van_thu or not_is_van_thu)"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Ý kiến chỉ đạo">
                                <group></group>
                                <label for="detail1" string="Ý KIẾN CHỈ ĐẠO VÀ XỬ LÝ"/>
                                <field name="detail1" readonly="1">
                                    <tree editable="false" options="{'no_create': True, 'no_open': True}">
                                        <field name="nguoi_nhap_y_kien"/>
                                        <field name="nhom_phong_ban"/>
                                        <field name="noi_dung_chi_dao"/>
                                        <field name="thoi_diem_chi_dao"/>
                                    </tree>
                                </field>

                                <field name="tt_vb" invisible="1"/>
                                <label for="detail3" string="XỬ LÝ VĂN BẢN CỦA BAN/PHÒNG"/>
                                <field name="detail3" readonly="tt_vb == 'huy'">
                                    <tree editable="bottom" options="{'no_create': True, 'no_open': True}">
                                        <field name="nguoi_nhap_y_kien" readonly="1"/>
                                        <field name="nhom_phong_ban" readonly="1"/>
                                        <field name="noi_dung_chi_dao"/>
                                        <field name="thoi_diem_chi_dao" readonly="1"/>
                                    </tree>
                                </field>

                            </page>
                            <page string="Phân phát">
                                <label for="detail2" string="CHI TIẾT PHÂN PHÁT"/>
                                <field name="detail2" options="{'no_open': True, 'no_create': True, 'no_edit': True, 'no_delete': True}">
                                    <tree default_order="sequence, id"
                                          decoration-section_dark="is_section"
                                          expandable="1"
                                          class="o_office_document_detail2_tree"
                                          create="false" edit="false" delete="true">
                                        <field name="allow_assign" column_invisible="1"/>
                                        <field name="is_section" column_invisible="1"/>


                                        <field name="nguoi_nhap_y_kien" string="Họ tên"/>
                                        <field name="noi_dung_chi_dao" string="Trách nhiệm"/>
                                        <field name="nhom_phong_ban" string="Phòng ban"/>
                                        <field name="view_time" string="Thời gian đọc văn bản"/>
                                        <field name="cong_viec" string="Công việc được giao" invisible="is_section"/>


                                        <button name="action_open_assign_wizard"
                                                string="Giao việc"
                                                type="object"
                                                icon="fa-tasks"
                                                class="oe_highlight"
                                                invisible="not allow_assign"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>


                        <!--                        <label for="detail2" string="Ý KIẾN CẤP LÃNH ĐẠO"/>-->
                        <!--                        <field name="detail2">-->
                        <!--                            <tree editable="bottom">-->
                        <!--                                <field name="nguoi_nhap_y_kien"/>-->
                        <!--                                <field name="nhom_phong_ban"/>-->
                        <!--                                <field name="noi_dung_chi_dao"/>-->
                        <!--                                <field name="thoi_diem_chi_dao"/>-->
                        <!--                            </tree>-->
                        <!--                        </field>-->

                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_open_office_document_ingoing" model="ir.actions.act_window">
            <field name="name">Công văn đến</field>
            <field name="res_model">office.document</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('document_type','=','incoming')]</field>
            <field name="context">{'default_document_type': 'incoming'}</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'tree', 'view_id': ref('office_document_ingoing_tree')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('office_document_ingoing_form')})]"/>

        </record>

        <record id="office_document_outgoing_tree" model='ir.ui.view'>
            <field name="name">office_document_outgoing_tree</field>
            <field name="model">office.document</field>
            <field name="arch" type="xml">
                <tree default_order="create_date desc">
                    <field name="ngay_ban_hanh"/>
                    <field name="so_di_tong_hop"/>
                    <field name="so_hieu"/>
                    <field name="trich_yeu"/>
                    <field name="but_phe"/>
                    <field name="don_vi_ban_hanh"/>
                    <field name="tt_vb"/>
                </tree>
            </field>
        </record>

        <record id="office_document_outgoing_form" model="ir.ui.view">
            <field name="name">cong_van_đi_form</field>
            <field name="model">office.document</field>
            <field name="arch" type="xml">
                <form delete="false" duplicate="false">
                    <header>
                        <button name="trinh_lanh_dao_cong_van_di" string="Trình lãnh đạo" type="object"
                                groups="base.group_system, base.group_user"
                                invisible="tt_vb != 'draft'"/>
                        <button name="approve" string="Duyệt" type="object"
                                invisible="tt_vb != 'cho_duyet' or not co_the_but_phe_cong_van_di"/>
                        <button name="khong_dat" string="Không đạt" type="object"
                                invisible="tt_vb != 'cho_duyet' or not co_the_but_phe_cong_van_di" />
                        <button name="trinh_lanh_dao_cong_van_di_but_phe" string="Trình lãnh đạo để bút phê" type="object"
                                groups="base.group_system, quan_ly_cong_van.group_van_thu"
                                invisible="tt_vb != 'da_duyet'"/>
                        <button name="phat_hanh" string="Phát hành" type="object"
                                groups="base.group_system, quan_ly_cong_van.group_van_thu"
                                invisible="not (tt_vb in ('cho_phan_phat', 'cho_xu_ly'))"/>
                        <button name="but_phe_action" string="Bút phê" type="object"
                                invisible="not (tt_vb in ('cho_but_phe','cho_phan_phat','cho_xu_ly','phat_hanh')) or not co_the_but_phe_cong_van_di"/>
                        <button name="skip" string="Bỏ qua" type="object"
                                invisible="not show_skip_button"/>
                        <button name="phan_phat" string="Phân phát" type="object"
                                groups="base.group_system, quan_ly_cong_van.group_van_thu"
                                invisible="not (tt_vb in ('cho_phan_phat', 'cho_xu_ly', 'phat_hanh'))"/>
                        <button name="huy" string="Hủy" type="object"
                                groups="base.group_system, quan_ly_cong_van.group_van_thu"
                                invisible="tt_vb == 'huy'"/>
                    </header>
                    <sheet>
                        <field name="can_create_don_vi" invisible="1"/>
                        <field name="show_skip_button" invisible="1"/>
                        <field name="co_the_but_phe_cong_van_di" invisible="1"/>
                        <label for="trich_yeu" string="Trích yếu"/>
                        <field name="trich_yeu" readonly="tt_vb != 'draft'" required="1"/>
                        <group>
                            <group>
                                <field name="document_type" invisible="1"/>
                                <field name="so_di_tong_hop" readonly="1"/>
                                <field name="don_vi_ban_hanh"
                                       invisible="not (document_type in ('incoming_internal','outgoing_internal','resolution'))"
                                       readonly="tt_vb != 'draft'" required="1"
                                       context="{'no_create': not can_create_don_vi}"/>
                                <field name="don_vi_ban_hanh_ngoai"
                                       invisible="not (document_type in ('incoming','outgoing'))"
                                       readonly="tt_vb != 'draft'" required="1"
                                       context="{'no_create': not can_create_don_vi}"/>
                                <field name="lanh_dao_theo_doi" string="Lãnh đạo phụ trách" readonly="tt_vb != 'draft'" required="1"/>
                                <!--                                <field name="don_vi_soan_thao"/>-->

                                <!--                                <field name="ngay_ky"/>-->
                                <!--                                <field name="nguoi_ky"/>-->
                                <field name="do_khan" readonly="tt_vb != 'draft'" required="1"/>
                                <field name="phan_loai_van_ban" readonly="tt_vb != 'draft'" required="1"/>
                                <!--                                <field name="nguoi_soan_thao"/>-->
                                <!--                                <field name="dv_theo_doi_chinh"/>-->
                                <!--                                <field name="phoi_hop_xu_ly"/>-->
                            </group>
                            <group>
                                <field name="tt_vb" readonly="1"/>
                                <field name="so_hieu" readonly="tt_vb != 'draft'" required="1"/>
                                <field name="ngay_ban_hanh" readonly="tt_vb != 'draft'" required="1"/>
                                <field name="ngay_xuat" readonly="tt_vb != 'draft'" required="1"/>

                                <field name="chuyen_ngoai" string="Chuyển ngoài" readonly="tt_vb != 'draft'" required="1"/>
                                <field name="ngay_chuyen_ngoai" invisible="not chuyen_ngoai" readonly="tt_vb != 'draft'"/>
                                <field name="dia_diem_chuyen_ngoai" invisible="not chuyen_ngoai" readonly="tt_vb != 'draft'" />
                                <field name="can_duyet" groups="base.group_system, quan_ly_cong_van.group_lanh_dao" readonly="tt_vb != 'draft'" />
                                <!--                                <field name="so_di_theo_so"/>-->
                                <!--                                <field name="so_vb"/>-->
                                <!--                                <field name="ngay_hieu_luc"/>-->
                                <!--                                <field name="chuc_vu"/>-->
                                <!--                                <field name="do_quan_trong"/>-->

                                <!--                                <field name="nguoi_theo_doi_chinh"/>-->
                                <!--                                <field name="but_phe"/>-->
                                <!--                                <field name="so_di_tong_hop_so_den_theo_so"/>-->
                            </group>
                        </group>

                        <!--                        <group>-->
                        <!--                            <group string="Hồ sơ công việc">-->
                        <!--                                <field name="pb_dv_nhan"/>-->
                        <!--                                <field name="ca_nhan_dv_nhan"/>-->
                        <!--                                <field name="nhom_nguoi_dung_dv_nhan"/>-->
                        <!--                            </group>-->

                        <!--                            <group>-->

                        <!--                            </group>-->
                        <!--                            <group>-->
                        <!--                                <field name="noi_luu_tru"/>-->
                        <!--                                <field name="ho_so_cong_viec"/>-->
                        <!--                                <field name="attachment" widget="binary"/>-->
                        <!--                            </group>-->
                        <!--                            <group/>-->
                        <!--                        </group>-->
                        <notebook>
                            <page string="Hồ sơ công việc">
                                <group string="Chi tiết">
                                    <field name="attachment" widget="pdf_viewer" readonly="tt_vb != 'draft'" style="width: 100%;"/>
                                </group>
                            </page>
                            <page string="Ý kiến chỉ đạo">
                                <group></group>
                                <label for="detail1" string="Ý KIẾN CHỈ ĐẠO VÀ XỬ LÝ"/>
                                <field name="detail1" readonly="1">
                                    <tree editable="false" options="{'no_create': True, 'no_open': True}">
                                        <field name="nguoi_nhap_y_kien"/>
                                        <field name="nhom_phong_ban"/>
                                        <field name="noi_dung_chi_dao"/>
                                        <field name="thoi_diem_chi_dao"/>
                                    </tree>
                                </field>

                                <field name="tt_vb" invisible="1"/>
                                <label for="detail3" string="XỬ LÝ VĂN BẢN CỦA BAN/PHÒNG"/>
                                <field name="detail3" readonly="tt_vb == 'huy'">
                                    <tree editable="bottom" options="{'no_create': True, 'no_open': True}">
                                        <field name="nguoi_nhap_y_kien" readonly="1"/>
                                        <field name="nhom_phong_ban" readonly="1"/>
                                        <field name="noi_dung_chi_dao"/>
                                        <field name="thoi_diem_chi_dao" readonly="1"/>
                                    </tree>
                                </field>

                            </page>
                            <page string="Phân phát">
                                <label for="detail2" string="CHI TIẾT PHÂN PHÁT"/>
                                <field name="detail2" options="{'no_create': True, 'no_edit': True, 'no_delete': True}">
                                    <tree default_order="is_section desc, nguoi_quan_ly, sequence, id"
                                          decoration-bf="is_section"
                                          decoration-italic="is_section"
                                          expandable="1"
                                          class="o_office_document_detail2_tree"
                                          create="false" edit="false" delete="true">

                                        <field name="allow_assign" column_invisible="1"/>
                                        <field name="is_section" column_invisible="1"/>

                                        <field name="nguoi_nhap_y_kien" string="Họ tên"/>
                                        <field name="noi_dung_chi_dao" string="Trách nhiệm"/>
                                        <field name="nhom_phong_ban" string="Phòng ban"/>
                                        <field name="view_time" string="Thời gian đọc văn bản"/>
                                        <field name="cong_viec" string="Công việc được giao" invisible="is_section"/>

                                        <button name="action_open_assign_wizard"
                                                string="Giao việc"
                                                type="object"
                                                icon="fa-tasks"
                                                class="oe_highlight"
                                                invisible="not allow_assign"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>

