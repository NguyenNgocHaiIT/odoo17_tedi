<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_office_task_tree" model="ir.ui.view">
        <field name="name">office.task.tree</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <tree default_order="create_date desc">
                <field name="don_vi"/>
                <field name="name" string="Nội dung"/>
                <field name="date_deadline" string="Thời hạn"/>
                <field name="da_giao_viec" string="Đã giao việc"/>
                <field name="da_tao_cong_van" string="Đã tạo công văn"/>
            </tree>
        </field>
    </record>

    <record id="view_office_task_form" model="ir.ui.view">
        <field name="name">office.task.form</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <form string="Giao việc">
                <field name="task_type" invisible="1"/>
                <header>
                    <button name="action_confirm_task" string="Giao việc" type="object"
                            invisible="da_giao_viec"/>
                    <button string="Huỷ" class="btn btn-secondary" special="cancel"
                            invisible="da_giao_viec or da_tao_cong_van"/>
                    <button name="action_create_document" string="Tạo công văn" type="object"
                            invisible="da_tao_cong_van or task_type != 'cong_van_di'"/>
                    <button name="action_create_resolution" string="Tạo quyết định" type="object"
                            invisible="da_tao_cong_van or task_type != 'quyet_dinh'"/>
                    <button name="action_create_internal_document" string="Tạo công văn" type="object"
                            invisible="da_tao_cong_van or task_type != 'cong_van_di_noi_bo'"/>

                </header>
                <sheet>
                    <field name="da_giao_viec" invisible="1"/>
                    <field name="da_tao_cong_van" invisible="1"/>
                    <group>
                        <group>
                            <field name="don_vi" readonly="da_giao_viec or da_tao_cong_van"/>
                        </group>
                        <group>
                            <field name="date_deadline" string="Thời hạn" readonly="da_giao_viec or da_tao_cong_van"/>
                        </group>
                    </group>
                    <group>
                        <field name="name" string="Nội dung" readonly="da_giao_viec or da_tao_cong_van"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_open_office_document_task" model="ir.actions.act_window">
        <field name="name">Giao việc</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('task_type','=','cong_van_di'), ('project_id','=',False)]</field>
        <field name="context">{'task_type': 'cong_van_di'}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_office_task_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_office_task_form')})]"/>
    </record>

    <record id="action_open_office_resolution_task" model="ir.actions.act_window">
        <field name="name">Giao việc</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('task_type','=','quyet_dinh'), ('project_id','=',False)]</field>
        <field name="context">{'task_type': 'quyet_dinh'}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_office_task_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_office_task_form')})]"/>
    </record>

    <record id="action_open_office_internal_document_task" model="ir.actions.act_window">
        <field name="name">Giao việc</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('task_type','=','cong_van_di_noi_bo'), ('project_id','=',False)]</field>
        <field name="context">{'task_type': 'cong_van_di_noi_bo'}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_office_task_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_office_task_form')})]"/>
    </record>
</odoo>