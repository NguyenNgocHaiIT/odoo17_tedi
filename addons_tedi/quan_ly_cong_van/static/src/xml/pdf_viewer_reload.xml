<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="quan_ly_cong_van.PdfViewerReload" owl="1">
        <div class="o_field_pdf_viewer_reload" style="width: 100%; height: 100%;">
            <iframe t-if="hasContent"
                    t-ref="iframe"
                    t-att-key="state.timestamp"
                    style="width: 100%; height: 600px; border: 1px solid #ddd; border-radius: 4px;"
                    type="application/pdf"/>
            <div t-else="" class="alert alert-info text-center mt-3">
                <i class="fa fa-file-pdf-o fa-3x mb-3" style="display: block;"/>
                <p class="mb-0">Chưa có tài liệu để xem trước</p>
            </div>
        </div>
    </t>
</templates>