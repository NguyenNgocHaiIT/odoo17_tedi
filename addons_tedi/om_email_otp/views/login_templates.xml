<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="otp_verify_form" name="OTP Verification">
        <t t-call="web.login_layout">
            <form class="oe_login_form" role="form" method="post" action="/web/otp/verify">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="hidden" name="redirect" t-att-value="redirect"/>

                <div class="mb-3 text-center">
                    <h6>Vui lòng kiểm tra Email của bạn</h6>
                    <p class="text-muted small">Chúng tôi vừa gửi một mã xác minh gồm 6 chữ số.</p>
                </div>

                <div class="mb-3">
                    <label for="otp_code" class="form-label">Mã OTP</label>
                    <input type="text" name="otp_code" id="otp_code" class="form-control" required="required" autofocus="autofocus" placeholder="Nhập mã 6 số..."/>
                </div>

                <p class="alert alert-danger" t-if="error" role="alert">
                    <t t-esc="error"/>
                </p>

                <div class="d-grid gap-2 pt-2">
                    <button type="submit" class="btn btn-primary">Xác nhận Đăng nhập</button>
                    <a href="/web/login" class="btn btn-link btn-sm">Quay lại</a>
                </div>
            </form>
        </t>
    </template>
</odoo>