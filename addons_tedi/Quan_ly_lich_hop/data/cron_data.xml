<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_auto_complete_meeting" model="ir.cron">
            <field name="name">Lịch họp: Tự động hoàn thành khi hết giờ</field>
            <field name="model_id" ref="model_calendar_event"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_complete_meetings()</field>
            <field name="user_id" ref="base.user_root"/> <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field> <field name="doall" eval="False"/>
        </record>

        <!-- Cron job gửi thông báo nhắc nhở 30 phút trước khi họp -->
        <record id="cron_send_meeting_reminder" model="ir.cron">
            <field name="name">Gửi nhắc nhở cuộc họp (30 phút trước)</field>
            <field name="model_id" ref="model_calendar_event"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_meeting_reminder()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>