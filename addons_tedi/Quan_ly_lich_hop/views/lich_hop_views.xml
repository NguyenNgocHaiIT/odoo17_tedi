<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_calendar_event_calendar" model="ir.ui.view">
            <field name="name">calendar.event.calendar</field>
            <field name="model">calendar.event</field>
            <field name="arch" type="xml">
                <calendar string="Lịch họp" date_start="start" date_stop="stop" color="color">
                    <field name="name" string="Nội dung"/>
                    <field name="chu_tri" string="Người chủ trì"/>
<!--                    <field name="employee_ids" widget="many2many_tags" string="Người tham gia"/>-->
                    <field name="don_vi" string="Đơn vị"/>
                </calendar>
            </field>
        </record>

        <record id="view_calendar_event_tree" model="ir.ui.view">
            <field name="name">calendar.event.tree</field>
            <field name="model">calendar.event</field>
            <field name="arch" type="xml">
                <tree default_order="create_date desc">
                    <field name="name" string="Chủ đề cuộc họp"/>
                    <field name="start" string="Thời gian bắt đầu"/>
                    <field name="stop" string="Thời gian kết thúc"/>
                    <field name="chu_tri" string="Người chủ trì"/>
                    <field name="employee_ids" string="Người tham gia" widget="many2many_tags"/>
                </tree>
            </field>
        </record>

        <record id="view_calendar_event_form" model="ir.ui.view">
            <field name="name">calendar.event.form</field>
            <field name="model">calendar.event</field>
            <field name="priority" eval="30"/>
            <field name="arch" type="xml">
                <form delete="false" duplicate="false">
                    <header>
                        <field name="can_approve_meeting" invisible="1"/>
                        <field name="state"
                               widget="statusbar"
                               statusbar_visible="draft,pending,approved"/>


                        <field name="room_sign" invisible="1"/>
                        <field name="is_current_user_creator" invisible="1"/>

                        <button name="action_send_request"
                                string="Gửi duyệt"
                                type="object"
                                class="btn-primary"
                                invisible="not is_current_user_creator or state != 'draft'"/>

                        <button name="approve_department"
                                string="Duyệt"
                                type="object"
                                class="btn-primary"
                                invisible="not can_approve_meeting or state != 'pending' or not is_manager_department or check_department_status"/>


                        <button name="approve"
                                string="Duyệt"
                                type="object"
                                class="btn-primary"
                                invisible="not is_chu_tri or state != 'pending' or is_manager_department"/>
<!--                        <button name="approve"-->
<!--                                string="Duyệt"-->
<!--                                type="object"-->
<!--                                class="btn-primary"-->
<!--                                invisible="not can_approve_meeting or state != 'pending' or is_manager_department"/>-->

                        <button name="action_cancel"
                                string="Huỷ"
                                type="object"
                                class="btn-secondary"
                                confirm="Bạn có chắc chắn muốn hủy lịch họp này không?"
                                invisible="state not in ['draft','pending']" />

                        <button name="open_room_booking_wizard"
                                string="Đăng ký phòng họp"
                                type="object"
                                class="btn-primary"
                                invisible="room_sign != 'no_sign' or state != 'approved' or not is_current_user_creator"/>

                        <field name="can_add_participants" invisible="1"/>
                        <button name="action_add_participants"
                                string="Thêm người tham gia"
                                type="object"
                                invisible="not can_add_participants"
                                class="btn-primary"/>
                    </header>

                    <sheet>
<!--                        <field name="can_approve_meeting" />-->
<!--                        <field name="is_current_user_creator" />-->

                        <widget name="web_ribbon" title="Đã duyệt phòng" bg_color="bg-success" invisible="room_sign != 'have_sign'"/>
                        <widget name="web_ribbon" title="Chờ duyệt phòng" bg_color="bg-warning" invisible="room_sign != 'pending'"/>

                        <div class="oe_title">
                            <label for="name" string="Chủ đề cuộc họp"/>
                            <h1>
                                <field name="name" readonly="not is_current_user_creator or (state not in ('draft','pending'))" required="1"/>
                            </h1>
                        </div>

                        <group>
                            <group>
                                <label for="start" string="Thời gian"/>
                                <div style="display: flex;" >
                                    <field name="start" class="oe_inline" style="flex:1;" readonly="(not is_chu_tri and not is_manager_department) or (state not in ('draft','pending'))" required="1"/>
                                    <span class="o_form_label" style="padding: 0 4px;">→</span>
                                    <field name="stop" class="oe_inline" style="flex:1;" readonly="(not is_chu_tri and not is_manager_department) or (state not in ('draft','pending'))"/>
                                </div>

                                <field name="name" string="Nội dung" readonly="(not is_chu_tri and not is_manager_department) or (state not in ('draft','pending'))" required="1"/>
                                <field name="loai_cuoc_hop" readonly="(not is_chu_tri and not is_manager_department) or (state not in ('draft','pending'))" required="1" string="Loại cuộc họp"/>
                                <field name="link_cuoc_hop" invisible="loai_cuoc_hop != 'online'"/>
                            </group>

                            <group>
                                <field name="is_manager_department" invisible="1"/>
                                <field name="check_department_status" invisible="1"/>
                                <field name="is_chu_tri" invisible="1"/>
                                <field name="lanh_dao" string="Lãnh đạo" widget="many2many_tags" readonly="(not is_chu_tri and not is_manager_department) or (state not in ('draft','pending'))"/>
                                <field name="chu_tri" string="Người chủ trì" readonly="(not is_chu_tri and not is_manager_department) or (state not in ('draft','pending'))" required="1"/>
                                <field name="don_vi" widget="many2many_tags" string="Đơn vị tham gia" readonly="(not is_chu_tri and not is_manager_department) or (state not in ('draft','pending'))"/>
                                 <field name="lanh_dao_don_vi" string="Lãnh đạo đơn vị"  widget="many2many_tags"/>
                                <field name="employee_ids" widget="many2many_tags"
                                       string="Người tham gia"
                                       readonly="1"/>
                                <field name="so_nguoi_tham_gia" readonly="(not is_chu_tri and not is_manager_department) or (state not in ('draft','pending'))"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_open_calendar" model="ir.actions.act_window">
            <field name="name">Lịch họp</field>
            <field name="res_model">calendar.event</field>
            <field name="view_mode">tree,form,calendar</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'tree', 'view_id': ref('view_calendar_event_tree')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_calendar_event_form')}),
                (0, 0, {'view_mode': 'calendar', 'view_id': ref('view_calendar_event_calendar')})]"/>
        </record>

        <record id="view_room_booking_wizard_form" model="ir.ui.view">
            <field name="name">room.booking.wizard.form</field>
            <field name="model">room.booking.wizard</field>
            <field name="arch" type="xml">
                <form string="Đăng ký phòng họp">
                    <group>
                        <field name="event_id" invisible="1"/>
                        <field name="start" readonly="1"/>
                        <field name="stop" readonly="1"/>
                        <field name="room_id"
                               options="{'no_create': True}"
                               required="1"/>
                    </group>
                    <footer>
                        <button string="Đăng ký" type="object" name="action_confirm" class="btn-primary"/>
                        <button string="Hủy" type="object" name="action_cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="view_meeting_invitation_wizard_form" model="ir.ui.view">
            <field name="name">meeting.invitation.wizard.form</field>
            <field name="model">meeting.invitation.wizard</field>
            <field name="arch" type="xml">
                <form string="Lời mời họp">
                    <sheet>
                        <group>
                            <field name="event_id" readonly="1"/>
                            <field name="employee_id" readonly="1"/>
                            <field name="action_type" widget="radio"/>
                            <field name="note"/>
                        </group>
                        <footer>
                            <button string="Xác nhận" type="object" name="action_confirm" class="btn-primary"/>
                            <button string="Hủy" class="btn-secondary" special="cancel"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_meeting_invitation_popup" model="ir.actions.act_window">
            <field name="name">Lời mời họp</field>
            <field name="res_model">meeting.invitation.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_meeting_invitation_wizard_form"/>
            <field name="target">new</field>
            <field name="context">{}</field>
        </record>

        <record id="view_calendar_add_participants_wizard_form" model="ir.ui.view">
            <field name="name">calendar.add.participants.wizard.form</field>
            <field name="model">calendar.add.participants.wizard</field>
            <field name="arch" type="xml">
                <form string="Thêm người tham gia">
                    <sheet>
                        <field name="employee_ids" widget="many2many_tags"/>
                    </sheet>
                    <footer>
                        <button string="Xác nhận" type="object" name="action_confirm" class="btn-primary"/>
                        <button string="Hủy" class="btn-secondary" special="cancel"/>

                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>