<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_calendar_event_outside_calendar" model="ir.ui.view">
            <field name="name">calendar.event.outside.calendar</field>
            <field name="model">calendar.outside</field>
            <field name="arch" type="xml">
                <calendar string="Lịch họp" date_start="start" date_stop="stop" color="color">
                    <field name="name" string="Nội dung"/>
                    <field name="location" string="Địa điểm"/>
                    <field name="user_id" string="Người chủ trì"/>
                    <field name="partner_ids" widget="many2many_tags" string="Người tham gia"/>
                </calendar>
            </field>
        </record>

        <!-- TREE VIEW -->
        <record id="view_calendar_event_outside_tree" model="ir.ui.view">
            <field name="name">calendar.event.outside.tree</field>
            <field name="model">calendar.outside</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name" string="Chủ đề cuộc họp"/>
                    <field name="location" string="Địa điểm "/>
                    <field name="start" string="Thời gian bắt đầu"/>
                    <field name="stop" string="Thời gian kết thúc"/>
                    <field name="user_id" string="Người chủ trì"/>
                    <field name="partner_ids" string="Thành phần tham gia" widget="many2many_tags"/>
                </tree>
            </field>
        </record>

        <!-- FORM VIEW -->
        <record id="view_calendar_event_outside_form" model="ir.ui.view">
            <field name="name">calendar.event.outside.form</field>
            <field name="model">calendar.outside</field>
            <field name="arch" type="xml">
                <form delete="false" duplicate="false">
                    <header>
                        <button name="approve" string="Duyệt" type="object"
                                groups="base.group_system"/>
                        <button string="Huỷ" class="btn btn-secondary" special="cancel"
                                groups="base.group_system"/>
                    </header>

                    <style>
                        .fixed-label {
                        display: block;
                        width: 120px;
                        margin: 0;
                        align-self: center;
                        text-align: left;
                        padding-right: 8px;
                        }
                    </style>

                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Chủ đề cuộc họp" class="o_form_label"/>
                            <h1>
                                <field name="name"
                                       style="border: 1px solid #dcdcdc; padding: 4px; border-radius: 12px;"/>
                            </h1>
                        </div>

                        <div style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 12px;">
                            <label for="start" string="Thời gian" class="o_form_label"/>
                            <div style="display: flex; gap: 8px; flex: 1;">
                                <field name="start" class="oe_inline"
                                       style="margin: 0; border: 1px solid #dcdcdc; padding: 4px; border-radius: 12px; flex: 1;"/>
                                <span class="o_form_label" style="padding: 0 4px;">→</span>
                                <field name="stop" class="oe_inline"
                                       style="margin: 0; border: 1px solid #dcdcdc; padding: 4px; border-radius: 12px; flex: 1;"/>
                            </div>
                        </div>

                        <div style="display: flex; align-items: center;">
                            <label for="lanh_dao" string="Lãnh đạo" class="fixed-label o_form_label"/>
                            <field name="lanh_dao"
                                   style="flex: 1; border: 1px solid #dcdcdc; padding: 4px; border-radius: 12px;"/>
                        </div>

                        <div style="display: flex; align-items: center;">
                            <label for="user_id" string="Người chủ trì" class="fixed-label o_form_label"/>
                            <field name="user_id"
                                   style="flex: 1; border: 1px solid #dcdcdc; padding: 4px; border-radius: 12px;"/>
                        </div>


                        <div style="display: flex; align-items: center;">
                            <label for="partner_ids" string="Thành phần tham gia" class="fixed-label o_form_label"/>
                            <field name="partner_ids" widget="many2many_tags"
                                   style="flex: 1; border: 1px solid #dcdcdc; padding: 4px; border-radius: 12px;"/>
                        </div>

                        <div style="display: flex; align-items: center;">
                            <label for="location" string="Địa điểm" class="fixed-label o_form_label"/>
                            <field name="location"
                                   style="flex: 1; border: 1px solid #dcdcdc; padding: 4px; border-radius: 12px;"/>
                        </div>

                        <!-- Nội dung cuộc họp -->
                        <div style="display: flex; align-items: center;">
                            <label for="name" string="Nội dung" class="fixed-label o_form_label"/>
                            <field name="name"
                                   style="flex: 1; border: 1px solid #dcdcdc; padding: 4px; border-radius: 12px;"/>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ACTION -->l
        <record id="action_open_calendar_outside_event" model="ir.actions.act_window">
            <field name="name">Lịch công tác</field>
            <field name="res_model">calendar.outside</field>
            <field name="view_mode">tree,form,calendar</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'tree', 'view_id': ref('view_calendar_event_outside_tree')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_calendar_event_outside_form')}),
                (0, 0, {'view_mode': 'calendar', 'view_id': ref('view_calendar_event_outside_calendar')})]"/>
        </record>


    </data>
</odoo>
