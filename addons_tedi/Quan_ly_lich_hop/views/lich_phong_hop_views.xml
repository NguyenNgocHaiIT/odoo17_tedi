<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_calendar_event_room_calendar" model="ir.ui.view">
            <field name="name">calendar.event.room.calendar</field>
            <field name="model">calendar.event</field>
            <field name="arch" type="xml">
                <calendar string="Lịch họp" date_start="start" date_stop="stop" color="color">
                    <field name="name" string="Nội dung"/>
                    <field name="room" string="Phòng"/>
                    <field name="user_id" string="Người chủ trì"/>
                    <field name="partner_ids" widget="many2many_tags" string="Người tham gia"/>
                </calendar>
            </field>
        </record>

        <!-- TREE VIEW -->
        <record id="view_calendar_event_room_tree" model="ir.ui.view">
            <field name="name">calendar.event.room.tree</field>
            <field name="model">calendar.event</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name" string="Chủ đề cuộc họp"/>
                    <field name="room" string="Phòng "/>
                    <field name="start" string="Thời gian bắt đầu"/>
                    <field name="stop" string="Thời gian kết thúc"/>
                    <field name="chu_tri" string="Người chủ trì"/>
                    <field name="employee_ids" string="Thành phần tham gia" widget="many2many_tags"/>
                </tree>
            </field>
        </record>

        <!-- FORM VIEW -->
        <record id="view_calendar_event_room_form" model="ir.ui.view">
            <field name="name">calendar.event.room.form</field>
            <field name="model">calendar.event</field>
            <field name="arch" type="xml">
                <form delete="false" duplicate="false">
                    <header>
                        <button name="approve" string="Duyệt" type="object"
                                groups="base.group_system"/>
                        <button string="Huỷ" class="btn btn-secondary" special="cancel"
                                groups="base.group_system"/>
                        <button name="on_TV" string="Xem lịch trên TV" type="object"
                                groups="base.group_system"/>
                    </header>

                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Chủ đề cuộc họp"/>
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>

                        <group>
                            <!-- Cột bên trái -->
                            <group>
                                <field name="room" string="Phòng"/>
                                <!-- Dòng thời gian -->
                                <label for="start" string="Thời gian" />
                                <div style="display: flex;" >
                                    <field name="start" class="oe_inline" style="flex:1;"/>
                                    <span class="o_form_label" style="padding: 0 4px;">→</span>
                                    <field name="stop" class="oe_inline" style="flex:1;"/>
                                </div>

                                <field name="name" string="Nội dung"/>
                                <field name="room_materials" widget="many2many_tags" string="Thông tin khác"/>
                            </group>

                            <!-- Cột bên phải -->
                            <group>
                                <field name="chu_tri" string="Người chủ trì" />
                                <field name="lanh_dao" string="Lãnh đạo"/>
                                <field name="don_vi" widget="many2many_tags" string="Đơn vị tham gia"/>
                                <field name="employee_ids" widget="many2many_tags" string="Người tham gia"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ACTION -->
        <record id="action_open_calendar_room_event" model="ir.actions.act_window">
            <field name="name">Lịch phòng họp</field>
            <field name="res_model">calendar.event</field>
            <field name="view_mode">tree,form,calendar</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'tree', 'view_id': ref('view_calendar_event_room_tree')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_calendar_event_room_form')}),
                (0, 0, {'view_mode': 'calendar', 'view_id': ref('view_calendar_event_room_calendar')})]"/>
            <field name="domain">[('room','!=',False)]</field>
        </record>

        <record id="view_dashboard_today_form" model="ir.ui.view">
            <field name="name">calendar.dashboard.today.form</field>
            <field name="model">calendar.dashboard</field>
            <field name="arch" type="xml">
                <form string="Dashboard hôm nay">
                    <sheet>
                        <field name="date_today" invisible="1"/>
                        <!-- Lịch công tác -->
                        <group>
                            <field name="event_ids"
                                   context="{'default_date': context_today}"
                                   domain="[('start','&gt;=', date_today), ('start','&lt;', date_today + 1)]">
                                <tree string="Lịch công tác" class="table_tree_view" options="{'no_open': True}">
                                    <field name="date_only" string="Ngày"/>
                                    <field name="name" string="Nội dung công việc"/>
                                    <field name="chu_tri" string="Chủ trì"/>
                                    <field name="employee_ids" widget="many2many_tags" string="Thành phần tham gia"/>
                                    <field name="start_stop" string="Thời gian"/>
                                    <field name="location" string="Địa điểm"/>
                                </tree>
                            </field>
                        </group>

                        <!-- Lịch phòng họp -->
                        <group style="margin-top:20px;">
                            <field name="meeting_room_event_ids"
                                   context="{'default_date': context_today}"
                                   domain="[('start','&gt;=', date_today), ('start','&lt;', date_today + 1), ('room', '!=', False)]">
                                <tree string="Lịch phòng họp" class="table_tree_view" options="{'no_open': True}">
                                    <field name="date_only" string="Ngày"/>
                                    <field name="name" string="Nội dung công việc"/>
                                    <field name="chu_tri" string="Chủ trì"/>
                                    <field name="employee_ids" widget="many2many_tags" string="Thành phần tham gia"/>
                                    <field name="room" string="Phòng"/>
                                    <field name="start_stop" string="Thời gian"/>
                                </tree>
                            </field>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
