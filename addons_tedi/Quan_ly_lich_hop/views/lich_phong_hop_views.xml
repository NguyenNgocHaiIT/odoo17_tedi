<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_calendar_event_room_calendar" model="ir.ui.view">
            <field name="name">calendar.event.room.calendar</field>
            <field name="model">calendar.event</field>
            <field name="arch" type="xml">
                <calendar string="Lịch họp" date_start="start" date_stop="stop" color="color">
                    <field name="name" string="Nội dung"/>
                    <field name="room" string="Phòng"/>
                    <field name="user_id" string="Người chủ trì"/>
                     <field name="don_vi" string="Đơn vị"/>
                </calendar>
            </field>
        </record>

        <record id="view_calendar_event_room_tree" model="ir.ui.view">
            <field name="name">calendar.event.room.tree</field>
            <field name="model">calendar.event</field>
            <field name="arch" type="xml">
                <tree default_order="create_date desc">
                    <field name="name" string="Chủ đề cuộc họp"/>
                    <field name="room" string="Phòng "/>
                    <field name="start" string="Thời gian bắt đầu"/>
                    <field name="stop" string="Thời gian kết thúc"/>
                    <field name="chu_tri" string="Người chủ trì"/>
                    <field name="employee_ids" string="Thành phần tham gia" widget="many2many_tags"/>

                    <field name="room_sign"
                           widget="badge"
                           decoration-info="room_sign == 'no_sign'"
                           decoration-warning="room_sign == 'pending'"
                           decoration-success="room_sign == 'have_sign'"/>
                </tree>
            </field>
        </record>

        <record id="view_calendar_event_room_form" model="ir.ui.view">
            <field name="name">calendar.event.room.form</field>
            <field name="model">calendar.event</field>
            <field name="arch" type="xml">
                <form delete="false" duplicate="false">
                    <field name="can_approve_room" invisible="1"/>
                    <field name="room_sign" invisible="1"/>
                    <field name="state" invisible="1"/>

                    <header>
                        <button name="action_request_room_approval"
                                string="Gửi duyệt"
                                type="object"
                                invisible="not is_current_user_creator or room_sign != 'no_sign'"/>
                        <button name="action_approve_room"
                                string="Duyệt Phòng"
                                type="object"
                                class="btn-success"
                                invisible="not can_approve_room or state != 'approved' or room_sign != 'pending'"/>

                        <button name="action_reject_room"
                                string="Từ chối Phòng"
                                type="object"
                                class="btn-danger"
                                invisible="not can_approve_room or state != 'approved' or room_sign != 'pending'"/>

                        <button name="action_complete"
                                string="Hoàn thành"
                                type="object"
                                class="btn-primary"
                                invisible="not can_complete_meeting"
                                confirm="Xác nhận cuộc họp đã kết thúc và phòng đã được trả?"/>

                        <button name="on_TV" string="Xem lịch trên TV" type="object" />

                        <field name="room_sign" widget="statusbar" statusbar_visible="approved,completed"/>
                        <field name="can_complete_meeting" invisible="1"/>
                    </header>

                    <field name="is_current_user_creator" invisible="1"/>

                    <sheet>
                        <widget name="web_ribbon" title="Đã hoàn thành" bg_color="bg-info" invisible="state != 'completed'"/>
                        <widget name="web_ribbon" title="Đã duyệt phòng" bg_color="bg-success" invisible="room_sign != 'have_sign' or state == 'completed'"/>

                        <div class="oe_title">
                            <label for="name" string="Chủ đề cuộc họp"/>
                            <h1>
                                <field name="name" readonly="not is_current_user_creator or state == 'completed'" required="1"/>
                            </h1>
                        </div>

                        <group>
                            <group>
                                <field name="room" string="Phòng" readonly="state == 'completed'" required="1"/>
                                <label for="start" string="Thời gian" />
                                <div style="display: flex;" >
                                    <field name="start" class="oe_inline" style="flex:1;" readonly="not is_current_user_creator or state == 'completed'" required="1"/>
                                    <span class="o_form_label" style="padding: 0 4px;">→</span>
                                    <field name="stop" class="oe_inline" style="flex:1;" readonly="not is_current_user_creator or state == 'completed'" required="1"/>
                                </div>

                                <field name="name" string="Nội dung" readonly="not is_current_user_creator or state == 'completed'" required="1"/>
                                <field name="loai_cuoc_hop" readonly="not is_current_user_creator or (state not in ('draft','pending'))" required="1" string="Loại cuộc họp"/>
                                <field name="link_cuoc_hop" invisible="loai_cuoc_hop != 'online'"/>
                                <field name="room_materials" widget="many2many_tags" string="Thông tin khác" readonly="not is_current_user_creator or state == 'completed'"/>
                            </group>

                            <group>
                                <field name="chu_tri" string="Người chủ trì" readonly="not is_current_user_creator or state == 'completed'" required="1"/>
                                <field name="lanh_dao" string="Lãnh đạo" readonly="not is_current_user_creator or state == 'completed'" widget="many2many_tags"/>
                                <field name="don_vi" widget="many2many_tags" string="Đơn vị tham gia" readonly="not is_current_user_creator or state == 'completed'"/>
                                <field name="employee_ids" widget="many2many_tags" string="Người tham gia" readonly="1"/>
                                <field name="total_participants" readonly="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_open_calendar_room_event" model="ir.actions.act_window">
            <field name="name">Lịch phòng họp</field>
            <field name="res_model">calendar.event</field>
            <field name="view_mode">tree,form,calendar</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'tree', 'view_id': ref('view_calendar_event_room_tree')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_calendar_event_room_form')}),
                (0, 0, {'view_mode': 'calendar', 'view_id': ref('view_calendar_event_room_calendar')})]"/>
            <field name="domain">[('room','!=',False)]</field>
        </record>

        </data>
</odoo>