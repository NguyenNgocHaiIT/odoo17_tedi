<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Groups như cũ -->
        <record id="group_calendar_department_manager" model="res.groups">
            <field name="name">Quản trị Lịch họp (Chỉ duyệt nội bộ)</field>
            <field name="category_id" ref="base.module_category_human_resources_employees"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_meeting_room_manager" model="res.groups">
            <field name="name">Quản lý phòng họp (Duyệt toàn bộ)</field>
            <field name="category_id" ref="base.module_category_human_resources_employees"/>
            <field name="implied_ids" eval="[(4, ref('group_calendar_department_manager'))]"/>
        </record>

        <!-- CHỈ 1 RULE DUY NHẤT cho group_user -->
        <record id="rule_calendar_event_user" model="ir.rule">
            <field name="name">Calendar Event: User Rules</field>
            <field name="model_id" ref="model_calendar_event"/>
            <!-- ĐÚNG: Dùng CDATA hoặc viết đơn giản -->
            <field name="domain_force">
                [('create_uid', '=', user.id)]
            </field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

    </data>
</odoo>