<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_payroll_quarter_settlement_by_employees" model="ir.ui.view">
        <field name="name">view_hr_payroll_quarter_settlement_by_employees</field>
        <field name="model">hr.settlement.employees</field>
        <field name="arch" type="xml">
            <form string="Payslips by Employees">

                <group>
                    <span colspan="4" nolabel="1">Khi bạn ấn nút "Tạo phiếu lương, hệ thống sẽ tạo phiếu lương cho tất cả những người mà bạn đã chọn trong chu kỳ lương này."
                    </span>
                </group>
                <field name="employee_ids"  widget="many2many_tags"/>
                <footer>
                    <button icon="fa-cogs" string="Tạo phiếu lương" name="compute_sheet" type="object" class="oe_highlight"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
