<odoo>
    <data>
        <record id="view_evaluation_kpi_generate_wizard_form" model="ir.ui.view">
            <field name="name">evaluation.kpi.generate.wizard.form</field>
            <field name="model">evaluation.kpi.generate.wizard</field>
            <field name="arch" type="xml">
                <form string="Tạo phiếu KPI">
                    <sheet>
                        <group>
                            <group>
                                <field name="report_id" invisible="1"/>
                                <field name="department_id"/>
                                <field name="selection_mode" widget="radio" options="{'horizontal': true}"/>
                            </group>
                        </group>

                        <div invisible="selection_mode == 'all'" class="alert alert-info" role="alert" style="margin-bottom: 10px;">
                            <i class="fa fa-info-circle"/> Vui lòng tích vào ô <b>"Chọn"</b> tương ứng với nhân viên bạn muốn tạo phiếu.
                        </div>

                        <field name="line_ids"
                               invisible="selection_mode == 'all'"
                               nolabel="1">

                            <tree editable="top" create="0" delete="0"
                                  decoration-muted="not is_selected"
                                  decoration-info="is_selected"
                                  decoration-bf="is_selected">

                                <field name="is_selected" string="Chọn" width="50px"/>

                                <field name="employee_id" widget="many2one_avatar_user" readonly="1" force_save="1"/>

                                <field name="job_id"/>
                            </tree>
                        </field>

                    </sheet>
                    <footer>
                        <button name="action_confirm_generate"
                                string="Tạo phiếu"
                                type="object"
                                class="btn-primary"/>
                        <button string="Hủy" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>