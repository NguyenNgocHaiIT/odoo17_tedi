<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record model="ir.module.category" id="module_category_evaluation_kpi_new">
            <field name="name">Đánh giá KPI</field>
            <field name="description">Phân quyền quản lý quy trình KPI</field>
            <field name="sequence">21</field>
        </record>

        <record id="group_kpi_dept_manager_new" model="res.groups">
            <field name="name">Trưởng đơn vị</field>
            <field name="category_id" ref="module_category_evaluation_kpi_new"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_kpi_director_new" model="res.groups">
            <field name="name">Ban Giám Đốc (TGĐ)</field>
            <field name="category_id" ref="module_category_evaluation_kpi_new"/>
            <field name="implied_ids" eval="[(4, ref('group_kpi_dept_manager_new'))]"/>
        </record>

        <record id="group_kpi_admin_new" model="res.groups">
            <field name="name">Admin (Quản trị hệ thống)</field>
            <field name="category_id" ref="module_category_evaluation_kpi_new"/>
            <field name="implied_ids" eval="[(4, ref('group_kpi_director_new'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

    </data>

    <data noupdate="0">
        <record id="rule_evaluation_kpi_user_personal" model="ir.rule">
            <field name="name">KPI: Cá nhân tự xem</field>
            <field name="model_id" ref="model_evaluation_kpi"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_evaluation_kpi_dept_manager_same_dept" model="ir.rule">
            <field name="name">KPI: Trưởng đơn vị xem phiếu cùng phòng ban</field>
            <field name="model_id" ref="model_evaluation_kpi"/>

            <field name="domain_force">[
                ('department_id', '=', user.employee_id.department_id.id),
                ('department_id', '!=', False)
            ]</field>

            <field name="groups" eval="[(4, ref('group_kpi_dept_manager_new'))]"/>
        </record>

        <record id="rule_evaluation_kpi_all_access_new" model="ir.rule">
            <field name="name">KPI: Toàn quyền xem (Giám đốc, Admin)</field>
            <field name="model_id" ref="model_evaluation_kpi"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_kpi_director_new'))]"/>
        </record>
    </data>
</odoo>