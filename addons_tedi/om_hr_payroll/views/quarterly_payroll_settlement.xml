<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_quarterly_payroll_settlement_tree" model="ir.ui.view">
            <field name="name">view_quarterly_payroll_settlement_tree</field>
            <field name="model">quarterly.payroll.settlement</field>
            <field name="arch" type="xml">
                <tree decoration-info="state in ('approve')">
                    <field name="name"/>
                    <field name="quarter"/>
                    <field name="year"/>
                    <field name="quarterly_payroll_fund"/>
                    <field name="currency_id" column_invisible="1"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record id="view_quarterly_payroll_settlement_form" model="ir.ui.view">
            <field name="name">view_quarterly_payroll_settlement_form</field>
            <field name="model">quarterly.payroll.settlement</field>
            <field name="arch" type="xml">
                <form string="">
                    <header>
                        <button name="action_add_employee"
                                string="Thêm nhân sự"
                                type="object"
                                 icon="fa-plus" invisible="state == 'approve'" groups="om_hr_payroll.group_hr_payroll_user,om_hr_payroll.group_hr_payroll_manager"/>
                        <button name="action_compute_lines"
                                string="Xử lý dữ liệu"
                                type="object"
                                 icon="fa-asterisk" invisible="state == 'approve'" groups="om_hr_payroll.group_hr_payroll_user,om_hr_payroll.group_hr_payroll_manager"/>
                        <button name="action_approve"
                                string="Duyệt phiếu"
                                type="object"
                                icon="fa-check text-success" invisible="state == 'approve'" groups="om_hr_payroll.group_hr_payroll_user,om_hr_payroll.group_hr_payroll_manager"/>
                        <button name="action_draft"
                                string="Mở lại phiếu"
                                type="object"
                                icon="fa-exclamation text-warning" invisible="state == 'draft'" groups="om_hr_payroll.group_hr_payroll_user,om_hr_payroll.group_hr_payroll_manager"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
<!--                        <div class="oe_button_box" name="button_box">-->
<!--                            <button name="%(act_payslip_lines)d"-->
<!--                                    class="oe_stat_button"-->
<!--                                    icon="fa-money"-->
<!--                                    type="action">-->
<!--                                <field name="payslip_count" widget="statinfo" string="Payslip"-->
<!--                                       help="Payslip Computation Details"/>-->
<!--                            </button>-->
<!--                        </div>-->
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1>
                                <field name="name" placeholder="Mô tả" readonly="state != 'draft'"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                            <field name="quarter" readonly="state != 'draft'"/>
                            <field name="year" readonly="state != 'draft'"/>
                            <field name="quarterly_payroll_fund" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>

                        <group/>
                        </group>
                        <field name="line_ids" readonly="state != 'draft'">
                            <tree editable="bottom" class="excel_style_list_view">
                                <field name="employee_id" readonly="1"/>
                                <field name="lv_tt"/>
                                <field name="le_tet"/>
                                <field name="phep"/>
                                <field name="tong_cong"/>
                                <field name="hs_lcd_pc"/>
                                <field name="lv_tt_quy"/>
                                <field name="che_do_quy"/>
                                <field name="tns_quy"/>
                                <field name="kpi"/>
                                <field name="thuong"/>
                                <field name="cong_1"/>
                                <field name="tns_nhan"/>
                                <field name="lcd_tns_quy"/>
                                <field name="nlv_tt_nhan"/>
                                <field name="lcd_nhan"/>
                                <field name="tam_ung_tns"/>
                                <field name="cong_2"/>
                                <field name="tns_con_nhan"/>
                                <field name="kt_thue_ky_truoc"/>
                                <field name="kt_thue_ky_nay"/>
                                <field name="nld_con_nhan"/>
                            </tree>
                        </field>
                    </sheet>
<!--                    <div class="oe_chatter">-->
<!--                        <field name="message_follower_ids" groups="base.group_user"/>-->
<!--                        <field name="activity_ids"/>-->
<!--                        <field name="message_ids"/>-->
<!--                    </div>-->
                </form>
            </field>
        </record>

        <record id="act_quarterly_payroll_settlement" model="ir.actions.act_window">
            <field name="name">Quyết toán lương quý</field>
            <field name="res_model">quarterly.payroll.settlement</field>
<!--            <field name="domain">[('register_id', '=', active_id)]</field>-->
<!--            <field name="context">{'default_register_id': active_id, 'search_default_register_id': 1}</field>-->
        </record>

        <record id="view_employee_tax_tree" model="ir.ui.view">
            <field name="name">view_employee_tax_tree</field>
            <field name="model">employee.tax</field>
            <field name="arch" type="xml">
                <tree editable="bottom">
                    <field name="employee_id" readonly="deducted"/>
                    <field name="month" readonly="deducted"/>
                    <field name="year" readonly="deducted"/>
                    <field name="nguoi_pt" readonly="deducted"/>
                    <field name="tl_truoc_thue" readonly="deducted"/>
                    <field name="giam_tru_ban_than" readonly="deducted"/>
                    <field name="giam_tru_gia_canh" readonly="deducted"/>
                    <field name="thu_nhap_tinh_thue" readonly="deducted"/>
                    <field name="thue_tncn" readonly="deducted"/>
                    <field name="currency_id" column_invisible="1"/>
                    <field name="deducted" column_invisible="1"/>
                    <field name="quarterly_settlement_id" readonly="1" optional="hide"/>
                </tree>
            </field>
        </record>

        <record id="act_employee_tax" model="ir.actions.act_window">
            <field name="name">Thuế TNCN theo nhân viên</field>
            <field name="res_model">employee.tax</field>
<!--            <field name="domain">[('register_id', '=', active_id)]</field>-->
<!--            <field name="context">{'default_register_id': active_id, 'search_default_register_id': 1}</field>-->
        </record>

        <menuitem id="menu_quarterly_payroll_settlement_and_tax" name="Quyết toán quý"
                  parent="menu_hr_payroll_root"/>

        <menuitem id="menu_quarterly_payroll_settlement" name="Quyết toán lương quý"
                  action="act_quarterly_payroll_settlement"
                  parent="menu_quarterly_payroll_settlement_and_tax"/>

        <menuitem id="menu_employee_tax" name="Thuế TNCN theo nhân viên"
                  action="act_employee_tax"
                  parent="menu_quarterly_payroll_settlement_and_tax"/>
    </data>
</odoo>
