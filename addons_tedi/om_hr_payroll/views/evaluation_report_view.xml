<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_evaluation_report_tree" model="ir.ui.view">
            <field name="name">evaluation.report.tree</field>
            <field name="model">evaluation.report</field>
            <field name="arch" type="xml">
                <tree string="Danh sách báo cáo">
                    <field name="name"/>
                    <field name="department_id"/>
                    <field name="year" string="Năm"/>
                    <field name="quarter" string="Quý"/>
                    <field name="create_date" widget="date"/>
                    <field name="state" widget="badge"
                           decoration-info="state == 'draft'"
                           decoration-warning="state == 'to_approve'"
                           decoration-success="state == 'done'"
                           decoration-muted="state == 'cancel'"/>
                </tree>
            </field>
        </record>

        <record id="view_evaluation_report_form" model="ir.ui.view">
            <field name="name">evaluation.report.form</field>
            <field name="model">evaluation.report</field>
            <field name="arch" type="xml">
                <form string="Báo cáo tổng hợp">
                    <header>
                        <button name="action_submit_for_approval"
                                string="Trình duyệt"
                                type="object"
                                class="btn-primary"
                                invisible="state != 'draft'"/>

                        <button name="action_approve_report"
                                string="Duyệt báo cáo"
                                type="object"
                                class="btn-success"
                                groups="om_hr_payroll.group_kpi_director_new"
                                invisible="state != 'to_approve'"/>

                        <button name="action_refuse_report"
                                string="Từ chối"
                                type="object"
                                class="btn-danger"
                                groups="om_hr_payroll.group_kpi_director_new"
                                invisible="state != 'to_approve'"/>

                        <button name="action_cancel" string="Hủy" type="object" invisible="state in ['cancel','done']"/>
                        <button name="action_reset_draft" string="Về nháp" type="object" invisible="state != 'cancel'"/>

                        <field name="state" widget="statusbar" statusbar_visible="draft,to_approve,done"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1><field name="name" placeholder="Ví dụ: Tổng hợp KPI Quý 1/2026" readonly="state != 'draft'"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="department_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                                <field name="period" readonly="1"/>
                            </group>
                            <group>
                                <field name="year" readonly="state != 'draft'"/>
                                <field name="quarter" readonly="state != 'draft'"/>
                                <field name="create_date" readonly="1"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Danh sách phiếu KPI" name="kpi_details">
                                <field name="evaluate_kpi_ids" readonly="1">
                                    <tree string="Chi tiết phiếu"
                                          decoration-success="state == 'done'"
                                          decoration-warning="state != 'done'"
                                          decoration-info="state == 'draft'">
                                        <field name="name"/>
                                        <field name="employee_id"/>
                                        <field name="job_id"/>
                                        <field name="total_score" avg="Điểm trung bình"/>
                                        <field name="final_result" widget="badge"/>
                                        <field name="state" widget="badge"/>
                                        <button name="action_open_kpi_detail" type="object" icon="fa-external-link" title="Xem chi tiết phiếu"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="action_evaluation_report" model="ir.actions.act_window">
            <field name="name">Báo cáo tổng hợp KPI</field>
            <field name="res_model">evaluation.report</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Tạo báo cáo tổng hợp mới
                </p>
                <p>
                    Hệ thống sẽ tự động gom các phiếu KPI của phòng ban khi bạn lưu báo cáo.
                </p>
            </field>
        </record>

        <menuitem id="menu_evaluation_report"
                  name="Tổng hợp KPI"
                  parent="om_hr_payroll.menu_evaluation_kpi_root"
                  action="action_evaluation_report"
                  groups="om_hr_payroll.group_kpi_dept_manager_new"
                  sequence="5"/>

    </data>
</odoo>