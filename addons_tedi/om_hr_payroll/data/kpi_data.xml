<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="kpi_class_a" model="evaluation.kpi.classification">
            <field name="classification">Xuất sắc (A)</field>
            <field name="min_score">4.50</field>
            <field name="max_score">5.00</field>
            <field name="k_coefficient">1.20</field>
            <field name="description">Hoàn thành vượt mức kế hoạch, chất lượng cao.</field>
        </record>

        <record id="kpi_class_b" model="evaluation.kpi.classification">
            <field name="classification">Tốt (B)</field>
            <field name="min_score">3.80</field>
            <field name="max_score">4.49</field>
            <field name="k_coefficient">1.00</field>
            <field name="description">Hoàn thành tốt các nhiệm vụ được giao.</field>
        </record>

        <record id="kpi_class_c" model="evaluation.kpi.classification">
            <field name="classification">Khá (C)</field>
            <field name="min_score">3.00</field>
            <field name="max_score">3.79</field>
            <field name="k_coefficient">0.80</field>
            <field name="description">Hoàn thành nhiệm vụ ở mức đạt yêu cầu.</field>
        </record>

        <record id="kpi_class_d" model="evaluation.kpi.classification">
            <field name="classification">Trung bình (D)</field>
            <field name="min_score">2.00</field>
            <field name="max_score">2.99</field>
            <field name="k_coefficient">0.50</field>
            <field name="description">Một số nhiệm vụ chưa đạt, cần cải thiện.</field>
        </record>

        <record id="kpi_class_e" model="evaluation.kpi.classification">
            <field name="classification">Kém (E)</field>
            <field name="min_score">0.00</field>
            <field name="max_score">1.99</field>
            <field name="k_coefficient">0.00</field>
            <field name="description">Không hoàn thành nhiệm vụ.</field>
        </record>

    </data>
</odoo>