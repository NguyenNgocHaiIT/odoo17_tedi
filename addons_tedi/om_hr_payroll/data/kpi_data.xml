<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_evaluation_kpi" model="ir.sequence">
            <field name="name">Mã phiếu đánh giá KPI</field>
            <field name="code">evaluation.kpi</field>
            <field name="prefix"></field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>


        <record id="kpi_class_not_completed" model="evaluation.kpi.classification">
            <field name="classification">Không hoàn thành/ Không đạt yêu cầu</field>
            <field name="min_score">0.00</field>
            <field name="max_score">1.49</field>
            <field name="k_coefficient_min">0.00</field>
            <field name="k_coefficient_max">0.49</field>
            <field name="description">Kết quả dưới mức yêu cầu tối thiểu.</field>
        </record>

        <record id="kpi_class_need_effort" model="evaluation.kpi.classification">
            <field name="classification">Cần cố gắng/ Gần đạt yêu cầu</field>
            <field name="min_score">1.50</field>
            <field name="max_score">2.49</field>
            <field name="k_coefficient_min">0.50</field>
            <field name="k_coefficient_max">0.99</field>
            <field name="description">Cần nỗ lực nhiều hơn để đạt chỉ tiêu.</field>
        </record>

        <record id="kpi_class_completed" model="evaluation.kpi.classification">
            <field name="classification">Hoàn thành/ Đạt yêu cầu</field>
            <field name="min_score">2.50</field>
            <field name="max_score">3.50</field>
            <field name="k_coefficient_min">1.00</field>
            <field name="k_coefficient_max">1.29</field>
            <field name="description">Đạt các yêu cầu cơ bản của công việc.</field>
        </record>

        <record id="kpi_class_good" model="evaluation.kpi.classification">
            <field name="classification">Hoàn thành tốt/ Vượt yêu cầu</field>
            <field name="min_score">3.51</field>
            <field name="max_score">4.50</field>
            <field name="k_coefficient_min">1.30</field>
            <field name="k_coefficient_max">1.59</field>
            <field name="description">Chất lượng công việc tốt, vượt mong đợi.</field>
        </record>

        <record id="kpi_class_excellent" model="evaluation.kpi.classification">
            <field name="classification">Hoàn thành xuất sắc/ Vượt xa yêu cầu</field>
            <field name="min_score">4.51</field>
            <field name="max_score">5.00</field>
            <field name="k_coefficient_min">1.60</field>
            <field name="k_coefficient_max">1.80</field>
            <field name="description">Kết quả ấn tượng, vượt xa mọi chỉ tiêu.</field>
        </record>

    </data>
</odoo>