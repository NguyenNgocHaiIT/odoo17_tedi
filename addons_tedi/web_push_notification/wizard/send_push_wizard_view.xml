<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_send_push_wizard_form" model="ir.ui.view">
    <field name="name">send.push.wizard.form</field>
    <field name="model">send.push.wizard</field>
    <field name="arch" type="xml">
        <form string="Gửi thông báo">
            <sheet>
                <group>
                    <field name="template_id" options="{'no_create': True}"/>
                    <field name="title"/>
                    <field name="body"/>
                </group>
                <group string="Cấu hình gửi">
                    <field name="send_all"/>
                    <field name="user_ids"
                           widget="many2many_tags"
                           invisible="send_all == True"
                           required="send_all == False"/>
                </group>
            </sheet>
            <footer>
                <button name="action_send" string="Gửi ngay" type="object" class="btn-primary"/>
                <button string="Hủy" class="btn-secondary" special="cancel"/>
            </footer>
        </form>
    </field>
</record>

    <record id="action_view_send_push_wizard" model="ir.actions.act_window">
        <field name="name">Gửi thông báo Push</field>
        <field name="res_model">send.push.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>