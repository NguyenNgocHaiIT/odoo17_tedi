<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_event_event_tree" model="ir.ui.view">
        <field name="name">event.event.tree</field>
        <field name="model">event.event</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" string="Tên sự kiện"/>
                <field name="date_begin" string="Thời gian bắt đầu"/>
                <field name="date_end" string="Thời gian kết thúc"/>
                <field name="state" string="Trạng thái"/>
            </tree>
        </field>
    </record>

    <record id="view_event_event_form" model="ir.ui.view">
        <field name="name">event.event.form</field>
        <field name="model">event.event</field>
        <field name="arch" type="xml">
            <form delete="false" duplicate="false">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Tên sự kiện"/>
                        <h1>
                            <field name="name" required="1"/>
                        </h1>
                    </div>
                    <group>
                        <field name="date_begin" string="Thời gian bắt đầu"/>
                        <field name="date_end" string="Thời gian kết thúc"/>
                        <field name="link" string="Link chi tiết"/>
                        <field name="state" string="Trạng thái"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_open_event_event" model="ir.actions.act_window">
        <field name="name">Sự kiện</field>
        <field name="res_model">event.event</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_event_event_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_event_event_form')})]"/>
    </record>


</odoo>