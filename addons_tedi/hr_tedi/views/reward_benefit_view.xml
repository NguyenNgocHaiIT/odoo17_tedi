<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_hr_reward_benefit_tree" model="ir.ui.view">
            <field name="name">hr.reward.benefit.tree</field>
            <field name="model">hr.reward.benefit</field>
            <field name="arch" type="xml">
                <tree string="Danh mục Quyền lợi" editable="bottom">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="value" sum="Tổng giá trị"/> <field name="description"/>
                </tree>
            </field>
        </record>

        <record id="view_hr_reward_benefit_form" model="ir.ui.view">
            <field name="name">hr.reward.benefit.form</field>
            <field name="model">hr.reward.benefit</field>
            <field name="arch" type="xml">
                <form string="Chi tiết Quyền lợi">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1>
                                <field name="name" placeholder="Ví dụ: Tiền thưởng nóng, Bằng khen..."/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="value"/>
                            </group>
                            <group>
                                </group>
                        </group>
                        <notebook>
                            <page string="Mô tả">
                                <field name="description" placeholder="Ghi chú chi tiết về quyền lợi này..."/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_hr_reward_benefit_search" model="ir.ui.view">
            <field name="name">hr.reward.benefit.search</field>
            <field name="model">hr.reward.benefit</field>
            <field name="arch" type="xml">
                <search string="Tìm kiếm Quyền lợi">
                    <field name="name"/>
                    <field name="code"/>
                    <separator/>
                    <filter string="Có giá trị tiền" name="has_value" domain="[('value', '>', 0)]"/>
                </search>
            </field>
        </record>

        <record id="action_hr_reward_benefit" model="ir.actions.act_window">
            <field name="name">Danh mục Quyền lợi</field>
            <field name="res_model">hr.reward.benefit</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Tạo mới một quyền lợi hoặc hình thức khen thưởng/kỷ luật
              </p>
            </field>
        </record>

        <menuitem id="menu_hr_reward_benefit"
                  name="Danh mục Quyền lợi"
                  parent="hr.menu_human_resources_configuration"
                  action="action_hr_reward_benefit"
                  sequence="2"/>

    </data>
</odoo>