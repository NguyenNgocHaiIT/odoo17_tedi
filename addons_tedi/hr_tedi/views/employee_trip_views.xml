<odoo>
    <record id="view_employee_trip_tree" model="ir.ui.view">
        <field name="name">hr.employee.trip.tree</field>
        <field name="model">hr.employee.trip</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="purpose"/>
                <field name="country_id"/>
                <field name="cost"/>
                <field name="attachment_ids" widget="many2many_binary" string="Đính kèm"/>
            </tree>
        </field>
    </record>

    <record id="view_employee_trip_form" model="ir.ui.view">
        <field name="name">hr.employee.trip.form</field>
        <field name="model">hr.employee.trip</field>
        <field name="arch" type="xml">
            <form string="Xuất - nhập cảnh">
                <group>
                    <field name="employee_id" readonly="1"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="purpose"/>
                    <field name="country_id"/>
                    <field name="cost"/>
                    <field name="attachment_ids" widget="many2many_binary"/>
                </group>
            </form>
        </field>
    </record>
</odoo>
