<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- TREE VIEW CUSTOM -->
        <record id="view_employee_tree_tedi" model="ir.ui.view">
            <field name="name">hr.employee.tree.tedi</field>
            <field name="model">hr.employee</field>
            <field name="arch" type="xml">
                <tree string="Danh sách nhân viên">
                    <field name="employee_code"/>
                    <field name="name"/>
                    <field name="department_id"/>
                    <field name="job_id"/>
                    <field name="mobile_phone"/>
                    <field name="work_email"/>
                </tree>
            </field>
        </record>

        <!-- FORM OVERRIDE -->
       <record id="hr_employee_view_form_inherit_profile_tedi" model="ir.ui.view">
            <field name="name">hr.employee.view.form.inherit.profile.tedi</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="priority" eval="50000"/>

            <field name="arch" type="xml">

                <xpath expr="//div[hasclass('row', 'justify-content-between', 'position-relative')]" position="replace">
                    <div class="d-flex w-100 mb-3">

                        <div class="me-4">
                            <style>
                                .my_custom_avatar img {
                                    width: 180px !important;
                                    height: 180px !important;
                                    object-fit: cover !important;
                                    border-radius: 10px !important;
                                }
                                .my_custom_avatar {
                                    width: 180px !important;
                                    height: 180px !important;
                                    border: 1px solid #e2e2e2;
                                    border-radius: 10px;
                                }
                            </style>

                            <field name="image_1920" widget="image" class="oe_avatar my_custom_avatar m-0"
                                   options="{'zoom': true, 'preview_image':'image_512'}"/>
                        </div>

                        <div class="flex-grow-1 d-flex flex-column justify-content-center">

                            <div class="oe_title">
                                <h1 class="d-flex flex-row align-items-center mb-1">
                                    <field name="name" placeholder="Họ và tên" required="True"
                                           style="font-size: 2.5rem; font-weight: 500;"/>
                                </h1>
                            </div>

                            <h3 class="text-muted mb-3" style="font-weight: normal;">
                                <field name="employee_code" placeholder="Mã nhân viên" nolabel="1" readonly="1"/>
                                <field name="work_email" nolabel="1" />
                                <field name="work_email" nolabel="1"/>
                            </h3>

                            <div class="d-flex flex-column gap-1" style="font-size: 1.1rem; color: #444;">

                                <div class="d-flex align-items-center" invisible="not work_email">
                                    <span class="fa fa-envelope me-3 text-muted" style="width: 20px; text-align: center;"></span>
                                    <field name="work_email" nolabel="1" class="mb-0"/>
                                </div>

                                <div class="d-flex align-items-center" invisible="not work_phone">
                                    <span class="fa fa-phone me-3 text-muted" style="width: 20px; text-align: center;"></span>
                                    <field name="work_phone" nolabel="1" class="mb-0"/>
                                </div>

                                <div class="d-flex align-items-center" invisible="not mobile_phone">
                                    <span class="fa fa-mobile me-3 text-muted" style="width: 20px; text-align: center; font-size: 1.4rem;"></span>
                                    <field name="mobile_phone" nolabel="1" class="mb-0"/>
                                </div>

                                <div class="d-flex align-items-center mt-1">
                                    <span class="fa fa-tag me-3 text-muted" style="width: 20px; text-align: center;"></span>
                                    <field name="job_title" placeholder="Chức vụ" class="me-2 fw-bold"/>
                                    <span class="text-muted me-1" invisible="not category_ids">|</span>
                                    <field name="category_ids" widget="many2many_tags"
                                           options="{'color_field': 'color', 'no_create_edit': True}"
                                           placeholder="Tags"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </xpath>

                <xpath expr="//field[@name='mobile_phone']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='work_phone']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='work_email']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='job_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='category_ids']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='department_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='coach_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='parent_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <xpath expr="//form" position="inside">
                    <field name="child_ids" invisible="1"/>
                    <field name="work_contact_id" invisible="1"/>
                    <field name="last_activity" invisible="1"/>
                </xpath>

                <xpath expr="//notebook" position="replace">
                    <notebook>
                        <page string="Sơ yếu lý lịch" name="profile_vn">
                            <group col="2">
                                <group string="Thông tin cá nhân">
                                    <field name="birthday" string="Sinh ngày"/>
                                    <field name="country_id" string="Quốc tịch"/>
                                    <field name="ethnicity"/>
                                    <field name="occupation"/>
                                    <field name="household_address"/>
                                </group>

                                <group string="Thông tin định danh">
                                    <field name="citizen_id" string="Số CMND/CCCD"/>
                                    <field name="citizen_issue_date"/>
                                    <field name="citizen_issuer"/>
                                    <field name="phone_personal"/>
                                    <field name="bank_account" string="Tài khoản số"/>
                                    <field name="bank_name"/>
                                    <field name="email_personal" string="Email cá nhân"/>
                                </group>
                            </group>

                            <separator string="TRÌNH ĐỘ CHUYÊN MÔN"/>
                            <field name="education_ids" nolabel="1" colspan="2" context="{'default_employee_id': active_id}">
                                <tree editable="bottom">
                                    <field name="stt" readonly="1"/>
                                    <field name="school"/>
                                    <field name="major"/>
                                    <field name="years"/>
                                    <field name="degree"/>
                                    <field name="issue_date"/>
                                    <field name="attachment_ids" widget="many2many_binary"/>
                                </tree>
                            </field>

                            <separator string="CHỨNG CHỈ HÀNH NGHỀ"/>
                            <field name="certificate_ids" nolabel="1" colspan="2" context="{'default_employee_id': active_id}">
                                <tree editable="bottom">
                                    <field name="stt" readonly="1"/>
                                    <field name="cert_type"/>
                                    <field name="code"/>
                                    <field name="issuer"/>
                                    <field name="practice_field"/>
                                    <field name="rank"/>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="attachment_ids" widget="many2many_binary"/>
                                </tree>
                            </field>

                            <separator string="XUẤT - NHẬP CẢNH"/>
                            <field name="trip_ids" nolabel="1" colspan="2" context="{'default_employee_id': active_id}">
                                <tree editable="bottom">
                                    <field name="stt" readonly="1"/>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="purpose"/>
                                    <field name="country_id"/>
                                    <field name="cost"/>
                                    <field name="attachment_ids" widget="many2many_binary"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Quá trình công tác" name="work_process">
                            <separator string="QUÁ TRÌNH CÔNG TÁC TẠI TEDI"/>
                            <field name="work_process_tedi_ids" nolabel="1" colspan="2">
                                <tree editable="bottom">
                                    <field name="decision_no"/>
                                    <field name="decision_date"/>
                                    <field name="content"/>
                                    <field name="department_from_id"/>
                                    <field name="department_to_id"/>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                </tree>
                            </field>

                            <separator string="QUÁ TRÌNH CÔNG TÁC TẠI ĐƠN VỊ CŨ"/>
                            <field name="work_process_old_ids" nolabel="1" colspan="2">
                                <tree editable="bottom">
                                    <field name="stt" readonly="1"/>
                                    <field name="company_name"/>
                                    <field name="work_address"/>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="position"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Kinh nghiệm công việc" name="exp_vn">
                            <separator string="KINH NGHIỆM CÔNG VIỆC LIÊN QUAN"/>
                            <field name="experience_ids" nolabel="1" colspan="2">
                                <tree editable="bottom">
                                    <field name="project_name"/>
                                    <field name="project_type"/>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="position"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'completed'"
                                           decoration-info="status == 'in_progress'"
                                           decoration-warning="status == 'pending'"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Khen thưởng - Kỷ luật" name="reward_vn">
                            <separator string="KHEN THƯỞNG - KỶ LUẬT"/>
                            <field name="reward_discipline_ids" nolabel="1" colspan="2">
                                <tree editable="bottom">
                                    <field name="decision_id"/>
                                    <field name="decision_no"/>
                                    <field name="decision_date"/>
                                    <field name="decision_level"/>
                                    <field name="content"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Đảng - Đoàn thể" name="union_vn">
                            <group>
                                <group string="THÔNG TIN ĐẢNG VIÊN">
                                    <field name="party_member"/>
                                    <field name="party_join_date" invisible="not party_member"/>
                                    <field name="party_official_date" invisible="not party_member"/>
                                    <field name="party_title_id" invisible="not party_member"/>
                                    <field name="party_cell_id" invisible="not party_member"/>
                                    <field name="party_profile_no" invisible="not party_member"/>
                                    <field name="party_card_no" invisible="not party_member"/>
                                    <field name="party_medal_no" invisible="not party_member"/>
                                </group>

                                <group>
                                    <group string="THÔNG TIN CÔNG ĐOÀN" colspan="2" col="2">
                                        <field name="union_member"/>
                                        <field name="union_join_date" invisible="not union_member"/>
                                        <field name="union_profile_no" invisible="not union_member"/>
                                        <field name="union_card_no" invisible="not union_member"/>
                                    </group>

                                    <group string="THÔNG TIN ĐOÀN THANH NIÊN" colspan="2" col="2">
                                        <field name="youth_member"/>
                                        <field name="youth_join_date" invisible="not youth_member"/>
                                        <field name="youth_card_no" invisible="not youth_member"/>
                                    </group>
                                </group>
                            </group>
                        </page>

                        <page string="Quá trình đào tạo" name="training_vn">
                            <separator string="QUÁ TRÌNH ĐÀO TẠO"/>
                            <field name="training_ids" nolabel="1" colspan="2">
                                <tree editable="bottom">
                                    <field name="stt" readonly="1"/>
                                    <field name="name"/>
                                    <field name="training_type"/>
                                    <field name="facility"/>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="training_form"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'completed'"
                                           decoration-info="status == 'in_progress'"
                                           decoration-danger="status == 'canceled'"/>
                                </tree>
                            </field>
                        </page>

                    </notebook>
                </xpath>

            </field>
        </record>

        <!-- ACTION -->
        <record id="hr.open_view_employee_list_my" model="ir.actions.act_window">
            <field name="name">Employees</field>
            <field name="res_model">hr.employee</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'tree', 'view_id': ref('view_employee_tree_tedi')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('hr_employee_view_form_inherit_profile_tedi')})
            ]"/>
        </record>

    </data>
</odoo>
