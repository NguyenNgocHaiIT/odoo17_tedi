<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="view_country_state_tree_vn_custom" model="ir.ui.view">
            <field name="name">res.country.state.tree.vn.custom</field>
            <field name="model">res.country.state</field>
            <field name="priority">50</field>
            <field name="arch" type="xml">
                <tree string="Tỉnh/Thành phố">
                    <field name="name" string="Tên Tỉnh/TP"/>
                    <field name="code" string="Mã Tỉnh"/>
                    <field name="ward_ids" string="Số lượng Xã/Phường" optional="show" widget="many2many_tags_avatar"/>
                </tree>
            </field>
        </record>

        <record id="view_country_state_form_vn_custom" model="ir.ui.view">
            <field name="name">res.country.state.form.vn.custom</field>
            <field name="model">res.country.state</field>
            <field name="priority">50</field>
            <field name="arch" type="xml">
                <form string="Tỉnh/Thành phố">
                    <sheet>
                        <group>
                            <group>
                                <field name="name" string="Tên Tỉnh/Thành phố"/>
                                <field name="code" string="Mã (VD: HN, SG)"/>
                            </group>
                            <group>
                                <field name="country_id" readonly="1" options="{'no_open': True}"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Danh sách Xã/Phường trực thuộc">
                                <field name="ward_ids">
                                    <tree editable="bottom" default_order="name">
                                        <field name="name" string="Tên Xã/Phường"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_res_country_state_vietnam" model="ir.actions.act_window">
            <field name="name">Tỉnh/Thành phố (Việt Nam)</field>
            <field name="res_model">res.country.state</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('country_id.code', '=', 'VN')]</field>
            <field name="context" eval="{'default_country_id': ref('base.vn')}"/>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'tree', 'view_id': ref('view_country_state_tree_vn_custom')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_country_state_form_vn_custom')})]"/>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Chưa có dữ liệu Tỉnh/Thành phố.
              </p>
            </field>
        </record>

        <menuitem
            id="menu_res_country_state"
            name="Tỉnh/Thành phố"
            action="action_res_country_state_vietnam"
            parent="hr.menu_human_resources_configuration"
            sequence="2"
            groups="hr.group_hr_user"/>

    </data>
</odoo>