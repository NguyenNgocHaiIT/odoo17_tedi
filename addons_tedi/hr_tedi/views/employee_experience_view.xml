<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_hr_experience_project_type_tree" model="ir.ui.view">
            <field name="name">hr.experience.project.type.tree</field>
            <field name="model">hr.experience.project.type</field>
            <field name="arch" type="xml">
                <tree string="Loại dự án" editable="bottom">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="description"/>
                    <field name="active" widget="boolean_toggle"/>
                </tree>
            </field>
        </record>

        <record id="view_hr_experience_project_type_form" model="ir.ui.view">
            <field name="name">hr.experience.project.type.form</field>
            <field name="model">hr.experience.project.type</field>
            <field name="arch" type="xml">
                <form string="Loại dự án">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1>
                                <field name="name" placeholder="Ví dụ: Dự án Outsourcing..."/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                            <group>
                                <field name="description"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_hr_experience_project_type_search" model="ir.ui.view">
            <field name="name">hr.experience.project.type.search</field>
            <field name="model">hr.experience.project.type</field>
            <field name="arch" type="xml">
                <search string="Tìm kiếm">
                    <field name="name"/>
                    <field name="code"/>
                    <filter string="Đang dùng" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Đã lưu trữ" name="archived" domain="[('active', '=', False)]"/>
                </search>
            </field>
        </record>

        <record id="action_hr_experience_project_type" model="ir.actions.act_window">
            <field name="name">Loại dự án</field>
            <field name="res_model">hr.experience.project.type</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Tạo mới một loại dự án kinh nghiệm
              </p>
            </field>
        </record>

        <menuitem
            id="menu_hr_experience_project_type"
            name="Loại dự án"
            parent="hr.menu_human_resources_configuration"
            action="action_hr_experience_project_type"
            sequence="3"/>
            </data>
</odoo>