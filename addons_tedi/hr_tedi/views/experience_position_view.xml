<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_hr_experience_position_tree" model="ir.ui.view">
            <field name="name">hr.experience.position.tree</field>
            <field name="model">hr.experience.position</field>
            <field name="arch" type="xml">
                <tree string="Chức danh kinh nghiệm" editable="bottom">
                    <field name="name"/>
                    <field name="description"/>
                    <field name="active" widget="boolean_toggle"/>
                </tree>
            </field>
        </record>

        <record id="view_hr_experience_position_form" model="ir.ui.view">
            <field name="name">hr.experience.position.form</field>
            <field name="model">hr.experience.position</field>
            <field name="arch" type="xml">
                <form string="Chức danh kinh nghiệm">
                    <sheet>
                        <widget name="web_ribbon" title="Đã lưu trữ" bg_color="bg-danger" invisible="active"/>
                        <field name="active" invisible="1"/>
                        <group>
                            <group>
                                <field name="name"/>
                            </group>
                            <group>
                                <field name="description"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_hr_experience_position_search" model="ir.ui.view">
            <field name="name">hr.experience.position.search</field>
            <field name="model">hr.experience.position</field>
            <field name="arch" type="xml">
                <search string="Tìm kiếm chức danh">
                    <field name="name"/>
                    <separator/>
                    <filter string="Đã lưu trữ" name="inactive" domain="[('active', '=', False)]"/>
                </search>
            </field>
        </record>

        <record id="action_hr_experience_position" model="ir.actions.act_window">
            <field name="name">Chức danh kinh nghiệm</field>
            <field name="res_model">hr.experience.position</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Tạo mới chức danh công việc/dự án
              </p>
            </field>
        </record>

        <menuitem id="menu_hr_experience_position"
                  name="Danh mục Chức danh"
                  action="action_hr_experience_position"
                  parent="hr.menu_human_resources_configuration"
                  sequence="20"/>

    </data>
</odoo>