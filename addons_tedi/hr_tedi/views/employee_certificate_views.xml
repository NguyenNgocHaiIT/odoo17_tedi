<odoo>
    <record id="view_employee_certificate_tree" model="ir.ui.view">
        <field name="name">hr.employee.certificate.tree</field>
        <field name="model">hr.employee.certificate</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="cert_type"/>
                <field name="code"/>
                <field name="issuer"/>
                <field name="practice_field"/>
                <field name="rank"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="attachment_ids" widget="many2many_binary" string="Đính kèm"/>
            </tree>
        </field>
    </record>

    <record id="view_employee_certificate_form" model="ir.ui.view">
        <field name="name">hr.employee.certificate.form</field>
        <field name="model">hr.employee.certificate</field>
        <field name="arch" type="xml">
            <form string="Chứng chỉ hành nghề">
                <group>
                    <field name="employee_id" readonly="1"/>
                    <field name="cert_type"/>
                    <field name="code"/>
                    <field name="issuer"/>
                    <field name="practice_field"/>
                    <field name="rank"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="attachment_ids" widget="many2many_binary"/>
                </group>
            </form>
        </field>
    </record>
</odoo>
