<odoo>
    <record id="view_employee_education_tree" model="ir.ui.view">
        <field name="name">hr.employee.education.tree</field>
        <field name="model">hr.employee.education</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="school"/>
                <field name="major"/>
                <field name="years"/>
                <field name="degree"/>
                <field name="issue_date"/>
                <field name="attachment_ids" widget="many2many_binary" string="Đính kèm"/>
            </tree>
        </field>
    </record>

    <record id="view_employee_education_form" model="ir.ui.view">
        <field name="name">hr.employee.education.form</field>
        <field name="model">hr.employee.education</field>
        <field name="arch" type="xml">
            <form string="Trình độ chuyên môn">
                <group>
                    <field name="employee_id" readonly="1" context="{'default_employee_id': active_id}"/>
                    <field name="school"/>
                    <field name="major"/>
                    <field name="years"/>
                    <field name="degree"/>
                    <field name="issue_date"/>
                    <field name="attachment_ids" widget="many2many_binary"/>
                </group>
            </form>
        </field>
    </record>
</odoo>
