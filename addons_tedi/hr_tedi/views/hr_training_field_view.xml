<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_training_field_tree" model="ir.ui.view">
            <field name="name">hr.training.field.tree</field>
            <field name="model">hr.training.field</field>
            <field name="arch" type="xml">
                <tree string="Lĩnh vực" editable="bottom">
                    <field name="name" class="text-start"/>
                    <field name="active" widget="boolean_toggle" optional="show" class="text-start"/>
                </tree>
            </field>
        </record>

        <record id="view_training_field_form" model="ir.ui.view">
            <field name="name">hr.training.field.form</field>
            <field name="model">hr.training.field</field>
            <field name="arch" type="xml">
                <form string="Lĩnh vực">
                    <sheet>
                        <widget name="web_ribbon" title="Đã lưu trữ" bg_color="bg-danger" invisible="active"/>
                        <field name="active" invisible="1"/>

                        <group>
                            <group>
                                <field name="name" class="text-start"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_training_field_search" model="ir.ui.view">
            <field name="name">hr.training.field.search</field>
            <field name="model">hr.training.field</field>
            <field name="arch" type="xml">
                <search string="Tìm kiếm lĩnh vực">
                    <field name="name"/>
                    <separator/>
                    <filter string="Đã lưu trữ" name="inactive" domain="[('active', '=', False)]"/>
                </search>
            </field>
        </record>

        <record id="action_training_field" model="ir.actions.act_window">
            <field name="name">Lĩnh vực</field>
            <field name="res_model">hr.training.field</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Tạo lĩnh vực  mới
              </p>
            </field>
        </record>
        <menuitem
                id="menu_hr_training_field"
                name="Lĩnh vực"
                action="action_training_field"
                parent="hr.menu_human_resources_configuration"
                sequence="2"
                groups="hr.group_hr_user"/>

    </data>
</odoo>