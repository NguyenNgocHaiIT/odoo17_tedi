<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_tedi_request_search" model="ir.ui.view">
            <field name="name">tedi.request.search</field>
            <field name="model">tedi.request</field>
            <field name="arch" type="xml">
                <search string="Tìm kiếm đơn báo">
                    <field name="name" string="Tiêu đề"/>
                    <field name="code" string="Mã đơn từ"/>
                    <field name="employee_id" string="Nhân viên"/>
                    <field name="department_id" string="Phòng ban"/>

                    <separator/>
                    <filter string="Đơn của tôi" name="my_requests" domain="[('employee_id.user_id', '=', uid)]"/>
                    <separator/>
                    <filter string="Nghỉ phép" name="type_leave" domain="[('request_type', '=', 'leave')]"/>
                    <filter string="Tăng ca" name="type_ot" domain="[('request_type', '=', 'ot')]"/>
                    <separator/>
                    <filter string="Đã duyệt" name="state_done" domain="[('state', '=', 'done')]"/>
                    <filter string="Chờ duyệt" name="state_confirm" domain="[('state', '=', 'confirm')]"/>

                    <group expand="0" string="Nhóm theo">
                        <filter string="Phòng ban" name="group_department" context="{'group_by': 'department_id'}"/>
                        <filter string="Loại đơn" name="group_type" context="{'group_by': 'request_type'}"/>
                        <filter string="Trạng thái" name="group_state" context="{'group_by': 'state'}"/>
                        <filter string="Nhân viên" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_tedi_request_tree" model="ir.ui.view">
            <field name="name">tedi.request.tree</field>
            <field name="model">tedi.request</field>
            <field name="arch" type="xml">
                <tree string="Danh sách đơn báo" sample="1">
                    <field name="code" string="Mã đơn từ" decoration-bf="1"/>

                    <field name="employee_id" string="Họ và tên" widget="many2one_avatar_user"/>

                    <field name="employee_code" string="Mã NV" optional="hide"/>

                    <field name="department_id" string="Phòng ban/Vị trí" optional="show"/>

                    <field name="request_type" string="Loại đơn"
                           decoration-info="request_type == 'leave'"
                           decoration-primary="request_type == 'ot'"/>

                    <field name="date_request" string="Ngày"/>

                    <field name="state" string="Trạng thái" widget="badge"
                           decoration-success="state == 'done'"
                           decoration-warning="state == 'confirm'"
                           decoration-danger="state == 'cancel'"
                           decoration-info="state == 'draft'"/>
                </tree>
            </field>
        </record>

        <record id="view_tedi_request_form" model="ir.ui.view">
            <field name="name">tedi.request.form</field>
            <field name="model">tedi.request</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_confirm" string="TRÌNH DUYỆT" type="object" class="oe_highlight"
                                invisible="state != 'draft'"/>
                        <button name="action_done" string="HOÀN THÀNH" type="object" class="oe_highlight"
                                invisible="state != 'confirm'"/>
                        <button name="action_cancel" string="TỪ CHỐI" type="object" class="btn-danger"
                                invisible="state != 'confirm'"/>
                        <button name="action_draft" string="Làm lại" type="object"
                                invisible="state not in ('confirm', 'done', 'cancel')"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,confirm,done"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="date_request"/>
                                <field name="employee_code" force_save="1" readonly="1"/>
                                <field name="employee_id"
                                       string="Người đề nghị"
                                       readonly="1"
                                       force_save="1"
                                       options="{'no_open': True, 'no_create': True}"/>
                            </group>
                            <group>
                                <field name="request_type"/>
                                <field name="content"/>
                                <field name="department_id"/>
                                <field name="leave_taken"/>
                                <field name="leave_remaining"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Lịch sử đơn báo">
                                <field name="history_ids" readonly="1">
                                    <tree decoration-success="state == 'done'" decoration-danger="state == 'cancel'">
                                        <field name="employee_id" string="Nhân sự"/>
                                        <field name="department_id" string="Bộ phận"/>
                                        <field name="request_type" string="Loại đơn báo"/>
                                        <field name="date_request" string="Ngày gửi"/>
                                        <field name="create_date" string="Ngày tạo" widget="date"/>
                                        <field name="content" string="Nội dung"/>
                                        <field name="state" string="Trạng thái" widget="badge"
                                               decoration-info="state == 'draft'"
                                               decoration-warning="state == 'confirm'"
                                               decoration-success="state == 'done'"
                                               decoration-danger="state == 'cancel'"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>

                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="action_tedi_request" model="ir.actions.act_window">
            <field name="name">Danh sách đơn báo</field>
            <field name="res_model">tedi.request</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_my_requests': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Tạo đơn báo mới</p>
            </field>
        </record>

        <menuitem id="menu_tedi_request_root"
                  name="Đơn báo"
                  parent="hr_attendance.menu_hr_attendance_root"
                  action="action_tedi_request"
                  sequence="10"/>
    </data>
</odoo>