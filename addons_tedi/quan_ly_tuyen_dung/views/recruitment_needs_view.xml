<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="view_recruitment_needs_year_tree" model="ir.ui.view">
            <field name="name">recruitment.needs.year.tree</field>
            <field name="model">recruitment.needs</field>
            <field name="arch" type="xml">
                <tree string="Nhu cầu Năm" default_order="create_date desc">
                    <field name="display_code"/>
                    <field name="name" string="Đợt đăng ký"/>
                    <field name="department_id"/>
                    <field name="create_date"/>
                    <field name="state" widget="badge" decoration-success="state == 'confirmed'"/>
                </tree>
            </field>
        </record>

        <record id="view_recruitment_needs_year_form" model="ir.ui.view">
            <field name="name">recruitment.needs.year.form</field>
            <field name="model">recruitment.needs</field>
            <field name="arch" type="xml">
                <form string="Nhu cầu Năm">
                    <header>
                        <button name="action_approve" string="Xác nhận" type="object" class="btn-primary" invisible="state != 'draft'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="display_code" readonly="1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="type" readonly="1" invisible="1"/>
                                <field name="name" string="Đợt đăng ký"  readonly="state == 'confirmed'"/>
                                <field name="department_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="create_date" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Chi tiết tuyển dụng">
                                <field name="line_ids" readonly="state == 'confirmed'">
                                    <tree editable="bottom">
                                        <field name="job_id"/>
                                        <field name="current_employee_count" string="NS hiện có" readonly="1"/>
                                        <field name="amount" sum="Tổng SL"/>
                                        <field name="expected_salary" widget="monetary"/>

                                        <field name="progress_summary"
                                               string="Tiến độ (Q1-4)"
                                               readonly="1"
                                               optional="show"
                                               column_invisible="parent.state == 'draft'"/>

                                        <field name="experience_id"/>
                                        <field name="professional_qualification"/>
                                        <field name="note"/>

                                        <button name="action_open_progress_wizard"
                                                type="object"
                                                icon="fa-calendar"
                                                string="Phân bổ"
                                                class="btn-secondary"
                                                title="Nhập tiến độ"
                                                invisible="parent.state != 'draft'"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>


        <record id="view_recruitment_needs_actual_tree" model="ir.ui.view">
            <field name="name">recruitment.needs.actual.tree</field>
            <field name="model">recruitment.needs</field>
            <field name="arch" type="xml">
                <tree string="Nhu cầu Thực tế" default_order="create_date desc">
                    <field name="display_code"/>
                    <field name="plan_id" string="Kế hoạch Quý"/>
                    <field name="department_id"/>
                    <field name="create_date"/>
                    <field name="state" widget="badge" decoration-success="state == 'confirmed'"/>
                </tree>
            </field>
        </record>

        <record id="view_recruitment_needs_actual_form" model="ir.ui.view">
            <field name="name">recruitment.needs.actual.form</field>
            <field name="model">recruitment.needs</field>
            <field name="arch" type="xml">
                <form string="Nhu cầu Thực tế">
                    <header>
                        <button name="action_approve" string="Xác nhận" type="object" class="btn-primary" invisible="state != 'draft'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="display_code" readonly="1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="type" readonly="1" invisible="1"/>
                                <field name="plan_id" string="Thuộc Kế hoạch Quý" readonly="state == 'confirmed'"/>
                                <field name="department_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="create_date" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Chi tiết tuyển dụng">
                                <field name="line_ids" readonly="state == 'confirmed'">
                                    <tree editable="bottom">
                                        <field name="job_id"/>
                                        <field name="current_employee_count" string="NS hiện có" readonly="1"/>
                                        <field name="amount" sum="Tổng SL"/>
                                        <field name="expected_salary" widget="monetary"/>
                                        <field name="experience_id"/>
                                        <field name="professional_qualification"/>
                                        <field name="note"/>
                                        </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>


        <record id="action_recruitment_needs_year" model="ir.actions.act_window">
            <field name="name">Nhu cầu Năm</field>
            <field name="res_model">recruitment.needs</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('type', '=', 'year')]</field>
            <field name="context">{'default_type': 'year'}</field>
            <field name="view_ids" eval="[
                (5, 0, 0),
                (0, 0, {'view_id': ref('view_recruitment_needs_year_tree'), 'view_mode': 'tree'}),
                (0, 0, {'view_id': ref('view_recruitment_needs_year_form'), 'view_mode': 'form'}),
            ]"/>
        </record>

        <record id="action_recruitment_needs_actual" model="ir.actions.act_window">
            <field name="name">Nhu cầu Thực tế</field>
            <field name="res_model">recruitment.needs</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('type', '=', 'actual')]</field>
            <field name="context">{'default_type': 'actual'}</field>
            <field name="view_ids" eval="[
                (5, 0, 0),
                (0, 0, {'view_id': ref('view_recruitment_needs_actual_tree'), 'view_mode': 'tree'}),
                (0, 0, {'view_id': ref('view_recruitment_needs_actual_form'), 'view_mode': 'form'}),
            ]"/>
        </record>

        <record id="view_recruitment_progress_wizard_form" model="ir.ui.view">
            <field name="name">recruitment.progress.wizard.form</field>
            <field name="model">recruitment.progress.wizard</field>
            <field name="arch" type="xml">
                <form string="Cấu hình tiến độ">
                    <group>
                        <group>
                            <field name="line_id" invisible="1"/>
                            <field name="amount_total"/>
                        </group>
                    </group>
                    <group string="Phân bổ theo quý">
                        <group col="2">
                            <field name="qty_q1"/>
                            <field name="qty_q2"/>
                            <field name="qty_q3"/>
                            <field name="qty_q4"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_confirm" string="Xác nhận" type="object" class="btn-primary"/>
                        <button string="Hủy" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>