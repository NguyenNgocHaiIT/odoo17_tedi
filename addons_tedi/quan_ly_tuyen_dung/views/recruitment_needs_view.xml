<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="view_recruitment_needs_tree" model="ir.ui.view">
            <field name="name">recruitment.needs.tree</field>
            <field name="model">recruitment.needs</field>
            <field name="arch" type="xml">
                <tree string="Đăng ký nhu cầu">
                    <field name="name" string="Đợt khảo sát" class="text-start"/>
                    <field name="create_date" string="Ngày đăng ký" class="text-start"/>
                    <field name="department_id" string="Phòng ban đăng ký" class="text-start"/>
                    <field name="state" string="Trạng thái"
                           widget="badge"
                           decoration-warning="state == 'draft'"
                           decoration-success="state == 'confirmed'"
                           class="text-start"/>
                </tree>
            </field>
        </record>

        <record id="view_recruitment_needs_form" model="ir.ui.view">
            <field name="name">recruitment.needs.form</field>
            <field name="model">recruitment.needs</field>
            <field name="arch" type="xml">
                <form string="Đăng ký nhu cầu">
                    <header>
                        <button name="action_approve"
                                string="Xác nhận"
                                type="object"
                                class="btn-primary"
                                invisible="state != 'draft'"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,confirmed"/>
                    </header>

                    <sheet>
                        <group>
                            <group>
                                <field name="name" string="Đợt khảo sát" readonly="state == 'confirmed'"/>
                                <field name="department_id" string="Phòng ban đăng ký" readonly="1"/>
                            </group>
                            <group>
                                <field name="create_date" string="Ngày đăng ký" readonly="1"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Nhu cầu tuyển dụng">
                                <field name="line_ids"
                                       options="{'no_open': True}"
                                       readonly="state == 'confirmed'">

                                    <tree string="Nhu cầu tuyển dụng"
                                          editable="bottom"
                                          readonly="parent.state == 'confirmed'">

                                        <field name="job_id" class="text-center"/>
                                        <field name="current_employee_count" string="NS hiện có" readonly="1" class="text-center" optional="show"/>

                                        <field name="amount" sum="Tổng SL"/>

                                        <field name="expected_salary" widget="monetary" options="{'currency_field': 'company_currency_id'}"/>

                                        <field name="experience_id" class="text-center" optional="hide"/>
                                        <field name="professional_qualification" optional="hide"/>
                                        <field name="note" class="text-center" optional="show"/>

                                        <button name="action_open_progress_wizard"
                                                string="Tiến trình"
                                                type="object"
                                                icon="fa-calendar"
                                                title="Cấu hình tiến trình bổ sung"
                                                class="btn-secondary"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_recruitment_progress_wizard_form" model="ir.ui.view">
            <field name="name">recruitment.progress.wizard.form</field>
            <field name="model">recruitment.progress.wizard</field>
            <field name="arch" type="xml">
                <form string="Tiến trình bổ sung">
                    <sheet>
                        <group>
                            <field name="amount_total" class="fw-bold"/>
                        </group>
                        <group string="Phân bổ theo Quý">
                            <group>
                                <field name="qty_q1"/>
                                <field name="qty_q2"/>
                            </group>
                            <group>
                                <field name="qty_q3"/>
                                <field name="qty_q4"/>
                            </group>
                        </group>
                        <p class="text-muted text-center">
                            * Vui lòng nhập số lượng nhân sự cần tuyển cho từng quý.
                        </p>
                    </sheet>
                    <footer>
                        <button name="action_confirm" string="Lưu &amp; Đóng" type="object" class="btn-primary"/>
                        <button string="Hủy" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_recruitment_needs" model="ir.actions.act_window">
            <field name="name">Đăng ký nhu cầu</field>
            <field name="res_model">recruitment.needs</field>
            <field name="view_mode">tree,form</field>
            <field name="view_ids" eval="[
                (5, 0, 0),
                (0, 0, {'view_id': ref('view_recruitment_needs_tree'), 'view_mode': 'tree'}),
                (0, 0, {'view_id': ref('view_recruitment_needs_form'), 'view_mode': 'form'}),
            ]"/>
        </record>

    </data>
</odoo>