<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- TREE GIỮ NGUYÊN -->
    <record id="recruitment_survey_tree" model="ir.ui.view">
        <field name="name">recruitment_survey_tree</field>
        <field name="model">recruitment.survey</field>
        <field name="arch" type="xml">
            <tree string="Yêu cầu đăng ký tuyển dụng" default_order="create_date desc">
                <field name="name" string="Tên đợt đăng ký" class="text-start"/>
                <field name="create_date" string="Ngày tạo" class="text-start"/>
                <field name="start_date" string="Từ ngày" class="text-start"/>
                <field name="end_date" string="Đến ngày" class="text-start"/>
                <field name="user_id" string="Người tạo" class="text-start"/>
                <field name="state"
                       string="Trạng thái"
                       widget="badge"
                       decoration-danger="state == 'draft'"
                       decoration-warning="state == 'in_process'"
                       decoration-success="state == 'end'"
                       class="text-start"/>
            </tree>
        </field>
    </record>

    <!-- FORM -->
    <record id="recruitment_survey_form" model="ir.ui.view">
        <field name="name">recruitment_survey_form</field>
        <field name="model">recruitment.survey</field>
        <field name="arch" type="xml">
            <form string="Yêu cầu đăng ký tuyển dụng">
                <!-- state ẩn để dùng cho statusbar -->
                <field name="state" invisible="1"/>

                <header>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,confirmed,in_process,end"/>

                    <!-- Nút xác nhận: từ draft -> in_process, set start_date = hôm nay -->
                    <button name="action_submit"
                            type="object"
                            string="Xác nhận"
                            class="btn-primary"
                            groups="quan_ly_tuyen_dung.group_recruitment_committee"
                            invisible="state != 'draft'"/>

                    <button name="action_end"
                        string="Kết thúc"
                        type="object"
                        class="btn-secondary"
                        confirm="Bạn có chắc chắn muốn kết thúc đợt đăng ký này ngay lập tức?"
                        groups="quan_ly_tuyen_dung.group_recruitment_committee"
                        invisible="state != 'in_process'"/>

                    <button name="action_start_survey"
                        string="Bắt đầu"
                        type="object"
                        class="btn-primary"
                        confirm="Bạn có chắc chắn muốn bắt đầu đợt đăng ký này ngay lập tức?"
                        groups="quan_ly_tuyen_dung.group_recruitment_committee"
                        invisible="state != 'confirmed'"/>
                </header>

                  <sheet>
                <!-- KHÓA TOÀN BỘ FORM KHI state = end -->
                    <group readonly="state == 'end'">
                        <group>
                            <field name="name" required="1" readonly="state != 'draft'"/>
                            <field name="user_id" required="1" readonly="1"/>
                        </group>

                        <group>
                            <field name="create_date" readonly="1" widget="date" />
                            <label for="start_date" string="Thời gian đăng ký" readonly="state == 'end'"/>
                            <div class="o_row">
                                <field name="start_date" widget="date" readonly="state != 'draft'"/>
                                <span style="margin: 0 10px;">→</span>
                                <field name="end_date" widget="date" readonly="state != 'draft'"/>
                            </div>
                        </group>
                    </group>
                </sheet>

            </form>
        </field>
    </record>

    <!-- ACTION: GẮN SẴN TREE + FORM -->
    <record id="action_recruitment_survey" model="ir.actions.act_window">
        <field name="name">Yêu cầu đăng ký tuyển dụng</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">recruitment.survey</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_id': ref('recruitment_survey_tree'), 'view_mode': 'tree'}),
            (0, 0, {'view_id': ref('recruitment_survey_form'), 'view_mode': 'form'})
        ]"/>
    </record>

</odoo>
