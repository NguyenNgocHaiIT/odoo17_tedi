<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ACTION mở từ MENU: không dùng active_id -->
  <record id="action_applicants_menu" model="ir.actions.act_window">
    <field name="name">Ứng viên</field>
    <field name="res_model">hr.applicant</field>
    <field name="view_mode">tree,kanban,form</field>
    <field name="context">{'search_default_stage': 1}</field>
    <!-- nếu bạn có search/tree/kanban custom thì tham chiếu ở đây -->
    <!-- <field name="search_view_id" ref="quan_ly_tuyen_dung.view_hr_applicant_search_tedi"/> -->
  </record>

  <!-- ACTION mở từ hr.job: dùng active_id -->
  <record id="action_applicants_from_job" model="ir.actions.act_window">
    <field name="name">Ứng viên</field>
    <field name="res_model">hr.applicant</field>
    <field name="view_mode">tree,kanban,form</field>
    <field name="context">
      {
        'search_default_job_id': [active_id],
        'default_job_id': active_id,
        'search_default_stage': 1,
        'dialog_size': 'medium'
      }
    </field>
  </record>

  <record id="view_hr_job_form_tedi_buttons" model="ir.ui.view">
    <field name="name">hr.job.form.tedi.buttons</field>
    <field name="model">hr.job</field>
    <field name="inherit_id" ref="hr.view_hr_job_form"/>  <!-- form gốc của hr.job -->
    <field name="arch" type="xml">
      <xpath expr="//div[@name='button_box']" position="inside">
        <!-- Smart button mở danh sách ứng viên của Job đang mở -->
        <button class="oe_stat_button"
                type="action"
                name="%(quan_ly_tuyen_dung.action_applicants_from_job)d"
                icon="fa-users">
          <div class="o_stat_info">
            <span class="o_stat_text">Ứng viên</span>
          </div>
        </button>
      </xpath>
    </field>
  </record>

</odoo>
