<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!-- THAY HẲN FORM hr.applicant -->
    <record id="hr_applicant_form_replaced_clean" model="ir.ui.view">
      <field name="name">hr.applicant.form.replaced.clean</field>
      <field name="model">hr.applicant</field>
      <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
      <field name="priority">999</field>
      <field name="arch" type="xml">

        <!-- Replace toàn bộ <form> -->
        <xpath expr="//form" position="replace">
          <form string="Applicant" class="o_xxl_form_view o_form_no_sidebar o_form_narrow">
            <!-- giữ các field invisible cần thiết -->
            <field name="company_id" invisible="1"/>
            <field name="application_status" invisible="1"/>
            <field name="emp_id" invisible="1"/>
            <field name="meeting_ids" invisible="1"/>
            <field name="refuse_reason_id" invisible="1"/>
            <field name="email_normalized" invisible="1"/>
            <field name="partner_phone_sanitized" invisible="1"/>
            <field name="partner_mobile_sanitized" invisible="1"/>
            <field name="emp_is_active" invisible="1"/>
            <field name="active" invisible="1"/>
            <field name="date_closed" invisible="1"/>

            <header>
              <button string="Create Employee" name="create_employee_from_applicant" type="object"
                      class="o_create_employee" groups="quan_ly_tuyen_dung.group_recruitment_hr_officer, base.group_user"
                      invisible="emp_id or not active or not date_closed"/>
              <button string="Refuse" name="archive_applicant" type="object" invisible="not active"/>
              <button string="Restore" name="toggle_active" type="object" invisible="active"/>
                <!-- Cho người ĐƯỢC đổi stage: clickable -->
                <field name="stage_id"
                       widget="statusbar"
                       options="{'clickable': 1, 'fold_field': 'fold'}"
                       groups="quan_ly_tuyen_dung.group_recruitment_stage_editors , base.group_user"
                       invisible="not active and not emp_id"/>

<!--                &lt;!&ndash; Cho người KHÔNG được đổi stage: readonly (không clickable) &ndash;&gt;-->
<!--                <field name="stage_id"-->
<!--                       widget="statusbar"-->
<!--                       options="{'clickable': 0, 'fold_field': 'fold'}"-->
<!--                       groups="base.group_user"-->
<!--                       invisible="not active and not emp_id"/>-->

            </header>

            <!-- form 1 cột, full width -->
            <sheet class="o_form_sheet_full">
              <div class="oe_button_box" name="button_box">
                <button name="action_open_employee" type="object" class="oe_stat_button" icon="fa-id-card-o"
                        groups="hr.group_hr_user" invisible="not (emp_id or emp_is_active)">
                  <div class="o_field_widget o_stat_info">
                    <span class="o_stat_value"><field name="employee_name" readonly="1"/></span>
                    <span class="o_stat_text">Employee</span>
                  </div>
                </button>
                <button name="action_applications_email" class="oe_stat_button" icon="fa-pencil" type="object"
                        context="{'active_test': False}" invisible="application_count == 0">
                  <field name="application_count" widget="statinfo" string="Other applications"/>
                </button>

              </div>

              <field name="active" invisible="1"/>
              <field name="legend_normal" invisible="1"/>
              <field name="legend_blocked" invisible="1"/>
              <field name="legend_done" invisible="1"/>


                <div class="d-flex align-items-center" style="margin-bottom: 12px;">
                  <button name="action_makeMeeting"
                          class="oe_stat_button"
                          icon="fa-calendar"
                          type="object"
                          invisible="not id"
                          style="margin-left: auto;">
                    <div class="o_field_widget o_stat_info">
                      <span class="o_stat_text"><field name="meeting_display_text"/></span>
                      <span class="o_stat_value"><field name="meeting_display_date" readonly="1"/></span>
                    </div>
                  </button>
                </div>


              <!-- Nội dung chính (không còn cột phải/chatter/preview) -->
              <group>
                <group string = "THÔNG TIN CÁ NHÂN">
<!--                  <field name="partner_id" invisible="1"/>-->
                  <field name="partner_name" string = "Họ và tên"/>
                  <field name="dob" string="Sinh ngày"/>
                  <field name="country_id"   string="Quốc tịch"/>
                  <field name="folk" string="Dân tộc"/>
                  <field name="current_job" string="Nghề nghiệp"/>
                  <field name="address" string="Địa chỉ thường trú"/>


                </group>
                <group string="THÔNG TIN LIÊN HỆ">
                      <field name="email_from" widget="email" string ="Email"/>
                      <field name="partner_mobile" widget="phone" string="Điện thoại"/>


                </group>

                <group string="VỊ TRÍ TUYỂN DỤNG">
<!--                     <div colspan="2" style="grid-column: 1 / -1;">-->
<!--                        <h5 class="section-title-vi-tri-tuyen-dung">-->
<!--                          VỊ TRÍ TUYỂN DỤNG-->
<!--                        </h5>-->
<!--                     </div>-->

                  <field name="recruitment_plan_id"
                       string="Đợt tuyển dụng"
                       domain="[('recruitment_status', '=', 'complete')]"/>
                  <field name="job_id" string ="Vị trí tuyển dụng" />
                  <field name="department_id" string="Phòng ban"/>
                  <field name="interviewer_ids" options="{'no_create': True, 'no_create_edit': True}" widget="many2many_avatar_user"/>
                  <field name="priority" widget="priority"/>
                  <field name="source_id"/>
                  <field name="attachment_ids" string="Link hồ sơ" widget="many2many_tags"/>


                </group>
                <group string="ĐỀ XUẤT CỦA ỨNG VIÊN">
<!--                    <div colspan="2" style="grid-column: 1 / -1;">-->
<!--                        <h5 class="section-title-de-xuat-ung-vien">-->
<!--                          ĐỀ XUẤT CỦA ỨNG VIÊN-->
<!--                        </h5>-->
<!--                     </div>-->
                  <label for="salary_expected"/>
                  <div class="o_row">
                    <field name="salary_expected"/>
                    <span invisible="not salary_expected_extra"> + </span>
                    <field name="salary_expected_extra" placeholder="Các phúc lợi khác..."/>
                  </div>
                  <label for="salary_proposed"/>
                  <div class="o_row">
                    <field name="salary_proposed"/>
                    <span invisible="not salary_proposed_extra"> + </span>
                    <field name="salary_proposed_extra" placeholder="Các phúc lợi khác..."/>
                  </div>
                  <field name="availability" placeholder="Thời gian bắt đầu làm việc"/>
                </group>
              </group>



                <separator string="KHẢO SÁT SỰ PHÙ HỢP CỦA ỨNG VIÊN"/>
                <div style="display:flex; align-items:center; gap:18px; margin-top:4px;">
                    <field name="suitability_doc_ids" widget="many2many_binary"/>
                    <field name="suitability" widget="radio" options="{'horizontal': true}"/>
                </div>

<!--                <div style="display:flex; align-items:center; gap:16px; margin-top:4px; border-left:3px solid #0097a7; padding-left:8px;">-->
<!--                  <span style="font-weight:600; color:#0097a7; white-space:nowrap;">-->
<!--                    KHẢO SÁT SỰ PHÙ HỢP CỦA ỨNG VIÊN-->
<!--                  </span>-->
<!--                  <div style="display:flex; align-items:center; gap:12px;">-->
<!--                    <field name="suitability_doc_ids" widget="many2many_binary"/>-->
<!--                    <field name="suitability" widget="radio" options="{'horizontal': true}"/>-->
<!--                  </div>-->
<!--                </div>-->









              <field name="applicant_properties" columns="2"/>
                <notebook>
                <page string="Đánh giá ứng viên sau phỏng vấn" name="application_summary">
                  <field name="description" placeholder="Motivations..."/>
                  <button name="action_open_applicant_evaluation_page"
                                string="Đánh giá sau phỏng vấn"
                                type="object"
                                class="btn-primary"
                               />

                </page>


              </notebook>
              <notebook>

                  <page string="Trình độ học vấn">
<!--                      <div class="oe_title pe-0">-->
<!--                        <h2 class="d-flex justify-content-between align-items-center"-->
<!--                                   style="color: blue">-->
<!--                        Trình độ học vấn-->
<!--                        </h2>-->
<!--                      </div>-->
                      <group  string="TRÌNH ĐỘ HỌC VẤN">

                      </group>
                      <field name="education_level_ids" nolabel="1" mode="tree,form"
                             context="{'default_applicant_id': active_id}">
                        <tree ref="view_hr_app_edu_tree"/>
                        <form ref="view_hr_app_edu_form"/>
                      </field>

<!--                      <div class="oe_title pe-0">-->
<!--                        <h2 class="d-flex justify-content-between align-items-center"-->
<!--                                   style="color: blue">-->
<!--                        Chứng chỉ hành nghề-->
<!--                        </h2>-->
<!--                      </div>-->
                      <group  string="CHỨNG CHỈ HÀNH NGHỀ">

                      </group>
                      <field name="professor_license_ids" nolabel="1" mode="tree,form"
                             context="{'default_applicant_id': active_id}">
                        <tree ref="view_hr_professor_license_tree"/>
                        <form ref="view_hr_professor_license_form"/>
                      </field>
                    </page>
                  <page string = "Quá trình đào tạo">
                      <field name="training_process_ids" nolabel="1" mode="tree,form"
                             context="{'default_applicant_id': active_id}">
                        <tree ref="view_hr_training_process_tree"/>
                        <form ref="view_hr_training_process_form"/>
                      </field>
                  </page>

                  <page string = "Quá trình công tác cũ">
                      <field name="old_work_process_ids" nolabel="1" mode="tree,form"
                             context="{'default_applicant_id': active_id}">
                        <tree ref="view_hr_old_work_process_tree"/>
                        <form ref="view_hr_old_work_process_form"/>
                      </field>
                  </page>
              </notebook>
            </sheet>
          </form>
        </xpath>

      </field>
    </record>

         <!-- Trình độ học vấn -->
    <record id="view_hr_app_edu_tree" model="ir.ui.view">
      <field name="name">education.level.tree</field>
      <field name="model">education.level</field>
      <field name="arch" type="xml">
        <!-- Giữ inline -->
        <tree string="Trình độ học vấn" editable="bottom" class="tedi-subtree">
          <field name="stt" string="STT" readonly="1" width="60"/>
          <field name="training_major" string="Chuyên ngành đào tạo" required="1"/>
          <field name="school" string="Trường đào tạo" required="1"/>
          <field name="year_graduation" string="Năm tốt nghiệp" required="1"/>
          <field name="professional_qualification" string="Trình độ" required="1"
                 options="{'no_quick_create': True, 'no_create_edit': True}"/>
          <field name="graduation_type" string="Loại tốt nghiệp"
                 options="{'no_quick_create': True, 'no_create_edit': True}"/>
        </tree>
      </field>
    </record>


  <record id="view_hr_app_edu_form" model="ir.ui.view">
      <field name="name">education.level.form</field>
    <field name="model">education.level</field>
    <field name="arch" type="xml">
      <form string="Trình độ học vấn">
        <group>
          <group>
            <field name="stt" />
            <field name="training_major"/>
            <field name="school"/>
            <field name="year_graduation"/>
          </group>
          <group>
            <field name="professional_qualification"/>
            <field name="graduation_type"/>
          </group>
        </group>
        <footer><button string="Đóng" special="cancel" class="btn-secondary"/></footer>
      </form>
    </field>
  </record>

    <!--    Chứng chỉ hành nghề  -->
    <record id="view_hr_professor_license_tree" model="ir.ui.view">
      <field name="name">professor.license.tree</field>
      <field name="model">professor.license</field>
      <field name="arch" type="xml">
        <tree string="Chứng chỉ hành nghề" editable="bottom" class="tedi-subtree">
          <field name="stt" string="STT" readonly="1" width="60"/>
          <field name="name" string="Tên chứng chỉ" required="1"/>
          <field name="code" string="Mã chứng chỉ" required="1"/>
          <field name="license_place" string="Nơi cấp" required="1"/>
          <field name="start_date" string="Từ ngày" required="1"/>
          <field name="end_date" string="Đến ngày" required="1"/>
          <field name="attachment_ids" string="Đính kèm" widget="many2many_binary"/>
        </tree>
      </field>
    </record>


  <record id="view_hr_professor_license_form" model="ir.ui.view">
    <field name="name">professor.license.form</field>
    <field name="model">professor.license</field>
    <field name="arch" type="xml">
      <form string="Trình độ học vấn">
        <group>
          <group>
            <field name="name" string="Tên chứng chỉ"/>
            <field name="code" string="Mã chứng chỉ"/>
            <field name="license_place" string="Nơi cấp"/>
          </group>
          <group>
            <field name="start_date" string="Từ ngày"/>
            <field name="end_date" string="Đến ngày"/>
            <field name="attachment_ids" string="Đính kèm" widget="many2many_tags"/>
          </group>
        </group>
        <footer><button string="Đóng" special="cancel" class="btn-secondary"/></footer>
      </form>
    </field>
  </record>

     <!--    Quá trình đào tạo  -->
     <record id="view_hr_training_process_tree" model="ir.ui.view">
      <field name="name">training.process.tree</field>
      <field name="model">training.process</field>
      <field name="arch" type="xml">
        <tree string="Quá trình đào tạo" editable="bottom" class="tedi-subtree">
          <field name="stt" string="STT" readonly="1" width="60"/>
          <field name="training_name" string="Tên khoá đào tạo" required="1"/>
          <field name="training_location" string="Cơ sở đào tạo" required="1"/>
          <field name="start_date" string="Từ ngày" required="1"/>
          <field name="end_date" string="Đến ngày" required="1"/>
          <field name="result_state" string="Trạng thái"
                 options="{'no_quick_create': True, 'no_create_edit': True}"/>
        </tree>
      </field>
    </record>


  <record id="view_hr_training_process_form" model="ir.ui.view">
    <field name="name">training.process.form</field>
    <field name="model">training.process</field>
    <field name="arch" type="xml">
      <form string="Trình độ học vấn">
        <group>
          <group>
            <field name="training_name" string="Tên khoá đào tạo"/>
            <field name="training_location" string="Cơ sở đào tạo"/>
          </group>
          <group>
            <field name="start_date" string="Từ ngày"/>
            <field name="end_date" string="Đến ngày"/>
            <field name="result_state" string="Trạng thái"/>
          </group>
        </group>
        <footer><button string="Đóng" special="cancel" class="btn-secondary"/></footer>
      </form>
    </field>
  </record>

          <!-- Quá trình công tác cũ -->
     <record id="view_hr_old_work_process_tree" model="ir.ui.view">
      <field name="name">old.work.process.tree</field>
      <field name="model">old.work.process</field>
      <field name="arch" type="xml">
        <tree string="Quá trình công tác cũ" editable="bottom" class="tedi-subtree">
          <field name="stt" string="STT" readonly="1" width="60"/>
          <field name="old_company" string="Tên công ty" required="1"/>
          <field name="address" string="Địa chỉ làm việc" required="1"/>
          <field name="working_date" string="Thời gian làm việc" required="1"/>
          <field name="position" string="Chức danh" required="1"/>
        </tree>
      </field>
    </record>


  <record id="view_hr_old_work_process_form" model="ir.ui.view">
      <field name="name">old.work.process.form</field>
    <field name="model">old.work.process</field>
    <field name="arch" type="xml">
      <form string="Trình độ học vấn">
        <group>
          <group>
            <field name="old_company" string="Tên công ty"/>
            <field name="address" string="Địa chỉ làm việc"/>
          </group>
          <group>
            <field name="working_date" string="Thời gian làm việc"/>
            <field name="position" string="Chức danh"/>
          </group>
        </group>
        <footer><button string="Đóng" special="cancel" class="btn-secondary"/></footer>
      </form>
    </field>
  </record>
  </data>
</odoo>
