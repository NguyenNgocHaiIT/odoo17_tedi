<odoo>
  <data noupdate="1">
    <record id="seq_recruitment_plan_code" model="ir.sequence">
      <field name="name">Recruitment Plan Sequence</field>
      <field name="code">recruitment.plan.code</field>
      <field name="prefix">RP%(y)s-</field> <!-- RP2025- -->
      <field name="padding">4</field>        <!-- Số 0 lót -->
      <field name="number_next">1</field>
      <field name="number_increment">1</field>
      <field name="company_id" eval="False"/>
    </record>

    <record id="ir_cron_auto_update_survey_states" model="ir.cron">
            <field name="name">Survey: Tự động cập nhật trạng thái (In Process / End)</field>
            <field name="model_id" ref="model_recruitment_survey"/>
            <field name="state">code</field>
            <field name="code">model._cron_update_survey_states()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
    </record>
  </data>
</odoo>
