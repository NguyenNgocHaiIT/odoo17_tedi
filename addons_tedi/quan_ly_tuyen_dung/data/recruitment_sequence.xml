<odoo>
  <data noupdate="1">
    <record id="seq_recruitment_plan_code" model="ir.sequence">
      <field name="name">Recruitment Plan Sequence</field>
      <field name="code">recruitment.plan.code</field>
      <field name="prefix">RP%(y)s-</field> <!-- RP2025- -->
      <field name="padding">4</field>        <!-- Số 0 lót -->
      <field name="number_next">1</field>
      <field name="number_increment">1</field>
      <field name="company_id" eval="False"/>
    </record>
  </data>
</odoo>
