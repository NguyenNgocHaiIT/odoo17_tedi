<odoo>
  <data>
    <record id="view_project_task_form_org_chart" model="ir.ui.view">
      <field name="name">project.task.form.org.chart</field>
      <field name="model">project.task</field>
      <field name="inherit_id" ref="project_tedi.view_task_form"/>
      <field name="arch" type="xml">
        <xpath expr="//page[@name='sub_tasks_page']" position="after">
          <page string="Cấu trúc cây công việc">
            <field name="child_ids"
                   widget="org_chart"
                   nolabel="1"
                   options="{'density': 'compact'}"/>
          </page>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
