<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

       <record id="view_tedi_allowance_import_wizard" model="ir.ui.view">
            <field name="name">tedi.allowance.import.wizard.form</field>
            <field name="model">tedi.allowance.import.wizard</field>
            <field name="arch" type="xml">
                <form string="Import Phụ cấp từ Excel">
                    <div class="alert alert-warning" role="alert">
                        <strong>LƯU Ý QUAN TRỌNG:</strong><br/>
                        Trước khi import, hãy đảm bảo bạn đã khai báo <b>Mã loại phụ cấp</b> trong menu <i>Cấu hình > Danh mục Loại Phụ cấp</i>.<br/>
                    </div>
                    <div class="alert alert-info" role="alert">
                        <strong>Cấu trúc Excel:</strong><br/>
                        - Cột A: Tháng<br/>
                        - Cột B: Năm<br/>
                        - Cột C: <b>Mã Loại Phụ cấp</b> (Khớp với cột 'Mã loại' trong danh mục)<br/>
                        - Cột D: Mã chi tiết (Tùy chọn)<br/>
                        - Cột E: Mã nhân viên (Bắt buộc)<br/>
                        - Cột F: Số tiền
                    </div>
                    <group>
                        <field name="file" filename="filename"/>
                        <field name="filename" invisible="1"/>
                    </group>
                    <footer>
                        <button name="action_import"
                                type="object"
                                string="Import dữ liệu"
                                class="btn-primary"/>
                        <button string="Đóng" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_tedi_allowance_import" model="ir.actions.act_window">
            <field name="name">Import Phụ cấp</field>
            <field name="res_model">tedi.allowance.import.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>






    </data>
</odoo>