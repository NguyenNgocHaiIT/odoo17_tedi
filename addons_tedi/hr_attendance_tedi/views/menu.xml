<odoo>
    <data>

        <record id="hr_attendance.menu_hr_attendance_root" model="ir.ui.menu">
            <field name="groups_id" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <menuitem id="menu_tedi_attendance_config"
                  name="Cấu hình"
                  parent="hr_attendance.menu_hr_attendance_root"
                  sequence="100"/>

        <menuitem id="menu_tedi_holiday_config"
                  name="Ngày nghỉ (Lịch)"
                  parent="menu_tedi_attendance_config"
                  action="action_tedi_holiday_config"
                  groups="hr_holidays.group_hr_holidays_user"
                  sequence="1"/>

        <menuitem id="menu_tedi_leave_type_config"
                  name="Loại nghỉ phép"
                  parent="menu_tedi_attendance_config"
                  action="hr_holidays.open_view_holiday_status"
                  groups="hr_holidays.group_hr_holidays_manager"
                  sequence="2"/>


        <menuitem id="menu_tedi_attendance_gantt_custom"
                  name="Lịch chấm công"
                  parent="hr_attendance.menu_hr_attendance_root"
                  action="action_tedi_attendance_gantt_custom"
                  sequence="2"/>

        <menuitem id="menu_tedi_request_root"
                  name="Đơn nghỉ phép"
                  parent="hr_attendance.menu_hr_attendance_root"
                  sequence="3"/>

        <menuitem id="menu_tedi_request_dashboard"
                  name="Bảng điều khiển"
                  parent="menu_tedi_request_root"
                  action="hr_holidays.hr_leave_action_new_request"
                  sequence="0"/>

        <menuitem id="menu_tedi_request_my"
                  name="Đơn nghỉ phép của tôi"
                  parent="menu_tedi_request_root"
                  action="hr_holidays.hr_leave_action_my"
                  sequence="1"/>

        <menuitem id="menu_tedi_request_all"
                  name="Tất cả đơn nghỉ phép"
                  parent="menu_tedi_request_root"
                  action="hr_holidays.hr_leave_action_action_approve_department"
                  groups="hr_holidays.group_hr_holidays_user"
                  sequence="2"/>

        <menuitem id="menu_tedi_attendance_import"
                  name="Import Excel"
                  parent="hr_attendance.menu_hr_attendance_root"
                  action="action_tedi_attendance_import"
                  groups="hr_attendance.group_hr_attendance_officer"
                  sequence="4"/>

        <record id="group_tedi_hidden_menus" model="res.groups">
            <field name="name">Hidden Menus (Do not use)</field>
        </record>
        <record id="hr_attendance.menu_hr_attendance_kiosk_no_user_mode" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [ref('group_tedi_hidden_menus')])]"/>
        </record>
        <record id="hr_attendance.menu_hr_attendance_view_attendances" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [ref('group_tedi_hidden_menus')])]"/>
        </record>
        <record id="hr_attendance.menu_hr_attendance_reporting" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [ref('group_tedi_hidden_menus')])]"/>
        </record>
        <record id="hr_attendance.menu_hr_attendance_settings" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [ref('group_tedi_hidden_menus')])]"/>
        </record>
    </data>
</odoo>