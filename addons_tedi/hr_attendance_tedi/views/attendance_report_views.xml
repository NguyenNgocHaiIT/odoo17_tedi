<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
       <record id="hr_leave_view_form_inherit_tedi" model="ir.ui.view">
            <field name="name">hr.leave.view.form.inherit.tedi</field>
            <field name="model">hr.leave</field>
            <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
            <field name="arch" type="xml">

                <xpath expr="//div[@name='title']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <xpath expr="//group[@name='col_left']/field[1]" position="before">
                    <field name="date_from"
                           string="Thời gian bắt đầu"
                           required="1"
                           readonly="state not in ['draft', 'confirm']"/>

                    <field name="date_to"
                           string="Thời gian kết thúc"
                           required="1"
                           readonly="state not in ['draft', 'confirm']"/>

                    <field name="employee_id" string="Người đề nghị" readonly="state not in ['draft', 'confirm']"/>
                    <field name="manager_id" string="Người phê duyệt" readonly="1" force_save="1"/>
                </xpath>

                <xpath expr="//div[hasclass('o_row')][.//field[@name='request_date_from']][1]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <xpath expr="//div[hasclass('o_row')][.//field[@name='request_date_from']][2]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <xpath expr="//label[@for='request_date_from'][1]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <xpath expr="//label[@for='request_date_from'][2]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <xpath expr="//field[@name='request_date_from']" position="attributes">
                     <attribute name="invisible">1</attribute>
                </xpath>

                <xpath expr="//field[@name='leave_type_support_document']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//label[@for='supported_attachment_ids']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='supported_attachment_ids']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <xpath expr="//div[hasclass('col_left')]" position="after">
                    <div class="o_hr_leave_column col-md-6 col-12">
                        <group>
                            <field name="holiday_status_id" string="Loại đơn báo" force_save="1"
                                domain="['|', ('requires_allocation', '=', 'no'), '&amp;', ('has_valid_allocation', '=', True), '&amp;', ('virtual_remaining_leaves', '&gt;', 0), ('allows_negative', '=', False)]"
                                context="{'employee_id': employee_id, 'default_date_from': date_from, 'default_date_to': date_to}"
                                options="{'no_create': True, 'no_open': True, 'request_type': 'leave'}"
                                readonly="state in ['cancel', 'refuse', 'validate', 'validate1']"/>

                            <field name="name" string="Nội dung" placeholder="Tôi muốn nghỉ phép..."/>

                            <field name="department_id" string="Bộ phận" force_save="1" readonly="1"/>

                            <label for="leaves_taken_count" string="Số ngày phép đã nghỉ"/>
                            <div class="o_row">
                                <field name="leaves_taken_count" class="oe_inline" nolabel="1" readonly="1"/>
                                <span class="ms-1">ngày</span>
                            </div>

                            <label for="remaining_leaves_count" string="Số ngày phép còn lại"/>
                            <div class="o_row">
                                <field name="remaining_leaves_count" class="oe_inline" nolabel="1" readonly="1"/>
                                <span class="ms-1">ngày</span>
                            </div>

                            <field name="request_date" invisible="1"/>
                        </group>
                    </div>
                </xpath>

                <xpath expr="//div[hasclass('o_row')][.//field[@name='request_unit_half']]" position="attributes"><attribute name="invisible">1</attribute></xpath>
                <xpath expr="//div[hasclass('o_row')][.//field[@name='request_hour_from']]" position="attributes"><attribute name="invisible">1</attribute></xpath>
                <xpath expr="//label[@for='number_of_days_display']" position="attributes"><attribute name="invisible">1</attribute></xpath>
                <xpath expr="//div[@name='duration_display']" position="attributes"><attribute name="invisible">1</attribute></xpath>

                <xpath expr="//group[@name='col_left']/field[@name='holiday_status_id']" position="attributes"><attribute name="invisible">1</attribute></xpath>

                <xpath expr="//group[@name='col_left']/field[@name='name']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <xpath expr="//sheet" position="inside">
                    <notebook>
                        <page string="Lịch sử nghỉ phép gần đây">
                            <field name="my_history_ids" readonly="1">
                                <tree create="0" delete="0" edit="0" decoration-muted="state == 'cancel'">
                                    <field name="holiday_status_id"/>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="duration_display" string="Thời lượng"/>
                                    <field name="state" widget="badge"
                                           decoration-info="state == 'draft'"
                                           decoration-warning="state in ('confirm','validate1')"
                                           decoration-success="state == 'validate'"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </xpath>
            </field>
        </record>

        <record id="hr_leave_view_form_manager_inherit_tedi" model="ir.ui.view">
            <field name="name">hr.leave.view.form.manager.inherit.tedi</field>
            <field name="model">hr.leave</field>
            <field name="inherit_id" ref="hr_holidays.hr_leave_view_form_manager"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='title']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='holiday_type'][@groups='hr_holidays.group_hr_holidays_user']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//div[hasclass('col_right')]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='name'][@widget='text']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>

        <record id="hr_leave_view_search_inherit_tedi" model="ir.ui.view">
            <field name="name">hr.leave.view.search.inherit.tedi</field>
            <field name="model">hr.leave</field>
            <field name="inherit_id" ref="hr_holidays.view_hr_holidays_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="employee_code"/>
                    <field name="report_title"/>
                </xpath>
            </field>
        </record>

        <record id="hr_leave_view_tree_inherit_tedi" model="ir.ui.view">
            <field name="name">hr.leave.view.tree.inherit.tedi</field>
            <field name="model">hr.leave</field>
            <field name="inherit_id" ref="hr_holidays.hr_leave_view_tree"/>
            <field name="arch" type="xml">
                 <xpath expr="//field[@name='employee_id']" position="after">
                    <field name="employee_code" optional="show"/>
                </xpath>
                <xpath expr="//field[@name='name']" position="after">
                    <field name="report_title" optional="hide"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>