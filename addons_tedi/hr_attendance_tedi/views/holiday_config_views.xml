<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_tedi_resource_calendar_leaves_tree" model="ir.ui.view">
            <field name="name">tedi.resource.calendar.leaves.tree</field>
            <field name="model">resource.calendar.leaves</field>
            <field name="arch" type="xml">
                <tree string="Cấu hình ngày nghỉ lễ" editable="bottom">
                    <field name="company_id" column_invisible="True"/>

                    <field name="name" string="Tên ngày lễ"/>
                    <field name="date_from" string="Từ ngày" widget="daterange"/>
                    <field name="date_to" string="Đến ngày"/>

                    <field name="resource_id" column_invisible="True"/>
                    <field name="calendar_id" column_invisible="True"/>
                </tree>
            </field>
        </record>

        <record id="view_tedi_resource_calendar_leaves_search" model="ir.ui.view">
            <field name="name">tedi.resource.calendar.leaves.search</field>
            <field name="model">resource.calendar.leaves</field>
            <field name="arch" type="xml">
                <search string="Tìm kiếm ngày nghỉ">
                    <field name="name"/>
                    <field name="date_from"/>
                    <filter string="Năm nay" name="this_year"
                            domain="[('date_from', '&gt;=', context_today().strftime('%Y-01-01')), ('date_from', '&lt;=', context_today().strftime('%Y-12-31'))]"/>
                    <group expand="0" string="Nhóm theo">
                        <filter string="Năm" name="group_by_year" context="{'group_by': 'date_from:year'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_tedi_holiday_config" model="ir.actions.act_window">
            <field name="name">Cấu hình ngày nghỉ lễ</field>
            <field name="res_model">resource.calendar.leaves</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_tedi_resource_calendar_leaves_tree"/>
            <field name="search_view_id" ref="view_tedi_resource_calendar_leaves_search"/>
            <field name="domain">[('resource_id', '=', False)]</field>
            <field name="context">{'default_resource_id': False}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Tạo mới ngày nghỉ lễ chung (Tết, Quốc Khánh...)
                </p>
            </field>
        </record>
    </data>
</odoo>