<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="group_time_off_unit_manager" model="res.groups">
            <field name="name">Unit Manager: Manage Department</field>
            <field name="category_id" ref="base.module_category_human_resources_time_off"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Allows approving time off requests for employees in the same department.</field>
        </record>

        <record id="hr_leave_rule_unit_manager" model="ir.rule">
            <field name="name">Time Off: Unit Manager (Department)</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave"/>
            <field name="groups" eval="[(4, ref('group_time_off_unit_manager'))]"/>
            <field name="domain_force">[
                '|',
                ('employee_id.user_id', '=', user.id),
                ('employee_id.department_id', 'child_of', user.employee_id.department_id.id)
            ]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="hr_leave_allocation_rule_unit_manager" model="ir.rule">
            <field name="name">Allocation: Unit Manager (Department)</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave_allocation"/>
            <field name="groups" eval="[(4, ref('group_time_off_unit_manager'))]"/>
            <field name="domain_force">[
                '|',
                ('employee_id.user_id', '=', user.id),
                ('employee_id.department_id', 'child_of', user.employee_id.department_id.id)
            ]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>