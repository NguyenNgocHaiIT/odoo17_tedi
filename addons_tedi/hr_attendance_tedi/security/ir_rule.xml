<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="group_time_off_unit_manager" model="res.groups">
            <field name="name">Unit Manager: Manage Department</field>
            <field name="category_id" ref="base.module_category_human_resources_time_off"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Chỉ được xem đơn của phòng ban mình quản lý.</field>
        </record>

        <record id="hr_holidays.group_hr_holidays_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_time_off_unit_manager'))]"/>
        </record>

        <record id="hr_leave_rule_unit_manager_read" model="ir.rule">
            <field name="name">Time Off: Unit Manager Read Department</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave"/>
            <field name="groups" eval="[(4, ref('group_time_off_unit_manager'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
            <field name="domain_force">['|',
                ('employee_id.user_id', '=', user.id),
                ('employee_id.department_id', '=', user.employee_id.department_id.id)
            ]</field>
        </record>

<!--        <record id="hr_holidays.hr_leave_rule_user_read" model="ir.rule">-->
<!--            <field name="active" eval="False"/>-->
<!--        </record>-->

        <record id="hr_holidays.menu_hr_holidays_root" model="ir.ui.menu">
            <field name="groups_id" eval="[(4, ref('group_time_off_unit_manager'))]"/>
        </record>

        <record id="hr_holidays.menu_hr_holidays_management" model="ir.ui.menu">
            <field name="groups_id" eval="[(4, ref('group_time_off_unit_manager'))]"/>
        </record>

        <record id="hr_holidays.menu_hr_holidays_dashboard" model="ir.ui.menu">
            <field name="groups_id" eval="[(4, ref('group_time_off_unit_manager'))]"/>
        </record>

    </data>
</odoo>