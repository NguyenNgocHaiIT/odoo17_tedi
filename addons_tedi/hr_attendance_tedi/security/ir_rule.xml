<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="group_time_off_unit_manager" model="res.groups">
            <field name="name">Unit Manager: Manage Department</field>
            <field name="category_id" ref="base.module_category_human_resources_time_off"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Chỉ dành cho Trưởng phòng/Ban. Có quyền xem toàn bộ đơn của phòng ban.</field>
        </record>

        <record id="hr_leave_rule_direct_manager_dynamic" model="ir.rule">
            <field name="name">Time Off: Direct Manager Visibility (Dynamic)</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
            <field name="domain_force">[
                '|',
                ('employee_id.user_id', '=', user.id),
                ('employee_id.parent_id.user_id', '=', user.id)
            ]</field>
        </record>

        <record id="hr_leave_rule_unit_manager_hierarchy" model="ir.rule">
            <field name="name">Time Off: Unit Manager (Dept Hierarchy Only)</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave"/>
            <field name="groups" eval="[(4, ref('group_time_off_unit_manager'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
            <field name="domain_force">[
                '|',
                ('employee_id.user_id', '=', user.id),
                '&amp;',
                ('employee_id.department_id', '!=', False),
                ('employee_id.department_id', 'child_of', user.employee_id.department_id.id)
            ]</field>
        </record>

        <record id="hr_holidays.menu_hr_holidays_root" model="ir.ui.menu">
            <field name="groups_id" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="hr_holidays.menu_hr_holidays_management" model="ir.ui.menu">
            <field name="groups_id" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="hr_holidays.menu_hr_holidays_dashboard" model="ir.ui.menu">
            <field name="groups_id" eval="[(4, ref('base.group_user'))]"/>
        </record>

    </data>
</odoo>