<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tedi_generate_work_entry_wizard_form" model="ir.ui.view">
        <field name="name">tedi.work.entry.generate.wizard.form</field>
        <field name="model">tedi.work.entry.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Tạo Mới Work Entry">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="employee_ids" widget="many2many_avatar_user"/>
                    </group>
                </group>

                <div class="alert alert-info" role="status">
                    Hệ thống sẽ sinh dữ liệu công cho khoảng thời gian này. Dữ liệu cũ (nếu có) sẽ được giữ nguyên.
                </div>

                <footer>
                    <button name="action_mass_regenerate" string="Xác nhận Tạo" type="object" class="btn-primary"/>
                    <button string="Hủy" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_tedi_generate_work_entry" model="ir.actions.act_window">
        <field name="name">Tạo Mới Work Entry</field>
        <field name="res_model">tedi.work.entry.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>