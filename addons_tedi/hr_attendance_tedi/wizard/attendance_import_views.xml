<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_tedi_attendance_import_wizard" model="ir.ui.view">
            <field name="name">tedi.attendance.import.wizard.form</field>
            <field name="model">tedi.attendance.import.wizard</field>
            <field name="arch" type="xml">
                <form string="Import Chấm công &amp; Nghỉ phép">
                    <div class="alert alert-info" role="alert">
                        <strong>Hướng dẫn cấu trúc file Excel:</strong><br/>
                        - Dòng tiêu đề ngày (1, 2, 3...) nằm ở dòng <strong>6</strong> (mặc định).<br/>
                        - Cột <strong>B</strong> (Cột 2): Mã nhân viên.<br/>
                        - Cột <strong>D</strong> (Cột 4): Bắt đầu dữ liệu Ngày 1.<br/>
                        <br/>
                        <strong>Quy tắc xử lý dữ liệu:</strong><br/>
                        - Ký hiệu <code>X, CT, +</code> hoặc <code>Giờ (08:00)</code>: Tạo dữ liệu Chấm công.<br/>
                        - Ký hiệu <code>P, Ô, TS...</code>: Tạo và Duyệt Đơn nghỉ phép (Tự trừ phép).<br/>
                        <br/>
                        <i>Lưu ý: Giờ vào/ra sẽ tự động lấy theo Hợp đồng và Lịch làm việc của nhân viên.</i>
                    </div>

                    <group>
                        <group string="Thời gian">
                            <field name="month"/>
                            <field name="year"/>
                        </group>
                        <group string="Cấu hình File">
                            <field name="file" filename="filename"/>
                            <field name="filename" invisible="1"/>
                            <field name="sheet_name" placeholder="Ví dụ: Tháng"/>
                            <field name="header_row"/>
                        </group>
                    </group>

                    <footer>
                        <button name="action_import"
                                type="object"
                                string="Thực hiện Import"
                                class="btn-primary"
                                data-hotkey="q"/>
                        <button string="Đóng" class="btn-secondary" special="cancel" data-hotkey="z"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_tedi_attendance_import" model="ir.actions.act_window">
            <field name="name">Import Chấm công Excel</field>
            <field name="res_model">tedi.attendance.import.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>