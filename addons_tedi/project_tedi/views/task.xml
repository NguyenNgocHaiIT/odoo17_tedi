<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <record id="view_task_form" model="ir.ui.view">
            <field name="name">view_task_form</field>
            <field name="model">project.task</field>
            <field name="arch" type="xml">
                <form delete="false" duplicate="false">
                    <header>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1 class="d-flex flex-row">
                                <field name="name" widget="text" class="o_text_overflow"/>
                            </h1>
                        </div>

                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_custom_task" model="ir.actions.act_window">
            <field name="name">Công việc</field>
            <field name="res_model">project.task</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'tree', 'view_id': ref('project.open_view_my_tasks_list_view')}),
                (0, 0, {'view_mode': 'kanban', 'view_id': ref('project.view_task_kanban_inherit_my_task')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_task_form')})]"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Tạo dự án mới
                </p>
            </field>
        </record>
    </data>
</odoo>