<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="0">

    <record id="module_category_training" model="ir.module.category">
        <field name="name">Training (Đào tạo)</field>
        <field name="description">Quản lý đào tạo nội bộ TEDI</field>
        <field name="sequence">10</field>
        <field name="parent_id" ref="base.module_category_human_resources"/>
    </record>

    <record id="group_training_participant" model="res.groups">
      <field name="name">Participant (Cán bộ tham gia)</field>
      <field name="category_id" ref="module_category_training"/>
      <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_training_unit_manager" model="res.groups">
      <field name="name">Unit Manager (Trưởng đơn vị)</field>
      <field name="category_id" ref="module_category_training"/>
      <field name="implied_ids" eval="[(4, ref('group_training_participant'))]"/>
    </record>

    <record id="group_training_general_director" model="res.groups">
      <field name="name">General Director (Tổng giám đốc)</field>
      <field name="category_id" ref="module_category_training"/>
      <field name="implied_ids" eval="[(4, ref('group_training_unit_manager'))]"/>
    </record>

    <record id="rr_training_plan_hr_all" model="ir.rule">
      <field name="name">Training Plan - HR ALL</field>
      <field name="model_id" ref="model_training_plan"/>
      <field name="groups" eval="[(4, ref('hr_recruitment.group_hr_recruitment_user'))]"/>
      <field name="domain_force">[(1, '=', 1)]</field>
      <field name="perm_read" eval="1"/>
      <field name="perm_write" eval="1"/>
      <field name="perm_create" eval="1"/>
      <field name="perm_unlink" eval="1"/>
    </record>

    <record id="rr_training_plan_general_director" model="ir.rule">
      <field name="name">Training Plan - General Director</field>
      <field name="model_id" ref="model_training_plan"/>
      <field name="groups" eval="[(4, ref('hr_training_tedi.group_training_general_director'))]"/>
      <field name="domain_force">[(1, '=', 1)]</field>
      <field name="perm_read" eval="1"/>
      <field name="perm_write" eval="0"/>
      <field name="perm_create" eval="0"/>
      <field name="perm_unlink" eval="0"/>
    </record>

    <record id="rr_training_plan_participation_detail_employee" model="ir.rule">
      <field name="name">Training Participation Detail - Participant Own</field>
      <field name="model_id" ref="model_training_plan_participation_detail"/>
      <field name="groups" eval="[(4, ref('hr_training_tedi.group_training_participant'))]"/>
      <field name="domain_force">[('user_id', '=', user.id)]</field>
      <field name="perm_read" eval="1"/>
      <field name="perm_write" eval="1"/>
      <field name="perm_create" eval="1"/>
      <field name="perm_unlink" eval="0"/>
    </record>

    <record id="rr_training_plan_participation_unit_manager" model="ir.rule">
      <field name="name">Training Participation - Unit Manager</field>
      <field name="model_id" ref="model_training_plan_participation"/>
      <field name="groups" eval="[(4, ref('hr_training_tedi.group_training_unit_manager'))]"/>
      <field name="domain_force">[(1, '=', 1)]</field>
      <field name="perm_read" eval="1"/>
      <field name="perm_write" eval="1"/>
      <field name="perm_create" eval="0"/>
      <field name="perm_unlink" eval="0"/>
    </record>

    <record id="rr_trainings_needs_participant_own" model="ir.rule">
      <field name="name">Training Needs - Participant Own</field>
      <field name="model_id" ref="model_trainings_needs"/>
      <field name="groups" eval="[(4, ref('hr_training_tedi.group_training_participant'))]"/>
      <field name="domain_force">[('user_id', '=', user.id)]</field>
      <field name="perm_read" eval="1"/>
      <field name="perm_write" eval="1"/>
      <field name="perm_create" eval="1"/>
      <field name="perm_unlink" eval="0"/>
    </record>

    <record id="rr_trainings_needs_hr_all" model="ir.rule">
      <field name="name">Training Needs - HR ALL</field>
      <field name="model_id" ref="model_trainings_needs"/>
      <field name="groups" eval="[(4, ref('hr_recruitment.group_hr_recruitment_user'))]"/>
      <field name="domain_force">[(1, '=', 1)]</field>
      <field name="perm_read" eval="1"/>
      <field name="perm_write" eval="1"/>
      <field name="perm_create" eval="1"/>
      <field name="perm_unlink" eval="1"/>
    </record>

    <record id="rr_trainings_needs_general_director" model="ir.rule">
      <field name="name">Training Needs - General Director</field>
      <field name="model_id" ref="model_trainings_needs"/>
      <field name="groups" eval="[(4, ref('hr_training_tedi.group_training_general_director'))]"/>
      <field name="domain_force">[(1, '=', 1)]</field>
      <field name="perm_read" eval="1"/>
      <field name="perm_write" eval="0"/>
      <field name="perm_create" eval="0"/>
      <field name="perm_unlink" eval="0"/>
    </record>

    <record id="rr_trainings_needs_unit_manager" model="ir.rule">
      <field name="name">Training Needs - Unit Manager</field>
      <field name="model_id" ref="model_trainings_needs"/>
      <field name="groups" eval="[(4, ref('hr_training_tedi.group_training_unit_manager'))]"/>
      <field name="domain_force">[(1, '=', 1)]</field>
      <field name="perm_read" eval="1"/>
      <field name="perm_write" eval="1"/>
      <field name="perm_create" eval="0"/>
      <field name="perm_unlink" eval="0"/>
    </record>

  </data>
</odoo>