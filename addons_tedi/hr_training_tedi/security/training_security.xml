<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="0">

    <record id="module_category_training" model="ir.module.category">
        <field name="name">Training (Đào tạo)</field>
        <field name="description">Quản lý đào tạo nội bộ TEDI</field>
        <field name="sequence">10</field>
        <field name="parent_id" ref="base.module_category_human_resources"/>
    </record>

    <record id="group_training_participant" model="res.groups">
      <field name="name">Participant (Cán bộ tham gia)</field>
      <field name="category_id" ref="module_category_training"/>
      <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_training_unit_manager" model="res.groups">
      <field name="name">Unit Manager (Trưởng đơn vị)</field>
      <field name="category_id" ref="module_category_training"/>
      <field name="implied_ids" eval="[(4, ref('group_training_participant'))]"/>
    </record>

    <record id="group_training_manager" model="res.groups">
      <field name="name">Manager (Quản lý nghiệp vụ)</field>
      <field name="category_id" ref="module_category_training"/>
      <field name="implied_ids" eval="[(4, ref('group_training_unit_manager'))]"/>
    </record>

    <record id="group_training_general_director" model="res.groups">
      <field name="name">General Director (Tổng giám đốc)</field>
      <field name="category_id" ref="module_category_training"/>
      <field name="implied_ids" eval="[(4, ref('group_training_manager'))]"/>
    </record>

    <record id="group_training_admin" model="res.groups">
      <field name="name">Administrator (Quản trị hệ thống)</field>
      <field name="category_id" ref="module_category_training"/>
      <field name="implied_ids" eval="[(4, ref('group_training_general_director'))]"/>
      <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>


    <record id="rr_training_needs_survey_manager_all" model="ir.rule">
        <field name="name">Survey: Manager/Admin Full Access</field>
        <field name="model_id" ref="model_training_needs_survey"/>
        <field name="groups" eval="[(4, ref('group_training_manager')), (4, ref('group_training_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>

    <record id="rr_training_needs_survey_participant_read" model="ir.rule">
        <field name="name">Survey: Participant Read Only</field>
        <field name="model_id" ref="model_training_needs_survey"/>
        <field name="groups" eval="[(4, ref('group_training_participant'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>


    <record id="rr_training_needs_manager_all" model="ir.rule">
        <field name="name">Needs: Manager/Admin Full Access</field>
        <field name="model_id" ref="model_trainings_needs"/>
        <field name="groups" eval="[(4, ref('group_training_manager')), (4, ref('group_training_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>

    <record id="rr_training_needs_personal" model="ir.rule">
        <field name="name">Needs: Personal (Own Documents)</field>
        <field name="model_id" ref="model_trainings_needs"/>
        <field name="groups" eval="[(4, ref('group_training_participant'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <record id="rr_training_needs_unit_manager_approve" model="ir.rule">
        <field name="name">Needs: Unit Manager Approve (Department Scope)</field>
        <field name="model_id" ref="model_trainings_needs"/>
        <field name="groups" eval="[(4, ref('group_training_unit_manager'))]"/>
        <field name="domain_force">[('user_id.employee_id.department_id', 'child_of', user.employee_id.department_id.id)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>


    <record id="rr_training_plan_admin_all" model="ir.rule">
        <field name="name">Training Plan: Admin sees all</field>
        <field name="model_id" ref="model_training_plan"/>
        <field name="groups" eval="[(4, ref('group_training_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>

    <record id="rr_training_plan_manager_all" model="ir.rule">
      <field name="name">Training Plan: Manager sees all</field>
      <field name="model_id" ref="model_training_plan"/>
      <field name="groups" eval="[(4, ref('group_training_manager'))]"/>
      <field name="domain_force">[(1, '=', 1)]</field>
      <field name="perm_read" eval="1"/>
      <field name="perm_write" eval="1"/>
      <field name="perm_create" eval="1"/>
      <field name="perm_unlink" eval="1"/>
    </record>

    </data>
</odoo>