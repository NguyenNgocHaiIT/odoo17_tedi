<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="0">

    <!-- ==== GROUPS ĐÀO TẠO ==== -->

    <!-- Cán bộ tham gia đào tạo -->
    <record id="group_training_participant" model="res.groups">
      <field name="name">Training: Participant (Cán bộ tham gia đào tạo)</field>
      <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <!-- Trưởng đơn vị -->
    <record id="group_training_unit_manager" model="res.groups">
      <field name="name">Training: Unit Manager (Trưởng đơn vị)</field>
      <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <!-- Tổng giám đốc -->
    <record id="group_training_general_director" model="res.groups">
      <field name="name">Training: General Director (Tổng giám đốc)</field>
      <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <!-- HR (TCCB-LĐ) dùng lại group hr_recruitment.group_recruitment_hr_officer -->

    <!-- ==== RULES CHO KẾ HOẠCH ĐÀO TẠO ==== -->

    <!-- HR (TCCB-LĐ): xem + sửa toàn bộ kế hoạch đào tạo -->
    <record id="rr_training_plan_hr_all" model="ir.rule">
      <field name="name">Training Plan - HR ALL</field>
      <field name="model_id" ref="model_training_plan"/>
      <field name="groups" eval="[(4, ref('quan_ly_tuyen_dung.group_recruitment_hr_officer'))]"/>
      <field name="domain_force">[(1, '=', 1)]</field>
      <field name="perm_read" eval="1"/>
      <field name="perm_write" eval="1"/>
      <field name="perm_create" eval="1"/>
      <field name="perm_unlink" eval="0"/>
    </record>

    <!-- Tổng giám đốc: chỉ xem tất cả kế hoạch đào tạo -->
    <record id="rr_training_plan_general_director" model="ir.rule">
      <field name="name">Training Plan - General Director</field>
      <field name="model_id" ref="model_training_plan"/>
      <field name="groups" eval="[(4, ref('hr_training_tedi.group_training_general_director'))]"/>
      <field name="domain_force">[(1, '=', 1)]</field>
      <field name="perm_read" eval="1"/>
      <field name="perm_write" eval="0"/>
      <field name="perm_create" eval="0"/>
      <field name="perm_unlink" eval="0"/>
    </record>

<!-- Cán bộ tham gia đào tạo: chỉ xem dòng đăng ký của chính mình -->
    <record id="rr_training_plan_participation_detail_employee" model="ir.rule">
      <field name="name">Training Participation Detail - Participant</field>
      <!-- CHỈNH model_id SANG DETAIL -->
      <field name="model_id" ref="model_training_plan_participation_detail"/>
      <field name="groups" eval="[(4, ref('hr_training_tedi.group_training_participant'))]"/>
      <field name="domain_force">[('user_id', '=', user.id)]</field>
      <field name="perm_read" eval="1"/>
      <field name="perm_write" eval="1"/>
      <field name="perm_create" eval="1"/>
      <field name="perm_unlink" eval="0"/>
    </record>


    <!-- Trưởng đơn vị: xem/duyệt đăng ký trong đơn vị mình -->
    <record id="rr_training_plan_participation_unit_manager" model="ir.rule">
      <field name="name">Training Participation - Unit Manager</field>
      <field name="model_id" ref="model_training_plan_participation"/>
      <field name="groups" eval="[(4, ref('hr_training_tedi.group_training_unit_manager'))]"/>
      <!-- Tạm thời để 1=1, sau này nếu có field department_id thì sửa domain -->
      <field name="domain_force">[(1, '=', 1)]</field>
      <field name="perm_read" eval="1"/>
      <field name="perm_write" eval="1"/>
      <field name="perm_create" eval="0"/>
      <field name="perm_unlink" eval="0"/>
    </record>


       <!-- Participant: chỉ xem / sửa / tạo phiếu của chính mình -->
    <record id="rr_trainings_needs_participant_own" model="ir.rule">
      <field name="name">Training Needs - Participant own</field>
      <field name="model_id" ref="model_trainings_needs"/>
      <field name="groups" eval="[(4, ref('hr_training_tedi.group_training_participant'))]"/>
      <!-- Chỉ thấy các phiếu mà user_id = user đang đăng nhập -->
      <field name="domain_force">[('user_id', '=', user.id)]</field>
      <field name="perm_read" eval="1"/>
      <field name="perm_write" eval="1"/>
      <field name="perm_create" eval="1"/>
      <field name="perm_unlink" eval="0"/>
    </record>

    <!-- HR: xem/sửa tất cả phiếu nhu cầu -->
    <record id="rr_trainings_needs_hr_all" model="ir.rule">
      <field name="name">Training Needs - HR ALL</field>
      <field name="model_id" ref="model_trainings_needs"/>
      <field name="groups" eval="[(4, ref('quan_ly_tuyen_dung.group_recruitment_hr_officer'))]"/>
      <field name="domain_force">[(1, '=', 1)]</field>
      <field name="perm_read" eval="1"/>
      <field name="perm_write" eval="1"/>
      <field name="perm_create" eval="1"/>
      <field name="perm_unlink" eval="1"/>
    </record>

    <!-- Giám đốc: chỉ đọc tất cả phiếu nhu cầu -->
    <record id="rr_trainings_needs_general_director" model="ir.rule">
      <field name="name">Training Needs - General Director</field>
      <field name="model_id" ref="model_trainings_needs"/>
      <field name="groups" eval="[(4, ref('hr_training_tedi.group_training_general_director'))]"/>
      <field name="domain_force">[(1, '=', 1)]</field>
      <field name="perm_read" eval="1"/>
      <field name="perm_write" eval="0"/>
      <field name="perm_create" eval="0"/>
      <field name="perm_unlink" eval="0"/>
    </record>

    <!-- Trưởng đơn vị: tạm cho xem/duyệt tất cả, sau này có department_id thì siết lại -->
    <record id="rr_trainings_needs_unit_manager" model="ir.rule">
      <field name="name">Training Needs - Unit Manager</field>
      <field name="model_id" ref="model_trainings_needs"/>
      <field name="groups" eval="[(4, ref('hr_training_tedi.group_training_unit_manager'))]"/>
      <field name="domain_force">[(1, '=', 1)]</field>
      <field name="perm_read" eval="1"/>
      <field name="perm_write" eval="1"/>
      <field name="perm_create" eval="0"/>
      <field name="perm_unlink" eval="0"/>
    </record>


   <record id="rr_trainings_needs_line_participant_own" model="ir.rule">
      <field name="name">Training Needs Line - Participant own</field>
      <field name="model_id" ref="model_trainings_needs_line"/>
      <field name="groups" eval="[(4, ref('hr_training_tedi.group_training_participant'))]"/>
      <!-- Chỉ thấy dòng chi tiết thuộc phiếu mà user_id = user.current -->
      <field name="domain_force">
        [('training_needs_id.user_id', '=', user.id)]
      </field>
      <field name="perm_read" eval="1"/>
      <field name="perm_write" eval="1"/>
      <field name="perm_create" eval="1"/>
      <field name="perm_unlink" eval="0"/>
    </record>



  </data>
</odoo>
