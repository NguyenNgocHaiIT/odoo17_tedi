<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <record id="ir_cron_training_needs_survey_auto_state_2" model="ir.cron">
            <field name="name">Training Needs Survey: Auto Update States</field>
            <field name="model_id" ref="model_training_needs_survey"/>
            <field name="state">code</field>
            <field name="code">model._cron_update_survey_states()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>

            <field name="user_id" ref="base.user_root"/>
            <field name="active">True</field>

            <field name="priority">5</field>
        </record>

        <record id="ir_cron_update_training_state" model="ir.cron">
            <field name="name">Cập nhật trạng thái đào tạo hàng ngày</field>
            <field name="model_id" ref="model_training_plan_participation"/>
            <field name="state">code</field>
            <field name="code">model._cron_update_training_state()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
        </record>

    </data>
</odoo>
