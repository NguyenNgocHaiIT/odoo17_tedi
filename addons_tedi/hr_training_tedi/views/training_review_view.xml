<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_training_review_tree" model="ir.ui.view">
        <field name="name">training.review.tree</field>
        <field name="model">training.review</field>
        <field name="arch" type="xml">
            <tree string="Đánh giá khoá đào tạo">
                <field name="training_plan_id" class="text-start"/>
                <field name="training_plan_detail_id" class="text-start"/>
                <field name="training_center" class="text-start"/>
                <field name="start_date" class="text-start"/>
                <field name="end_date" class="text-start"/>
                <field name="user_id" class="text-start"/>
            </tree>
        </field>
    </record>

    <record id="view_training_review_form" model="ir.ui.view">
        <field name="name">training.review.form</field>
        <field name="model">training.review</field>
        <field name="arch" type="xml">
            <form string="Đánh giá khoá đào tạo">
                <sheet>
                    <group>
                        <group>
                            <field name="training_plan_id" required="1" class="text-start"/>
                            <field name="training_plan_detail_id" required="1" class="text-start"/>
                            <field name="training_center" readonly="1" class="text-start"/>
                        </group>
                        <group>
                            <field name="start_date" class="text-start"/>
                            <field name="end_date" class="text-start"/>
                            <field name="user_id" readonly="1" class="text-start"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Nội dung đánh giá">
                            <field name="review_detail_ids">
                                <tree editable="bottom" string="Đánh giá chi tiết">
                                    <field name="review_content" class="text-start"/>
                                    <field name="training_rating" class="text-start"/>
                                    <field name="note" class="text-start"/>
                                </tree>

                                <form string="Đánh giá chi tiết">
                                    <group>
                                        <field name="review_content" class="text-start"/>
                                        <field name="training_rating" class="text-start"/>
                                        <field name="note" class="text-start"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_training_review" model="ir.actions.act_window">
        <field name="name">Đánh giá khoá đào tạo</field>
        <field name="res_model">training.review</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_id': ref('view_training_review_tree'), 'view_mode': 'tree'}),
            (0, 0, {'view_id': ref('view_training_review_form'), 'view_mode': 'form'}),
        ]"/>
    </record>

    <record id="action_training_review_my" model="ir.actions.act_window">
        <field name="name">Đánh giá của tôi</field>
        <field name="res_model">training.review</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="view_ids" eval="[
                (5, 0, 0),
                (0, 0, {'view_id': ref('view_training_review_tree'), 'view_mode': 'tree'}),
                (0, 0, {'view_id': ref('view_training_review_form'), 'view_mode': 'form'}),
            ]"/>
    </record>

    <record id="action_training_review_all" model="ir.actions.act_window">
        <field name="name">Tất cả đánh giá</field>
        <field name="res_model">training.review</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="view_ids" eval="[
                (5, 0, 0),
                (0, 0, {'view_id': ref('view_training_review_tree'), 'view_mode': 'tree'}),
                (0, 0, {'view_id': ref('view_training_review_form'), 'view_mode': 'form'}),
           ]"/>
    </record>

</odoo>