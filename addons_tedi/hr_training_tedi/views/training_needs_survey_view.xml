<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="training_needs_survey_tree" model="ir.ui.view">
        <field name="name">training_needs_survey_tree</field>
        <field name="model">training.needs.survey</field>
        <field name="arch" type="xml">
            <tree string="Yêu cầu đăng ký đào tạo">
                <field name="name" string="Tên đợt đăng ký" class="text-start"/>
                <field name="create_date" string="Ngày tạo" class="text-start"/>
                <field name="start_date" string="Từ ngày" class="text-start"/>
                <field name="end_date" string="Đến ngày" class="text-start"/>
                <field name="user_id" string="Người tạo" class="text-start"/>
                <field name="state"
                       string="Trạng thái"
                       widget="badge"
                       decoration-danger="state == 'draft'"
                       decoration-warning="state == 'in_process'"
                       decoration-success="state == 'end'"
                       class="text-start"/>
            </tree>
        </field>
    </record>

    <record id="training_needs_survey_form" model="ir.ui.view">
        <field name="name">training_needs_survey_form</field>
        <field name="model">training.needs.survey</field>
        <field name="arch" type="xml">
            <form string="Yêu cầu đăng ký đào tạo">
                <field name="state" invisible="1"/>

                <header>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,confirmed,in_process,end"/>

                    <button name="action_submit"
                            type="object"
                            string="Xác nhận"
                            class="btn-primary"
                            groups="hr_training_tedi.group_training_manager"
                            invisible="state != 'draft'"/>

                    <button name="action_end"
                            string="Kết thúc"
                            type="object"
                            class="btn-secondary"
                            groups="hr_training_tedi.group_training_manager"
                            confirm="Bạn có chắc chắn muốn kết thúc khảo sát này ngay lập tức?"
                            invisible="state != 'in_process'"/>

                    <button name="action_start_survey"
                            string="Bắt đầu"
                            type="object"
                            class="btn-primary"
                            confirm="Bạn có chắc chắn muốn bắt đầu khảo sát này ngay lập tức?"
                            groups="hr_training_tedi.group_training_manager"
                            invisible="state != 'confirmed'"/>
                </header>

                <sheet>
                    <group readonly="state == 'end'">
                        <group>
                            <field name="name" required="1" readonly="state != 'draft'" class="text-start"/>
                            <field name="user_id" required="1" readonly="1" class="text-start"/>
                        </group>

                        <group>
                            <field name="create_date" readonly="1" widget="date" class="text-start"/>
                            <label for="start_date" string="Thời gian khảo sát" readonly="state == 'end'"/>
                            <div class="o_row">
                                <field name="start_date" widget="date" readonly="state != 'draft'" class="text-start"/>
                                <span style="margin: 0 10px;">→</span>
                                <field name="end_date" widget="date" readonly="state != 'draft'" class="text-start"/>
                            </div>
                        </group>
                    </group>
                </sheet>

            </form>
        </field>
    </record>

    <record id="action_training_needs_survey" model="ir.actions.act_window">
        <field name="name">Yêu cầu đăng ký đào tạo</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">training.needs.survey</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_id': ref('training_needs_survey_tree'), 'view_mode': 'tree'}),
            (0, 0, {'view_id': ref('training_needs_survey_form'), 'view_mode': 'form'})
        ]"/>
    </record>

</odoo>