<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- TREE GIỮ NGUYÊN -->
    <record id="training_needs_survey_tree" model="ir.ui.view">
        <field name="name">training_needs_survey_tree</field>
        <field name="model">training.needs.survey</field>
        <field name="arch" type="xml">
            <tree string="Khảo sát nhu cầu đào tạo">
                <field name="name" string="Tên đợt khảo sát" class="text-center"/>
                <field name="create_date" string="Ngày tạo" class="text-center"/>
                <field name="start_date" string="Từ ngày" class="text-center"/>
                <field name="end_date" string="Đến ngày" class="text-center"/>
                <field name="user_id" string="Người tạo" class="text-center"/>
                <field name="state"
                       string="Trạng thái"
                       widget="badge"
                       decoration-danger="state == 'draft'"
                       decoration-warning="state == 'in_process'"
                       decoration-success="state == 'end'"
                       class="text-center"/>
            </tree>
        </field>
    </record>

    <!-- FORM -->
    <record id="training_needs_survey_form" model="ir.ui.view">
        <field name="name">training_needs_survey_form</field>
        <field name="model">training.needs.survey</field>
        <field name="arch" type="xml">
            <form string="Khảo sát nhu cầu đào tạo">
                <!-- state ẩn để dùng cho statusbar -->
                <field name="state" invisible="1"/>

                <header>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,in_process,end"/>

                    <!-- Nút xác nhận: từ draft -> in_process, set start_date = hôm nay -->
                    <button name="action_submit"
                            type="object"
                            string="Xác nhận"
                            class="btn-primary"
                            groups="quan_ly_tuyen_dung.group_recruitment_hr_officer"
                            invisible="state != 'draft'"/>
                </header>

                  <sheet>
                <!-- KHÓA TOÀN BỘ FORM KHI state = end -->
                    <group readonly="state == 'end'">
                        <group>
                            <field name="name" required="1" readonly="state == 'end'"/>
                            <field name="user_id" required="1" readonly="1"/>
                        </group>

                        <group>
                            <field name="create_date" readonly="1" widget="date" />
                            <label for="start_date" string="Thời gian khảo sát" readonly="state == 'end'"/>
                            <div class="o_row">
                                <field name="start_date" widget="date" readonly="state == 'end'"/>
                                <span style="margin: 0 10px;">→</span>
                                <field name="end_date" widget="date" readonly="state == 'end'"/>
                            </div>
                        </group>
                    </group>
                </sheet>

            </form>
        </field>
    </record>

    <!-- ACTION: GẮN SẴN TREE + FORM -->
    <record id="action_training_needs_survey" model="ir.actions.act_window">
        <field name="name">Khảo sát nhu cầu đào tạo</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">training.needs.survey</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_id': ref('training_needs_survey_tree'), 'view_mode': 'tree'}),
            (0, 0, {'view_id': ref('training_needs_survey_form'), 'view_mode': 'form'})
        ]"/>
    </record>

</odoo>
