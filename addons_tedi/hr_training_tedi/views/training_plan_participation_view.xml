<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_training_participation_tree" model="ir.ui.view">
        <field name="name">training.plan.participation.tree</field>
        <field name="model">training.plan.participation</field>
        <field name="arch" type="xml">
            <tree string="Đợt đăng ký đào tạo"
                  decoration-muted="state == 'not_started'"
                  decoration-success="state == 'in_progress'"
                  decoration-info="state == 'finished'">

                <field name="training_plan_id" class="text-start"/>
                <field name="training_plan_detail_id" class="text-start"/>

                <field name="start_date" optional="show" class="text-start"/>
                <field name="end_date" optional="hide" class="text-start"/>

                <field name="training_total_fee" sum="Tổng cộng" widget="monetary" class="text-start"/>

                <field name="state" widget="badge"
                       decoration-muted="state == 'not_started'"
                       decoration-success="state == 'in_progress'"
                       decoration-info="state == 'finished'"
                       class="text-start"/>

                <field name="currency_id" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_training_participation_form" model="ir.ui.view">
        <field name="name">training.plan.participation.form</field>
        <field name="model">training.plan.participation</field>
        <field name="arch" type="xml">
            <form string="Đợt đăng ký đào tạo">
                <header>
                    <button name="action_start"
                            string="Bắt đầu ngay"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'not_started' or plan_state != 'approved'"/>

                    <button name="action_end"
                            string="Kết thúc đào tạo"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'in_progress'"
                            confirm="Xác nhận kết thúc khoá đào tạo hôm nay?"/>

                    <field name="state" widget="statusbar" statusbar_visible="not_started,in_progress,finished"/>
                </header>
                <sheet>
                    <group>
                        <group string="Thông tin chung">
                            <field name="plan_state" invisible="1"/>

                            <field name="training_plan_id" readonly="1" class="text-start"/>
                            <field name="training_plan_detail_id" readonly="1" class="text-start"/>
                            <field name="training_location" class="text-start"/>
                        </group>
                        <group string="Chi tiết thời gian">
                            <field name="start_date" class="text-start"/>
                            <field name="end_date" class="text-start"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="training_total_fee" widget="monetary" class="text-start"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Danh sách đăng ký">
                            <field name="participation_detail_ids">
                                <tree editable="bottom">
                                    <field name="user_id" class="text-start"/>
                                    <field name="department_id" class="text-start"/>
                                    <field name="training_fee_per_person" widget="monetary" sum="Tổng" class="text-start"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="note" class="text-start"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_training_participation" model="ir.actions.act_window">
        <field name="name">Đợt đăng ký đào tạo</field>
        <field name="res_model">training.plan.participation</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids" eval="[
                (5, 0, 0),
                (0, 0, {'view_id': ref('view_training_participation_tree'), 'view_mode': 'tree'}),
                (0, 0, {'view_id': ref('view_training_participation_form'), 'view_mode': 'form'}),
            ]"/>
    </record>
</odoo>