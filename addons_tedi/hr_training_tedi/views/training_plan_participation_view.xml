<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_training_participation_tree" model="ir.ui.view">
        <field name="name">training.plan.participation.tree</field>
        <field name="model">training.plan.participation</field>
        <field name="arch" type="xml">
            <tree string="Lớp đào tạo"
                  default_order="create_date desc"
                  decoration-muted="state == 'not_started'"
                  decoration-success="state == 'in_progress'"
                  decoration-info="state == 'finished'">

                <field name="training_plan_id" class="text-start"/>
                <field name="training_plan_detail_id" class="text-start"/>

                <field name="create_date" string="Ngày tạo"/>

                <field name="start_date" optional="show" class="text-start"/>
                <field name="end_date" optional="hide" class="text-start"/>

                <field name="training_total_fee" sum="Tổng cộng" widget="monetary" class="text-start"/>

                <field name="state" widget="badge"
                       decoration-muted="state == 'not_started'"
                       decoration-success="state == 'in_progress'"
                       decoration-info="state == 'finished'"
                       class="text-start"/>

                <field name="currency_id" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_training_participation_form" model="ir.ui.view">
    <field name="name">training.plan.participation.form</field>
    <field name="model">training.plan.participation</field>
    <field name="arch" type="xml">
        <form string="Lớp đào tạo">
            <header>
                <button name="action_submit" string="Trình duyệt" type="object" class="btn-primary"
                        groups="hr_training_tedi.group_training_manager"
                        invisible="state != 'draft' or not has_schedule"/>

                <button name="action_open_schedule_popup" string="Tạo lịch đào tạo" type="object" class="btn-primary oe_highlight"
                        groups="hr_training_tedi.group_training_manager"
                        invisible="state != 'draft'"/>

                <button name="action_approve" string="Phê duyệt" type="object" class="btn-success"
                        groups="hr_training_tedi.group_training_general_director"
                        invisible="state != 'pending'"/>

                <button name="action_reject" string="Từ chối" type="object" class="btn-danger"
                        groups="hr_training_tedi.group_training_general_director"
                        invisible="state != 'pending'"/>

                <button name="action_draft" string="Cần điều chỉnh" type="object" class="btn-secondary"
                        groups="hr_training_tedi.group_training_general_director,hr_training_tedi.group_training_manager"
                        invisible="state in ['draft', 'in_progress', 'finished']"
                        confirm="Bạn có chắc chắn muốn chuyển về trạng thái Dự thảo để sửa đổi?"/>

                <button name="action_start" string="Bắt đầu lớp học" type="object" class="oe_highlight"
                        groups="hr_training_tedi.group_training_manager"
                        invisible="state != 'approved'"/>

                <button name="action_open_attendance_popup" string="Điểm danh" type="object" class="btn-secondary"
                        groups="hr_training_tedi.group_training_manager"
                        invisible="state != 'in_progress'"/>

                <button name="action_end" string="Kết thúc đào tạo" type="object" class="btn-warning"
                        groups="hr_training_tedi.group_training_manager"
                        invisible="state != 'in_progress'" confirm="Xác nhận kết thúc khoá đào tạo?"/>

                <button name="action_open_result_wizard_bulk" string="Cập nhật Kết quả" type="object" class="btn-primary"
                        groups="hr_training_tedi.group_training_manager"
                        invisible="state not in ['in_progress', 'finished']"/>

                <field name="state" widget="statusbar" statusbar_visible="draft,pending,approved,in_progress,finished"/>
            </header>
            <sheet>
                <field name="has_schedule" invisible="1"/>

                <group>
                    <group string="Thông tin chung">
                        <field name="plan_state" invisible="1"/>
                        <field name="training_plan_id" readonly="state != 'draft'"/>
                        <field name="training_plan_detail_id" readonly="state != 'draft'"/>
                        <field name="training_location" readonly="state != 'draft'"/>
                    </group>
                    <group string="Chi tiết thời gian">
                        <field name="start_date" readonly="state != 'draft'"/>
                        <field name="end_date" readonly="state != 'draft'"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="training_total_fee" widget="monetary"/>
                    </group>
                </group>

                <notebook>
                    <page string="Danh sách học viên">
                        <field name="participation_detail_ids">
                            <tree editable="bottom" create="0">
                                <field name="user_id" readonly="parent.state != 'draft'"/>
                                <field name="department_id"/>
                                <field name="training_result" widget="badge"
                                       decoration-success="training_result == 'pass'"
                                       decoration-danger="training_result == 'fail'"
                                       readonly="1"/>
                                <field name="training_fee_per_person" widget="monetary" sum="Tổng"/>
                                <field name="currency_id" column_invisible="1"/>
                                <field name="note"/>
                            </tree>
                        </field>
                    </page>

                    <page string="Lịch đào tạo" invisible="state == 'draft'">
                        <field name="schedule_ids" readonly="1">
                            <tree editable="bottom">
                                <field name="date"/>
                                <field name="start_hour" widget="float_time"/>
                                <field name="end_hour" widget="float_time"/>
                                <field name="attendance_ids" column_invisible="1"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
            </sheet>
        </form>
    </field>
</record>

        <record id="view_training_result_wizard_form" model="ir.ui.view">
            <field name="name">training.result.wizard.form</field>
            <field name="model">training.result.wizard</field>
            <field name="arch" type="xml">
                <form string="Cập nhật kết quả hàng loạt">
                    <sheet>
                        <group>
                            <field name="participation_id"/>
                        </group>
                        <field name="line_ids">
                            <tree editable="top" create="0" delete="0">
                                <field name="detail_id" column_invisible="1"/>

                                <field name="user_id"/>
                                <field name="department_id" optional="hide"/>
                                <field name="note" optional="hide"/>

                                <field name="training_result"/>
                            </tree>
                        </field>
                    </sheet>
                    <footer>
                        <button string="Lưu tất cả" name="action_apply" type="object" class="btn-primary"/>
                        <button string="Hủy" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    <record id="action_training_participation" model="ir.actions.act_window">
        <field name="name">Lớp đào tạo</field>
        <field name="res_model">training.plan.participation</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids" eval="[
                (5, 0, 0),
                (0, 0, {'view_id': ref('view_training_participation_tree'), 'view_mode': 'tree'}),
                (0, 0, {'view_id': ref('view_training_participation_form'), 'view_mode': 'form'}),
            ]"/>
    </record>
</odoo>