<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_training_participation_tree" model="ir.ui.view">
        <field name="name">training.plan.participation.tree</field>
        <field name="model">training.plan.participation</field>
        <field name="arch" type="xml">
            <tree string="Đợt đăng ký đào tạo">
                <field name="training_plan_id" class="text-center"/>
                <field name="training_plan_detail_id" class="text-center"/>

                <field name="start_date" optional="show"/>
                <field name="end_date" optional="hide"/>
                <field name="training_location" optional="hide"/>
                <field name="training_total_fee" sum="Tổng cộng" widget="monetary"/>

                <field name="open_date" class="text-center" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </tree>
        </field>
    </record>

     <record id="view_training_participation_form" model="ir.ui.view">
        <field name="name">training.plan.participation.form</field>
        <field name="model">training.plan.participation</field>
        <field name="arch" type="xml">
            <form string="Đợt đăng ký đào tạo">
                <sheet>
                    <group>
                        <group string="Thông tin chung">
                            <field name="training_plan_id" required="1"/>
                            <field name="training_plan_detail_id" required="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="training_location"/>
                        </group>
                        <group string="Chi tiết đào tạo">
                            <field name="start_date" widget="date" />
                            <field name="end_date" widget="date"/>
                            <field name="training_fee_per_person" widget="monetary"/>
                            <field name="training_total_fee" widget="monetary" decoration-bf="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Danh sách đăng ký">
                            <field name="participation_detail_ids">
                                <tree editable="bottom" string="Đăng ký tham gia">
                                    <field name="user_id" width="200px"/>
                                    <field name="department_id" width="150px"/>

                                    <field name="training_time" optional="show"/>

                                    <field name="training_type" optional="show"/>

                                    <field name="training_fee_per_person" widget="monetary" sum="Tổng" optional="show"/>
                                    <field name="currency_id" column_invisible="1"/>

                                    <field name="note" optional="show"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_training_participation" model="ir.actions.act_window">
        <field name="name">Đợt đăng ký đào tạo</field>
        <field name="res_model">training.plan.participation</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids" eval="[
                (5, 0, 0),
                (0, 0, {'view_id': ref('view_training_participation_tree'), 'view_mode': 'tree'}),
                (0, 0, {'view_id': ref('view_training_participation_form'), 'view_mode': 'form'}),
            ]"/>
    </record>

</odoo>