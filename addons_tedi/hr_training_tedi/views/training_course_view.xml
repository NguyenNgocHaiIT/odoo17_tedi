<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="training_course_tree" model="ir.ui.view">
        <field name="name">training_course_tree</field>
        <field name="model">training.course</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name" string="Tên khoá đào tạo" class="text-start"/>
                <field name="type" string="Hình thức" class="text-start"/>
                <field name="training_field_id" string="Nhóm đào tạo" class="text-start"/>
                <field name="training_level" string="Mức độ" class="text-start"/>
            </tree>
        </field>
    </record>

    <record id="training_course_form" model="ir.ui.view">
        <field name="name">training_course_form</field>
        <field name="model">training.course</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name" string="Tên khoá đào tạo"/>
                    <field name="type" string="Loại hình"/>
                    <field name="training_field_id" string="Nhóm đào tạo"/>
                    <field name="training_level" string="Mức độ"/>
                </group>
            </form>
        </field>
    </record>

    <record id="action_training_course" model="ir.actions.act_window">
        <field name="name">Khóa đào tạo</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">training.course</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_id': ref('training_course_tree'), 'view_mode': 'tree'}),
            (0, 0, {'view_id': ref('training_course_form'), 'view_mode': 'form'})
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
              Tạo khoá đào tạo đầu tiên của bạn
            </p>
        </field>
    </record>

</odoo>