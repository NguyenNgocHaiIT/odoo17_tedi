<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- TREE: Nhu cầu đào tạo (header ngoài list) -->
        <record id="view_trainings_needs_tree" model="ir.ui.view">
            <field name="name">trainings.needs.tree</field>
            <field name="model">trainings.needs</field>
            <field name="arch" type="xml">
                <tree string="Nhu cầu đào tạo">
                    <field name="name" string="Đợt khảo sát" class="text-center"/>
                    <field name="create_date" string="Ngày đăng ký" class="text-center"/>
                    <field name="user_id" string="Người đăng ký" class="text-center"/>
                    <field name="approver_id" string="Người phê duyệt" class="text-center"/>
                    <field name="state" string="Trạng thái"
                           widget="badge"
                           decoration-warning="state == 'pending'"
                           decoration-success="state == 'approved'"
                           class="text-center"/>
                </tree>
            </field>
        </record>


        <!-- TREE: dòng chi tiết nhu cầu đào tạo -->
       <record id="view_trainings_needs_form" model="ir.ui.view">
        <field name="name">trainings.needs.form</field>
        <field name="model">trainings.needs</field>
        <field name="arch" type="xml">
            <form string="Nhu cầu đào tạo">
                <header>
                    <!-- ĐĂNG KÝ (draft -> pending) -->
                    <button name="action_submit"
                            string="Đăng ký"
                            type="object"
                            class="btn-primary"
                            groups="hr_training_tedi.group_training_participant"
                            invisible="state != 'draft'"/>

                    <!-- DUYỆT (pending -> approved) -->
                    <button name="action_approve"
                            string="Duyệt"
                            type="object"
                            class="btn-success"
                            groups="hr_training_tedi.group_training_unit_manager"
                            invisible="state != 'pending'"/>

                    <!-- TỪ CHỐI (pending -> draft) -->
                    <button name="action_reject"
                            string="Từ chối"
                            type="object"
                            class="btn-danger"
                            groups="hr_training_tedi.group_training_unit_manager"
                            invisible="state != 'pending'"/>


                    <!-- Thanh trạng thái -->
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,pending,approved"/>
                </header>

                <sheet>
                    <group>
                        <group>
                            <field name="name" string="Đợt khảo sát"/>
                            <!-- Người đăng ký: readonly, luôn hiển thị -->
                            <field name="user_id" string="Người đăng ký" readonly="1"/>
                        </group>
                        <group>
                            <field name="create_date" string="Ngày đăng ký" readonly="1"/>
                            <!-- Người phê duyệt: readonly, ẩn khi state = draft -->
                            <field name="approver_id"
                                   string="Người phê duyệt"
                                   readonly="1"
                                   modifiers="{'invisible': [['state','=','draft']]}"/>
                        </group>
                    </group>


                    <notebook>
                        <page string="Nhu cầu đào tạo">
                            <field name="line_ids"
                                   options="{'no_open': True}"
                                   readonly="state == 'approved'">

                                <tree string="Nhu cầu đào tạo"
                                      editable="bottom"
                                      readonly="parent.state == 'approved'">

                                    <field name="course_id" class="text-center"/>
                                    <field name="training_field_id" class="text-center"/>
                                    <field name="note" class="text-center"/>

                                </tree>
                            </field>

                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


        <!-- ACTION -->
        <record id="action_trainings_needs" model="ir.actions.act_window">
            <field name="name">Nhu cầu đào tạo</field>
            <field name="res_model">trainings.needs</field>
            <field name="view_mode">tree,form</field>
            <field name="view_ids" eval="[
                (5, 0, 0),
                (0, 0, {'view_id': ref('view_trainings_needs_tree'), 'view_mode': 'tree'}),
                (0, 0, {'view_id': ref('view_trainings_needs_form'), 'view_mode': 'form'}),
            ]"/>
        </record>


    </data>
</odoo>
