<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <record id="view_training_plan_tree" model="ir.ui.view">
        <field name="name">training.plan.tree</field>
        <field name="model">training.plan</field>
        <field name="arch" type="xml">
            <tree string="Kế hoạch đào tạo">
                <field name="name" class="text-start"/>
                <field name="survey_id" class="text-start"/>
                <field name="open_date" string="Ngày tạo" readonly="1" class="text-start"/>
                <field name="student_count" class="text-center"/>
                <field name="total_fee" class="text-center"/>
                <field name="state"
                       widget="badge"
                       decoration-warning="state == 'pending'"
                       decoration-success="state == 'approved'"
                       class="text-start"/>
            </tree>
        </field>
    </record>

    <record id="view_training_plan_form" model="ir.ui.view">
      <field name="name">training.plan.form</field>
      <field name="model">training.plan</field>
      <field name="arch" type="xml">
        <form string="Kế hoạch đào tạo">

            <field name="state" invisible="1"/>

            <header>
                <field name="state"
                       widget="statusbar"
                       statusbar_visible="draft,pending,approved"/>

                <button name="action_submit"
                        type="object"
                        string="Trình duyệt"
                        class="btn-primary"
                        groups="hr_training_tedi.group_training_manager"
                        invisible="state != 'draft'"/>

                <button name="action_approve"
                        type="object"
                        string="Duyệt"
                        class="btn-success"
                        groups="hr_training_tedi.group_training_general_director"
                        invisible="state != 'pending'"/>

                <button name="action_reject"
                        type="object"
                        string="Từ chối"
                        class="btn-danger"
                        groups="hr_training_tedi.group_training_general_director"
                        invisible="state != 'pending'"/>
            </header>

            <sheet>
              <group>
                  <group>
                      <field name="name" readonly="state == 'approved'" class="text-start"/>
                      <field name="survey_id"
                             domain="[('state','in',('in_process','end'))]" readonly="state == 'approved'" class="text-start"/>
                  </group>

                  <group>
                      <field name="open_date" string="Ngày tạo" readonly="1" class="text-start"/>
                  </group>
              </group>

              <group>
                  <group>
                      <field name="student_count" readonly="1" class="text-start"/>
                      <field name="total_fee" readonly="1" class="text-start"/>
                  </group>
              </group>

              <notebook>
                <page string="Chi tiết kế hoạch">
                 <field name="detail_ids" readonly="state == 'approved'">
                    <tree editable="bottom" string="Chi tiết kế hoạch">
                        <field name="plan_state" column_invisible="True"/>
                        <button name="open_participants"
                                type="object"
                                string="Học viên"
                                class="btn-link"
                                invisible="plan_state != 'approved'"
                                icon="fa-users"/>

                        <field name="course_id" class="text-start"/>
                        <field name="training_center" class="text-start"/>
                        <field name="training_type" class="text-start"/>
                        <field name="time_of_execution" class="text-start"/>
                        <field name="start_date" class="text-start"/>
                        <field name="end_date" class="text-start"/>
                        <field name="training_location" class="text-start"/>
                        <field name="training_fee_per_person" class="text-center"/>
                        <field name="training_total_fee" readonly="1" class="text-center"/>
                        <field name="training_fee_source" class="text-start"/>
                        <field name="note" class="text-start"/>
                    </tree>


                    <form string="Chi tiết kế hoạch">
                      <group>
                        <field name="course_id" class="text-start"/>
                        <field name="training_center" class="text-start"/>
                        <field name="training_type" class="text-start"/>
                        <field name="time_of_execution" class="text-start"/>
                        <field name="start_date" class="text-start"/>
                        <field name="end_date" class="text-start"/>
                        <field name="training_location" class="text-start"/>
                      </group>
                      <group>
                        <field name="training_fee_per_person" class="text-start"/>
                        <field name="training_total_fee" readonly="1" class="text-start"/>
                        <field name="training_fee_source" class="text-start"/>
                        <field name="note" class="text-start"/>
                      </group>
                    </form>

                  </field>
                </page>

              </notebook>
            </sheet>
        </form>
      </field>
    </record>

    <record id="action_training_plan" model="ir.actions.act_window">
      <field name="name">Kế hoạch đào tạo</field>
      <field name="res_model">training.plan</field>
      <field name="view_mode">tree,form</field>
      <field name="view_ids" eval="[
                (5, 0, 0),
                (0, 0, {'view_id': ref('view_training_plan_tree'), 'view_mode': 'tree'}),
                (0, 0, {'view_id': ref('view_training_plan_form'), 'view_mode': 'form'})
            ]"/>
    </record>

  </data>
</odoo>