<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_documents_management" model="ir.module.category">
        <field name="name">Documents Management</field>
        <field name="sequence">30</field>
    </record>
    <record id="group_documents_user" model="res.groups">
        <field name="name">Documents User</field>
        <field name="category_id" ref="module_documents_management"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="comment">The user will be able to approve document created by user.</field>
    </record>

    <record id="group_documents_manager" model="res.groups">
        <field name="name">Documents Manager</field>
        <field name="comment">The user will have access to all documents and configuration.</field>
        <field name="category_id" ref="module_documents_management"/>
        <field name="implied_ids" eval="[(4, ref('group_documents_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <data noupdate="1">
        <record id="rule_document_directory_own" model="ir.rule">
            <field name="name">Own Directory</field>
            <field name="model_id" ref="model_document_directory"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('windx_documents_management_preview.group_documents_manager'))]"/>
            <field name="perm_unlink" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_create" eval="1"/>
        </record>
        <record id="rule_document_directory_manager" model="ir.rule">
            <field name="name">Directory Manager</field>
            <field name="model_id" ref="model_document_directory"/>
            <field name="domain_force">[('user_ids', 'in', user.id)]</field>
            <field name="groups" eval="[(4, ref('windx_documents_management_preview.group_documents_manager'))]"/>
            <field name="perm_unlink" eval="0"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_create" eval="1"/>
        </record>

        <record id="rule_document_directory_attachment_own" model="ir.rule">
            <field name="name">Own Attachments</field>
            <field name="model_id" ref="base.model_ir_attachment"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('windx_documents_management_preview.group_documents_user'))]"/>
            <field name="perm_unlink" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_create" eval="1"/>
        </record>
        <record id="rule_document_directory_attachment_manager" model="ir.rule">
            <field name="name">Directory Attachments</field>
            <field name="model_id" ref="base.model_ir_attachment"/>
            <field name="domain_force">[('document_directory_id.user_ids', 'in', user.id)]</field>
            <field name="groups" eval="[(4, ref('windx_documents_management_preview.group_documents_user'))]"/>
            <field name="perm_unlink" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_create" eval="1"/>
        </record>

        <record id="rule_document_directory_admin" model="ir.rule">
            <field name="name">Directory Admin</field>
            <field name="model_id" ref="model_document_directory"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="perm_unlink" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_create" eval="1"/>
        </record>
        <record id="rule_document_directory_attachment_admin" model="ir.rule">
            <field name="name">Attachments Admin</field>
            <field name="model_id" ref="base.model_ir_attachment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="perm_unlink" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_create" eval="1"/>
        </record>
    </data>
</odoo>
