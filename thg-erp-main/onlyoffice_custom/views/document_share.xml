<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View -->
        <record id="document_share_view_form" model="ir.ui.view">
            <field name="name">document.share.view.form</field>  <!-- Sửa tên -->
            <field name="model">document.share</field>
            <field name="arch" type="xml">
                <form string="Document Share">
                    <sheet>
                    <group>
                        <field name="link_share" widget="CopyClipboardChar" options="{'string': 'Copy Link'}"/>
                    </group>
                    <group>
                        <field name="role_access_ids" widget="many2many_tags"/>
                        Public Access <field name="public_access"/>
                    </group>
                    
                        <group>
                            <field name="user_ids" widget="many2many_tags"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="document_share_view_tree" model="ir.ui.view">
            <field name="name">document.share.view.tree</field>
            <field name="model">document.share</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="user_ids"/>
                </tree>
            </field>
        </record>

        <!-- Action -->
        <record id="action_document_share" model="ir.actions.act_window">
            <field name="name">Document Shares</field> 
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">document.share</field>
            <field name="view_mode">tree,form</field>  
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first document share
                </p>
            </field>
        </record>

    </data>
</odoo>