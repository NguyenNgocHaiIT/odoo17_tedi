<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="windx_ir_attachment_kanban" model="ir.ui.view">
        <field name="name">Windx ir attachment kanban</field>
        <field name="model">ir.attachment</field>
        <field name="inherit_id" ref="mail.view_document_file_kanban"/>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <xpath expr="//t[@t-name='kanban-menu']/a[@t-if='widget.deletable']" position="after">
                <button name="create_onlyoffice_document" role="menuitem" type="object"
                        class="dropdown-item onlyoffice-create-action">Open with OnlyOffice
                </button>
                <button name="share_onlyoffice_document" role="menuitem" type="object"
                        class="dropdown-item onlyoffice-create-action">Share with OnlyOffice
                </button>
            </xpath>
        </field>
    </record>
</odoo>
