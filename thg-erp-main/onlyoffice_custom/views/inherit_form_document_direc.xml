<?xml version="1.0" encoding="utf-8"?>
<odoo>
     <record id="wind_form_inherit_directory" model="ir.ui.view">
        <field name="name">directory.view.form.inherit</field>
        <field name="model">document.directory</field>
        <field name="inherit_id" ref="windx_documents_management_preview.view_document_directory_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='note']" position="after">
                <field name="role_access_ids"  widget="many2many_tags"/>
                <field name="public_access"/>
            </xpath>
        </field>
    </record>
</odoo>
